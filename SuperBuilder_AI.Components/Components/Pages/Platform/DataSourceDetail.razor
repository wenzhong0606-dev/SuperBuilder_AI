@page "/data-sources/{Id:long}"
@inject IApiClient Api
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared
@implements IDisposable

<AuthGuard>
    <PageHead Icon="sb-ico-db" Title="@string.Format(L10n.T(Keys.Content.DataSourceDetailTitle, "数据源 #{0}"), Id)" Desc="@L10n.T(Keys.Content.DataSourceDetailDesc, "数据源的授权清单与行级安全策略（RLS）。")">
        <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("data-sources")'>@L10n.T(Keys.Content.DataSourceBackList, "返回列表")</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Load()">@L10n.T(Keys.Action.Refresh, "刷新")</button>
    </PageHead>

    <SbTabs>
        <SbTab Title="@L10n.T(Keys.Content.DataSourceTabMeta, "元数据")" Badge="@_metadata.Count.ToString()">
            <SbToolbar>
                <Right>
                    <button class="btn btn-primary btn-sm" @onclick="ScanMetadata" disabled="@_scanPolling">@ScanButtonLabel</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadMetadata">@L10n.T(Keys.Action.Refresh, "刷新")</button>
                </Right>
            </SbToolbar>
            @if (_scanJob is not null)
            {
                var scan = _scanJob.ProgressDetails ?? new ScanProgressDetailsView();
                var tablesTotal = scan.TablesDiscovered > 0 ? scan.TablesDiscovered : _scanJob.TablesScanned;
                var tablesDone = scan.TablesProcessed > 0 ? scan.TablesProcessed : _scanJob.TablesScanned;
                var columnsTotal = scan.ColumnsDiscovered > 0 ? scan.ColumnsDiscovered : _scanJob.ColumnsScanned;
                var columnsDone = scan.ColumnsProcessed > 0 ? scan.ColumnsProcessed : _scanJob.ColumnsScanned;

                <div class="scan-job scan-monitor @ScanStatusClass(_scanJob.Status)">
                    <div class="scan-job-head">
                        <div class="scan-monitor-title">
                            <span class="badge @ScanStatusBadge(_scanJob.Status)">@ScanStatusLabel(_scanJob.Status)</span>
                            <strong>@string.Format(L10n.T(Keys.Content.DataSourceScanStage, "当前阶段：{0}"), StageDisplay(_scanJob.Stage))</strong>
                        </div>
                        <div class="scan-monitor-time">
                            <span>@string.Format(L10n.T(Keys.Content.DataSourceScanElapsed, "已耗时 {0}"), FormatDuration(scan.ElapsedMs))</span>
                            @if (_scanJob.Status == "Running" && scan.EstimatedRemainingMs is > 0)
                            {
                                <span>@string.Format(L10n.T(Keys.Content.DataSourceScanEta, "预计剩余 {0}"), FormatDuration(scan.EstimatedRemainingMs.Value))</span>
                            }
                            <span>@_scanJob.ProgressPercent%</span>
                        </div>
                        @if (_scanJob.Status == "Failed")
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RetryScan">@L10n.T(Keys.Content.DataSourceScanRetry, "重试")</button>
                        }
                    </div>

                    <div class="progress scan-monitor-progress"><span style="@($"width:{_scanJob.ProgressPercent}%")"></span></div>

                    <div class="scan-monitor-metrics">
                        <div class="scan-monitor-metric">
                            <strong>@string.Format(L10n.T(Keys.Content.DataSourceScanTablesProgress, "表 {0}/{1}"), tablesDone, tablesTotal)</strong>
                        </div>
                        <div class="scan-monitor-metric">
                            <strong>@string.Format(L10n.T(Keys.Content.DataSourceScanColumnsProgress, "字段 {0}/{1}"), columnsDone, columnsTotal)</strong>
                        </div>
                        <div class="scan-monitor-metric">
                            <strong>@string.Format(L10n.T(Keys.Content.DataSourceScanSemanticsProgress, "语义 {0}/{1}"), scan.SemanticsProcessed, scan.SemanticsTotal)</strong>
                        </div>
                        <div class="scan-monitor-metric">
                            <strong>@string.Format(L10n.T(Keys.Content.DataSourceScanVectorsProgress, "向量 {0}/{1}"), scan.VectorsProcessed, scan.VectorsTotal)</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(scan.CurrentObjectName))
                    {
                        <div class="scan-monitor-current">
                            <span class="status-pulse"></span>
                            @string.Format(L10n.T(Keys.Content.DataSourceScanCurrentObject, "当前处理：{0}"), scan.CurrentObjectName)
                        </div>
                    }

                    <div class="scan-monitor-detail-grid">
                        <section class="scan-monitor-detail">
                            <div class="scan-monitor-section-title">@L10n.T(Keys.Content.DataSourceScanChanges, "本次变化")</div>
                            <div class="scan-job-stats">
                                <span>@string.Format(L10n.T(Keys.Content.DataSourceScanChangeTables, "表 +{0} / 更新 {1}"), scan.AddedTables, scan.UpdatedTables)</span>
                                <span>@string.Format(L10n.T(Keys.Content.DataSourceScanChangeColumns, "字段 +{0} / 更新 {1}"), scan.AddedColumns, scan.UpdatedColumns)</span>
                                @if (scan.OrphansRemoved > 0)
                                {
                                    <span>@string.Format(L10n.T(Keys.Content.DataSourceScanOrphansRemoved, "已清理孤儿对象：{0}"), scan.OrphansRemoved)</span>
                                }
                                @if (scan.WarningsCount > 0)
                                {
                                    <span>@string.Format(L10n.T(Keys.Content.DataSourceScanWarnings, "警告 {0}"), scan.WarningsCount)</span>
                                }
                            </div>
                        </section>

                        <section class="scan-monitor-detail">
                            <div class="scan-monitor-section-title">@L10n.T(Keys.Content.DataSourceScanEvents, "实时动态")</div>
                            <div class="scan-event-list">
                                @if (scan.Events.Count == 0)
                                {
                                    <span class="muted tiny">@ScanStatusLabel(_scanJob.Status)</span>
                                }
                                else
                                {
                                    @foreach (var evt in scan.Events.OrderByDescending(x => x.TimestampUtc).Take(8))
                                    {
                                        <div class="scan-event @(evt.Level == "Warning" ? "is-warning" : "")">
                                            <time>@evt.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                                            <span>@evt.Message</span>
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    </div>

                    @if (_scanJob.Status == "Failed" && !string.IsNullOrWhiteSpace(_scanJob.ErrorCode))
                    {
                        <div class="scan-job-error">
                            <strong>@_scanJob.ErrorCode</strong>@(string.IsNullOrWhiteSpace(_scanJob.ErrorMessage) ? "" : $"：{_scanJob.ErrorMessage}")
                        </div>
                    }
                </div>
            }
            @if (_loadingMetadata) { <LoadingState Text="@L10n.T(Keys.Content.DataSourceLoadingMeta, "正在加载元数据…")" /> }
            else if (_metadataError is not null) { <ErrorState Message="@_metadataError" OnRetry="LoadMetadata" /> }
            else if (_metadata.Count == 0)
            {
                <SbEmptyState Icon="sb-ico-db" Title="@L10n.T(Keys.Content.DataSourceEmptyMetaTitle, "尚未扫描到元数据")" Text="@L10n.T(Keys.Content.DataSourceEmptyMetaText, "点击重新扫描，从业务数据库读取表和字段结构。")" />
            }
            else
            {
                @foreach (var table in _metadata)
                {
                    <section class="meta-table-card" id="@($"table-{Text(table, "id")}")">
                        <header class="meta-table-head">
                            <div class="meta-table-title"><svg><use href="#sb-ico-db" /></svg><div><strong>@Text(table, "tableName")</strong><div class="muted tiny">MetadataTable #@Text(table, "id") · @Text(table, "tableComment")</div></div></div>
                            <span class="badge badge-primary">@(string.Format(L10n.T(Keys.Content.DataSourceFieldsBadge, "{0} 字段"), ColumnsOf(table).Count))</span>
                        </header>
                        <div class="table-wrap">
                            <table class="data-table meta-table">
                                <thead><tr><th>@L10n.T(Keys.Content.DataSourceColFieldRel, "字段 / 关系")</th><th>@L10n.T(Keys.Content.DataSourceColType, "类型")</th><th>@L10n.T(Keys.Content.DataSourceColNullable, "可空")</th><th>@L10n.T(Keys.Content.DataSourceColSemantic, "Semantic")</th><th>@L10n.T(Keys.Content.DataSourceColVector, "Vector")</th><th>@L10n.T(Keys.Content.DataSourceColBusinessKey, "业务键")</th></tr></thead>
                                <tbody>
                                @foreach (var column in ColumnsOf(table))
                                {
                                    var semantic = SemanticOf(column);
                                    <tr id="@($"column-{Text(column, "id")}")">
                                        <td><div class="meta-column-name"><span>@Text(column, "columnName")</span>@if (Flag(column, "isPrimaryKey")) { <span class="meta-pk">PK</span> }</div><small class="muted">MetadataColumn #@Text(column, "id") → Table #@Text(table, "id")</small></td>
                                        <td><span class="meta-type">@Text(column, "dataType")@(string.IsNullOrWhiteSpace(Text(column, "length")) ? "" : $"({Text(column, "length")})")</span></td>
                                        <td><span class="meta-switch @(Flag(column, "isNullable") ? "is-on" : "")" title="@(Flag(column, "isNullable") ? "true" : "false")"></span></td>
                                        <td>
                                            @if (semantic is not null)
                                            {
                                                <a class="meta-key-link" href="@($"/platform/metadata/semantic/{Text(semantic, "id")}")">Semantic #@Text(semantic, "id") →</a>
                                                <div id="@($"semantic-{Text(semantic, "id")}")" class="muted tiny">@Text(semantic, "businessMeaning")</div>
                                            }
                                            else { <span class="muted">—</span> }
                                        </td>
                                        <td>
                                            @if (semantic is not null && !string.IsNullOrWhiteSpace(Text(semantic, "vectorId")))
                                            { <a class="meta-key-link" href="@($"/platform/metadata/vector/{Uri.EscapeDataString(Text(semantic, "vectorId"))}")">Qdrant · @Short(Text(semantic, "vectorId")) →</a><div class="muted tiny">@Text(semantic, "embeddingModel") · @Text(semantic, "vectorDimension")D</div> }
                                            else if (!string.IsNullOrWhiteSpace(Text(column, "vectorId")))
                                            { <a class="meta-key-link" href="@($"/platform/metadata/vector/{Uri.EscapeDataString(Text(column, "vectorId"))}")">Column Vector · @Short(Text(column, "vectorId")) →</a> }
                                            else { <span class="muted">@L10n.T(Keys.Content.DataSourceNotVectorized, "未向量化")</span> }
                                        </td>
                                        <td>@if (!string.IsNullOrWhiteSpace(Text(column, "businessKey"))) { <a class="meta-key-link" href="@($"/platform/metadata/column/{Text(column, "id")}")">@Text(column, "businessKey") →</a> } else { <span class="muted">—</span> }</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </SbTab>

        <SbTab Title="@L10n.T(Keys.Content.DataSourceTabGrants, "访问授权")" Badge="@_grants.Count.ToString()">
            <SbToolbar>
                <Left>
                    <select class="form-select" @bind="_grantType"><option value="1">@L10n.T(Keys.Content.DataSourceGrantUser, "用户")</option><option value="2">@L10n.T(Keys.Content.DataSourceGrantRole, "角色")</option></select>
                    <select class="form-select" @bind="_grantSubjectId"><option value="0">@L10n.T(Keys.Content.DataSourceGrantSubjectPlaceholder, "选择授权主体…")</option>@foreach(var subject in GrantSubjects){<option value="@Text(subject,"id")">@GrantSubjectName(subject)</option>}</select>
                    <button class="btn btn-primary btn-sm" @onclick="GrantAccess">@L10n.T(Keys.Content.DataSourceGrantAccess, "授予访问")</button>
                </Left>
                <Right>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => Load()">@L10n.T(Keys.Content.DataSourceRefreshGrants, "刷新授权")</button>
                </Right>
            </SbToolbar>
            @if (_loadingGrants)
            {
                <LoadingState Text="@L10n.T(Keys.Content.DataSourceLoadingGrants, "正在加载授权…")" />
            }
            else if (_grantsError is not null)
            {
                <ErrorState Message="@_grantsError" OnRetry="LoadGrants" />
            }
            else
            {
                <SbPanel Icon="sb-ico-key" Title="@L10n.T(Keys.Content.DataSourcePanelGrants, "授权清单")" Flush="true">
                    <Body>
                        @if (_grants.Count == 0) { <SbEmptyState Icon="sb-ico-key" Title="@L10n.T(Keys.Content.DataSourceEmptyGrantsTitle, "暂无显式授权")" Text="@L10n.T(Keys.Content.DataSourceEmptyGrantsText, "选择用户或角色并授予该数据源访问权限。")" /> }
                        else { <div class="table-wrap"><table class="data-table"><thead><tr><th>@L10n.T(Keys.Content.DataSourceColSubjectType, "主体类型")</th><th>@L10n.T(Keys.Content.DataSourceColSubject, "主体")</th><th>@L10n.T(Keys.Content.DataSourceColCreated, "授权时间")</th><th></th></tr></thead><tbody>@foreach(var grant in _grants){<tr><td>@Text(grant,"subjectType")</td><td>@GrantName(grant)</td><td>@Text(grant,"createdTime")</td><td class="ta-right"><button class="btn btn-sm btn-outline-secondary" @onclick="() => RevokeAccess(grant)">@L10n.T(Keys.Content.DataSourceRevoke, "撤销")</button></td></tr>}</tbody></table></div> }
                    </Body>
                </SbPanel>
            }
        </SbTab>

        <SbTab Title="@L10n.T(Keys.Content.DataSourceTabRls, "行级安全")" Badge="@_policies.Count.ToString()">
            @if (_loadingPolicies)
            {
                <LoadingState Text="@L10n.T(Keys.Content.DataSourceLoadingPolicies, "正在加载策略…")" />
            }
            else if (_policiesError is not null)
            {
                <ErrorState Message="@_policiesError" OnRetry="LoadPolicies" />
            }
            else if (_policies.Count == 0)
            {
                <SbPanel Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.DataSourcePanelRls, "行级安全策略")">
                    <Body>
                        <SbEmptyState Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.DataSourceEmptyRlsTitle, "未配置行级安全策略")"
                                      Text="@L10n.T(Keys.Content.DataSourceEmptyRlsText, "配置后可按用户/角色限制可见数据行，控制越权取数风险。")" />
                    </Body>
                </SbPanel>
            }
            else
            {
                <SbPanel Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.DataSourcePanelPolicies, "策略清单")" Flush="true">
                    <Body>
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var c in _policyCols) { <th>@TablePresenter.Friendly(c)</th> }
                                        <th class="ta-right">@L10n.T(Keys.Content.DataSourceColActions, "操作")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _policies)
                                    {
                                        <tr>
                                            @foreach (var c in _policyCols)
                                            {
                                                <td>@JsonValue.AsString(row.GetValueOrDefault(c))</td>
                                            }
                                            <td class="ta-right">
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => RemovePolicy(row)">@L10n.T(Keys.Action.Delete, "删除")</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </Body>
                </SbPanel>
            }
        </SbTab>
    </SbTabs>
</AuthGuard>

@code {
    [Parameter] public long Id { get; set; }

    private List<Dictionary<string, object?>> _grants = new();
    private List<Dictionary<string, object?>> _grantUsers = new();
    private List<Dictionary<string, object?>> _grantRoles = new();
    private int _grantType = 1; private long _grantSubjectId;
    private IEnumerable<Dictionary<string, object?>> GrantSubjects => _grantType == 1 ? _grantUsers : _grantRoles;
    private List<Dictionary<string, object?>> _policies = new();
    private List<string> _policyCols = new();
    private string? _grantsError;
    private string? _policiesError;
    private bool _loadingGrants = true;
    private bool _loadingPolicies = true;
    private List<Dictionary<string, object?>> _metadata = new();
    private string? _metadataError;
    private bool _loadingMetadata = true;
    private bool _scanPolling;
    private ScanJobView? _scanJob;
    private CancellationTokenSource? _scanCts;
    private string ScanButtonLabel => _scanPolling
        ? L10n.T(Keys.Content.DataSourceScanning, "扫描中…")
        : L10n.T(Keys.Content.DataSourceRescan, "重新扫描");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
    }

    private async Task Load()
    {
        await LoadMetadata();
        await LoadGrants();
        await LoadPolicies();
        StateHasChanged();
    }

    private async Task LoadMetadata()
    {
        _loadingMetadata = true;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/data-sources/{Id}/metadata");
        _metadataError = data is null ? (err ?? string.Format(L10n.T(Keys.Content.DataSourceLoadMetaFailed, "加载元数据失败（{0}）。"), status)) : null;
        _metadata = JsonRows.Extract(data);
        _loadingMetadata = false;
        StateHasChanged();
    }

    private async Task ScanMetadata()
    {
        if (_scanPolling) return;
        var (ok, _, jobId, err, _) = await Api.StartScanAsync(Id);
        if (!ok || jobId is null)
        {
            Toast.Error(err ?? L10n.T(Keys.Content.DataSourceScanFailed, "元数据扫描失败。"));
            return;
        }
        await PollScanAsync(jobId.Value);
    }

    private async Task RetryScan()
    {
        if (_scanJob is not null) await ScanMetadata();
    }

    private async Task PollScanAsync(long jobId)
    {
        _scanCts?.Cancel();
        _scanCts = new CancellationTokenSource();
        var ct = _scanCts.Token;
        _scanPolling = true;
        _scanJob = new ScanJobView { JobId = jobId, DataSourceId = Id, Status = "Queued", Stage = "Queued", ProgressPercent = 0 };
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var (job, _, perr, _) = await Api.GetScanJobAsync(Id, jobId, ct);
                if (job is null)
                {
                    _scanJob = null;
                    Toast.Error(L10n.T(Keys.Content.DataSourceScanJobLost, "扫描任务不存在或已被清理。"));
                    break;
                }
                _scanJob = job;
                StateHasChanged();
                if (job.Status == "Succeeded" || job.Status == "Failed") break;
                await Task.Delay(1500, ct);
            }
        }
        catch (OperationCanceledException)
        {
            // 组件已卸载或导航离开，停止轮询。
        }
        finally
        {
            _scanPolling = false;
            StateHasChanged();
        }

        if (_scanJob?.Status == "Succeeded")
        {
            Toast.Success(L10n.T(Keys.Content.DataSourceScanDone, "元数据扫描完成。"));
            await LoadMetadata();
        }
        else if (_scanJob?.Status == "Failed")
        {
            Toast.Error(L10n.T(Keys.Content.DataSourceScanFailed, "元数据扫描失败。"));
        }
    }

    public void Dispose() => _scanCts?.Cancel();

    private string StageDisplay(string? stage) => stage switch
    {
        "Connecting" => L10n.T(Keys.Content.DataSourceScanStageConnecting, "连接数据库"),
        "DiscoveringTables" or "DiscoveringColumns" => L10n.T(Keys.Content.DataSourceScanStageDiscovering, "发现数据库结构"),
        "ComparingMetadata" => L10n.T(Keys.Content.DataSourceScanStageComparing, "比对元数据"),
        "CleaningOrphans" => L10n.T(Keys.Content.DataSourceScanStageCleaning, "检查失效元数据"),
        "SyncingMetadata" => L10n.T(Keys.Content.DataSourceScanStageSyncing, "同步元数据"),
        "GeneratingSemantics" => L10n.T(Keys.Content.DataSourceScanStageSemantics, "AI 语义生成"),
        "IndexingVectors" => L10n.T(Keys.Content.DataSourceScanStageVectors, "向量索引"),
        "Finalizing" => L10n.T(Keys.Content.DataSourceScanStageFinalizing, "最终一致性检查"),
        "Succeeded" => L10n.T(Keys.Content.DataSourceScanSucceededBanner, "扫描完成"),
        "Failed" => L10n.T(Keys.Content.DataSourceScanFailedBanner, "扫描失败"),
        "Queued" => L10n.T(Keys.Content.DataSourceScanQueued, "已排队，等待后台扫描…"),
        _ => L10n.T(Keys.Content.DataSourceScanRunning, "正在扫描元数据…")
    };

    private static string FormatDuration(long milliseconds)
    {
        if (milliseconds <= 0) return "00:00";
        var span = TimeSpan.FromMilliseconds(milliseconds);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours:00}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{span.Minutes:00}:{span.Seconds:00}";
    }

    private static string ScanStatusClass(string status) => status switch
    {
        "Succeeded" => "is-ok",
        "Failed" => "is-fail",
        _ => "is-running"
    };

    private static string ScanStatusBadge(string status) => status switch
    {
        "Succeeded" => "badge-success",
        "Failed" => "badge-danger",
        _ => "badge-primary"
    };

    private string ScanStatusLabel(string status) => status switch
    {
        "Queued" => L10n.T(Keys.Content.DataSourceScanQueued, "已排队，等待后台扫描…"),
        "Running" => L10n.T(Keys.Content.DataSourceScanRunning, "正在扫描元数据…"),
        "Succeeded" => L10n.T(Keys.Content.DataSourceScanSucceededBanner, "扫描完成"),
        "Failed" => L10n.T(Keys.Content.DataSourceScanFailedBanner, "扫描失败"),
        _ => status
    };

    private static string ScanTimeLabel(ScanJobView job)
    {
        var parts = new List<string>();
        if (job.StartedAt is not null) parts.Add("开始 " + FormatUtc(job.StartedAt.Value));
        if (job.FinishedAt is not null) parts.Add("结束 " + FormatUtc(job.FinishedAt.Value));
        return string.Join(" · ", parts);
    }

    private static string FormatUtc(DateTime utc) => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string Text(Dictionary<string, object?> row, string key) => JsonValue.AsString(row.GetValueOrDefault(key));
    private static bool Flag(Dictionary<string, object?> row, string key) => row.TryGetValue(key, out var value) && value is JsonElement el && el.ValueKind == JsonValueKind.True;
    private static Dictionary<string, object?>? SemanticOf(Dictionary<string, object?> row)
    {
        if (!row.TryGetValue("semantic", out var value) || value is not JsonElement el || el.ValueKind != JsonValueKind.Object) return null;
        return el.EnumerateObject().ToDictionary(p => p.Name, p => (object?)p.Value.Clone());
    }
    private static string Short(string value) => value.Length > 16 ? value[..13] + "…" : value;
    private static List<Dictionary<string, object?>> ColumnsOf(Dictionary<string, object?> row)
    {
        if (!row.TryGetValue("columns", out var value) || value is not JsonElement el || el.ValueKind != JsonValueKind.Array)
            return new();
        return JsonRows.Extract(el);
    }

    private async Task LoadGrants()
    {
        _loadingGrants = true;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/data-source-access?dataSourceId={Id}");
        _grantsError = data is null ? (err ?? string.Format(L10n.T(Keys.Content.DataSourceLoadGrantsFailed, "加载授权失败（{0}）。"), status)) : null;
        _grants = JsonRows.Extract(data);
        var (users, _, _, _) = await Api.GetJsonAsync("api/identity/users"); _grantUsers = JsonRows.Extract(users);
        var (roles, _, _, _) = await Api.GetJsonAsync("api/identity/roles"); _grantRoles = JsonRows.Extract(roles);
        _loadingGrants = false;
    }

    private string GrantSubjectName(Dictionary<string, object?> row) => _grantType == 1 ? $"{Text(row,"displayName")}（{Text(row,"username")}）" : $"{Text(row,"name")}（{Text(row,"code")}）";
    private string GrantName(Dictionary<string, object?> grant)
    {
        var id=Text(grant,"subjectId"); var isUser=Text(grant,"subjectType").Contains("User",StringComparison.OrdinalIgnoreCase)||Text(grant,"subjectType")=="1";
        var row=(isUser?_grantUsers:_grantRoles).FirstOrDefault(x=>Text(x,"id")==id); return row is null ? $"#{id}" : (isUser ? GrantUserName(row) : $"{Text(row,"name")}（{Text(row,"code")}）");
    }
    private static string GrantUserName(Dictionary<string, object?> row) => $"{Text(row,"displayName")}（{Text(row,"username")}）";
    private async Task GrantAccess()
    {
        if(_grantSubjectId<=0){Toast.Warning(L10n.T(Keys.Content.DataSourceSelectSubject, "请选择用户或角色。"));return;}
        var (ok,_,err, _) = await Api.PostAsync("api/data-source-access",new{dataSourceId=Id,subjectType=_grantType,subjectId=_grantSubjectId}); if(!ok){Toast.Error(err??L10n.T(Keys.Content.DataSourceGrantFailed, "授权失败。"));return;} Toast.Success(L10n.T(Keys.Content.DataSourceGranted, "数据源访问权限已授予。")); _grantSubjectId=0; await LoadGrants();
    }
    private async Task RevokeAccess(Dictionary<string,object?> grant)
    {
        var type=Text(grant,"subjectType"); var id=Text(grant,"subjectId"); var (ok,_,err, _) = await Api.DeleteAsync($"api/data-source-access?dataSourceId={Id}&subjectType={Uri.EscapeDataString(type)}&subjectId={id}"); if(!ok)Toast.Error(err??L10n.T(Keys.Content.DataSourceRevokeFailed, "撤销失败。"));else{Toast.Success(L10n.T(Keys.Content.DataSourceRevoked, "授权已撤销。"));await LoadGrants();}
    }

    private async Task LoadPolicies()
    {
        _loadingPolicies = true;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/data-policies/row?dataSourceId={Id}");
        _policiesError = data is null ? (err ?? string.Format(L10n.T(Keys.Content.DataSourceLoadPolicyFailed, "加载策略失败（{0}）。"), status)) : null;
        _policies = JsonRows.Extract(data);
        _policyCols = Columns(_policies);
        _loadingPolicies = false;
    }

    private async Task RemovePolicy(Dictionary<string, object?> row)
    {
        var id = JsonValue.AsString(row.GetValueOrDefault("id"));
        if (string.IsNullOrWhiteSpace(id)) return;
        var (ok, status, err, _) = await Api.DeleteAsync($"api/data-policies/row/{id}");
        if (ok)
        {
            Toast.Success(L10n.T(Keys.Content.DataSourcePolicyDeleted, "策略已删除。"));
            await LoadPolicies();
        }
        else
        {
            Toast.Error(err ?? string.Format(L10n.T(Keys.Content.DataSourceDeleteFailed, "删除失败（{0}）。"), status));
        }
    }

    private static List<string> Columns(List<Dictionary<string, object?>> rows)
    {
        var cols = new List<string>();
        foreach (var r in rows)
            foreach (var k in r.Keys)
                if (!cols.Contains(k)) cols.Add(k);
        return cols;
    }
}
