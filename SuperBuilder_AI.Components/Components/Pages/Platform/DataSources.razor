@page "/data-sources"
@inject ToastService Toast
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-db" Title="数据源管理" Desc="接入多种数据库：选择连接器、填写连接信息、测试连通性并触发元数据扫描。" />

    <div class="card-grid">
        @foreach (var c in _connectors)
        {
            <div class="feature-card @(c.Ready ? "" : "is-disabled")" @onclick="() => Select(c.Name)">
                <div class="fc-ico"><svg><use href="#sb-ico-db" /></svg></div>
                <div class="fc-title">@c.Name</div>
                <div class="fc-desc">@c.Desc</div>
                <span class="badge @(c.Ready ? "badge-success" : "badge-muted")">@(c.Ready ? "可用" : "规划中")</span>
            </div>
        }
    </div>

    <SbPanel Icon="sb-ico-plus" Title="新建数据源">
        <Body>
            <SbField Label="数据源名称" Hint="如：WMS 生产库">
                <input @bind="Name" placeholder="如：WMS 生产库" />
            </SbField>
            <SbField Label="连接器类型">
                <select @bind="Type">
                    @foreach (var c in _connectors) { <option value="@c.Name">@c.Name</option> }
                </select>
            </SbField>
            <SbField Label="连接串" Full="true">
                <input @bind="ConnStr" placeholder="Server=host;Database=db;User=...;" />
            </SbField>
            <div class="field-grid">
                <SbField Label="用户名"><input @bind="User" /></SbField>
                <SbField Label="密码"><input type="password" @bind="Pass" placeholder="••••••" /></SbField>
            </div>
            <div class="toolbar" style="margin-top:16px;margin-bottom:0">
                <button class="btn btn-outline-secondary btn-sm" @onclick="TestConn">测试连接</button>
                <button class="btn btn-primary btn-sm" @onclick="Save">保存并扫描</button>
            </div>
        </Body>
    </SbPanel>
</AuthGuard>

@code {
    private record Connector(string Name, string Desc, bool Ready);
    private List<Connector> _connectors = new()
    {
        new("SQL Server", "企业主流关系型数据库", true),
        new("MySQL", "WMS 等业务常用", true),
        new("PostgreSQL", "开源关系型数据库", true),
        new("Oracle", "大型事务系统", false),
        new("ClickHouse", "列式分析型数据库", false),
        new("MongoDB", "文档型 NoSQL", false),
    };
    private string Name = "", Type = "MySQL", ConnStr = "", User = "", Pass = "";

    private void Select(string n) { Type = n; Toast.Info($"已选择连接器：{n}"); }
    private void TestConn() => Toast.Info("连通性测试已提交（Multi-DB Connector 后端计划于 P12 实现）。");
    private void Save() => Toast.Info("保存并触发扫描（后端 IDataSourceConnector 计划于 P12 实现）。");
}
