@page "/dashboards"
@inject IApiClient Api
@inject Services.AppState AppState
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<PageHead Icon="sb-ico-dash" Title="仪表盘" Desc="将 Ask 分析结果固化为可复用的可视化看板，支持团队共享与定时刷新。">
    <button class="btn btn-primary btn-sm" @onclick='() => Toast("新建仪表盘（编辑器蓝图已就绪，P11.3 接入）")'>
        <svg class="btn-ico"><use href="#sb-ico-dash" /></svg> 新建仪表盘
    </button>
</PageHead>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

@if (_loading)
{
    <div class="empty-state"><div class="es-title">加载中…</div></div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_rows.Count == 0)
{
    <div class="panel">
        <div class="panel-body">
            <div class="empty-state">
                <svg class="es-ico"><use href="#sb-ico-dash" /></svg>
                <div class="es-title">暂无仪表盘</div>
                <div class="es-text">将一次问数结果保存为仪表盘，即可在团队内复用这套分析视角与图表。</div>
                <div class="es-actions">
                    <button class="btn btn-primary btn-sm" @onclick='() => Toast("从 Ask 会话发布为仪表盘")'>从 Ask 发布</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Reload">刷新</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="stat-grid">
        <div class="stat-tile"><div class="st-label">仪表盘总数</div><div class="st-value">@_rows.Count</div><div class="st-sub">含全局模板</div></div>
        <div class="stat-tile accent-success"><div class="st-label">已发布</div><div class="st-value">@_rows.Count(r => IsPublished(r))</div><div class="st-sub">可对外共享</div></div>
        <div class="stat-tile accent-warning"><div class="st-label">草稿</div><div class="st-value">@_rows.Count(r => !IsPublished(r))</div><div class="st-sub">编辑中</div></div>
    </div>

    <div class="toolbar">
        <div class="search">
            <svg><use href="#sb-ico-search" /></svg>
            <input @bind="Q" @bind:event="oninput" placeholder="搜索名称 / 编码…" />
        </div>
        <div class="spacer"></div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Reload">刷新</button>
    </div>

    <div class="panel">
        <div class="panel-head"><div class="panel-title"><svg class="pt-ico"><use href="#sb-ico-dash" /></svg> 全部仪表盘</div></div>
        <div class="panel-body flush">
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr>@foreach (var c in _cols) { <th>@TablePresenter.Friendly(c)</th> }</tr></thead>
                    <tbody>
                    @foreach (var row in Filtered)
                    {
                        <tr>
                            @foreach (var c in _cols)
                            {
                                @if (TablePresenter.IsStatusColumn(c))
                                {
                                    <td><span class="badge @TablePresenter.StatusBadge(TablePresenter.Cell(row, c))">@TablePresenter.Cell(row, c)</span></td>
                                }
                                else
                                {
                                    <td>@TablePresenter.Cell(row, c)</td>
                                }
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private JsonElement? _data;
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;
    private string Q = "";
    private string _msg = "";

    private List<JsonElement> Filtered => string.IsNullOrWhiteSpace(Q)
        ? _rows
        : _rows.Where(r => _cols.Any(c => TablePresenter.Cell(r, c).Contains(Q, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err) = await Api.GetJsonAsync($"api/dashboards?tenantId={AppState.TenantId}");
        _error = err ?? "";
        _data = data;
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(_data);
        _loading = false;
        StateHasChanged();
    }

    private static bool IsPublished(JsonElement row)
    {
        var s = TablePresenter.Cell(row, "status");
        return s.Equals("published", StringComparison.OrdinalIgnoreCase) || s.Equals("ready", StringComparison.OrdinalIgnoreCase);
    }

    private void Toast(string m) => _msg = m; // 占位：真实 toast 待 P11.3 交互层
}
