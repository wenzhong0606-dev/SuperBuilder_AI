    // ---------------- M12 增量：重命名 / 启停 / 删除 ----------------

    private static bool IsEnabled(JsonElement row) =>
        !row.TryGetProperty("isEnabled", out var v) || v.ValueKind != JsonValueKind.False;

    private static string KindSegment(string kind) => kind switch
    {
        "dept" => "departments",
        "group" => "user-groups",
        _ => "organizations",
    };

    private static string KindLabel(string kind) => kind switch
    {
        "dept" => "部门",
        "group" => "用户组",
        _ => "组织",
    };

    private void OpenRename(string kind, JsonElement row)
    {
        _renameKind = kind;
        _renameId = long.TryParse(TablePresenter.Cell(row, "id"), out var id) ? id : 0;
        _renameCode = TablePresenter.Cell(row, "code");
        _renameName = TablePresenter.Cell(row, "name");
        _renameDesc = TablePresenter.Cell(row, "description");
        _renameErr = "";
        _renameModal = true;
    }

    private async Task SaveRename()
    {
        if (string.IsNullOrWhiteSpace(_renameName))
        {
            _renameErr = L10n.T(Keys.Content.IdentityDirectoryNameRequired, "名称必填。");
            return;
        }

        var body = _renameKind == "dept"
            ? (object)new { name = _renameName, description = _renameDesc }
            : new { name = _renameName, description = _renameDesc };

        var (_, status, err, _) = await Api.PutAsync(
            $"api/identity-directory/{KindSegment(_renameKind)}/{_renameId}?tenantId={State.TenantId}", body);

        if (status is >= 200 and < 300)
        {
            Toast.Success(L10n.T(Keys.Content.CommonSaveSuccess, "已保存。"));
            _renameModal = false;
            await Reload();
        }
        else
        {
            _renameErr = err ?? string.Format(L10n.T(Keys.Content.IdentityDirectoryCreateFailed, "创建失败（HTTP {0}）。"), status);
        }
    }

    private async Task ToggleEnabled(string kind, JsonElement row)
    {
        var id = long.TryParse(TablePresenter.Cell(row, "id"), out var v) ? v : 0;
        if (id <= 0) return;

        var enabled = !IsEnabled(row);
        var (_, status, err, _) = await Api.PutAsync(
            $"api/identity-directory/{KindSegment(kind)}/{id}/enabled?tenantId={State.TenantId}", new { enabled });

        if (status is >= 200 and < 300)
        {
            Toast.Success(enabled
                ? L10n.T(Keys.Content.IdentityDirectoryEnabled, "已启用。")
                : L10n.T(Keys.Content.IdentityDirectoryDisabled, "已停用。"));
            await Reload();
        }
        else
        {
            Toast.Error(err ?? string.Format(L10n.T(Keys.Content.IdentityDirectoryCreateFailed, "创建失败（HTTP {0}）。"), status));
        }
    }

    private async Task Remove(string kind, JsonElement row)
    {
        var id = long.TryParse(TablePresenter.Cell(row, "id"), out var v) ? v : 0;
        if (id <= 0) return;

        var name = TablePresenter.Cell(row, "name");
        var (_, status, err, _) = await Api.DeleteAsync(
            $"api/identity-directory/{KindSegment(kind)}/{id}?tenantId={State.TenantId}");

        if (status is >= 200 and < 300)
        {
            Toast.Success(string.Format(L10n.T(Keys.Content.IdentityDirectoryDeleted, "已删除「{0}」。"), name));
            await Reload();
        }
        else
        {
            Toast.Error(err ?? string.Format(L10n.T(Keys.Content.IdentityDirectoryDeleteFailed, "删除失败（HTTP {0}）。"), status));
        }
    }
