@page "/admin/quota"
@inject IApiClient Api
@inject AppState State
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PermissionGuard>
    <PageHead Icon="sb-ico-quota" Key="Quota" Title="配额管理" Desc="查看与配置租户资源配额：问数次数、Token、存储与并发等，超阈预警。" />

    @if (_loading)
    {
        <LoadingState Text="正在加载配额…" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Message="@_error" OnRetry="Reload" />
    }
    else if (_obj is null)
    {
        <SbPanel Icon="sb-ico-quota" Title="当前租户配额">
            <Body>
                <SbEmptyState Icon="sb-ico-quota" Title="暂无配额数据" Text="联系平台管理员为当前租户配置资源配额。" />
            </Body>
        </SbPanel>
    }
    else
    {
        <SbPanel Icon="sb-ico-quota" Title="当前租户配额">
            <Body>
                <dl class="kv">
                    @foreach (var p in _obj.Value.EnumerateObject())
                    {
                        <dt>@TablePresenter.Friendly(p.Name)</dt>
                        <dd>
                            @if (p.Value.ValueKind == JsonValueKind.Number)
                            {
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div class="progress" style="flex:1;max-width:220px"><span style="width:@Width(p.Name, p.Value.GetDouble())"></span></div>
                                    <span class="tiny muted">@p.Value.GetRawText()</span>
                                </div>
                            }
                            else { @TablePresenter.StringifySafe(p.Value) }
                        </dd>
                    }
                </dl>
            </Body>
        </SbPanel>
    }
    </PermissionGuard>
</AuthGuard>

@code {
    private JsonElement? _obj;
    private string _error = "";
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err, _) = await Api.GetJsonAsync($"api/quota?tenantId={State.TenantId}");
        _error = err ?? "";
        _obj = data is { ValueKind: JsonValueKind.Object } ? data : null;
        _loading = false;
        StateHasChanged();
    }

    private static string Width(string name, double v)
    {
        if (v <= 0) return "0%";
        var pct = Math.Min(100, 20 + Math.Log10(v + 1) * 30);
        return pct.ToString("0") + "%";
    }
}
