@page "/admin/identity"
@inject IApiClient Api
@inject AppState State
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PermissionGuard Require="@(new[]{ PermissionCodes.IdentityManage })">
    <PageHead Icon="sb-ico-shield" Key="Identity" Title="身份与权限" Desc="@L10n.T(Keys.Content.AdminIdentityDesc, "管理用户、角色与权限分配，基于租户作用域的 RBAC。")">
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateUser">@L10n.T(Keys.Content.AdminIdentityCreateUser, "新建用户")</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenCreateRole">@L10n.T(Keys.Content.AdminIdentityCreateRole, "新建角色")</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Reload">@L10n.T(Keys.Content.CommonRefresh, "刷新")</button>
    </PageHead>

    @if (_loading)
    {
        <LoadingState Text="@L10n.T(Keys.Content.AdminIdentityLoading, "正在加载身份与权限…")" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Message="@_error" OnRetry="Reload" />
    }
    else
    {
        <div class="stat-grid">
            <SbStatTile Label="@L10n.T(Keys.Content.AdminIdentityStatUsers, "用户")" Value="@_users.Count" Sub="@L10n.T(Keys.Content.AdminIdentityStatUsersSub, "当前租户")" />
            <SbStatTile Label="@L10n.T(Keys.Content.AdminIdentityStatRoles, "角色")" Value="@_roles.Count" Sub="@L10n.T(Keys.Content.AdminIdentityStatRolesSub, "RBAC")" Accent="info" />
            <SbStatTile Label="@L10n.T(Keys.Content.AdminIdentityStatPerms, "权限点")" Value="@_permissions.Count" Sub="@L10n.T(Keys.Content.AdminIdentityStatPermsSub, "可授予")" Accent="warning" />
        </div>

        <SbPanel Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.AdminIdentityPanelUsers, "用户")" Flush="true">
            <Body>
                @if (_users.Count == 0)
                {
                    <SbEmptyState Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.AdminIdentityEmptyUsers, "暂无用户")" Text="@L10n.T(Keys.Content.AdminIdentityEmptyUsersText, "用户是租户内可登录与操作的账号主体。")" />
                }
                else
                {
                    <SbDataTable Items="@_users" Columns="@UserColumns" PageSize="20" EmptyTitle="@L10n.T(Keys.Content.AdminIdentityNoMatchUsers, "无匹配用户")">
                        <RowActions>
                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenAssign(context)'>@L10n.T(Keys.Content.AdminIdentityAssignRole, "分配角色")</button>
                        </RowActions>
                    </SbDataTable>
                }
            </Body>
        </SbPanel>

        <SbPanel Icon="sb-ico-key" Title="@L10n.T(Keys.Content.AdminIdentityPanelRoles, "角色")" Flush="true">
            <Body>
                @if (_roles.Count == 0)
                {
                    <SbEmptyState Icon="sb-ico-key" Title="@L10n.T(Keys.Content.AdminIdentityEmptyRoles, "暂无角色")" Text="@L10n.T(Keys.Content.AdminIdentityEmptyRolesText, "角色聚合一组权限，可批量授予用户。")" />
                }
                else
                {
                    <SbDataTable Items="@_roles" Columns="@RoleColumns" PageSize="20" EmptyTitle="@L10n.T(Keys.Content.AdminIdentityNoMatchRoles, "无匹配角色")">
                        <RowActions>
                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenPerms(context)'>@L10n.T(Keys.Content.AdminIdentityEditPerms, "编辑权限")</button>
                        </RowActions>
                    </SbDataTable>
                }
            </Body>
        </SbPanel>
    }
    </PermissionGuard>
</AuthGuard>

<SbModal Visible="@_userModal" VisibleChanged="v => _userModal = v" Title="@L10n.T(Keys.Content.AdminIdentityCreateUser, "新建用户")" Size="md">
    <Body>
        <div class="form-stack">
            <SbField Label="@L10n.T(Keys.Content.CommonUsername, "用户名")" Required="true" Error="@_userErr">
                <input class="form-control" @bind="_newUser" placeholder="@L10n.T(Keys.Content.AdminIdentityUsernamePh, "登录账号")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonDisplayName, "显示名")">
                <input class="form-control" @bind="_newName" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonEmail, "邮箱")">
                <input class="form-control" @bind="_newEmail" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.AdminIdentityInitialRole, "初始角色")">
                <div class="chk-grid">
                    @foreach (var role in _roles)
                    {
                        var code = TablePresenter.Cell(role, "code");
                        <label class="chk"><input type="checkbox" checked="@_newUserRoles.Contains(code)" @onchange='(e) => ToggleSet(_newUserRoles, code, (bool)e.Value!)' /> @TablePresenter.Cell(role, "name")</label>
                    }
                    @if (_roles.Count == 0)
                    {
                        <span class="muted">@L10n.T(Keys.Content.AdminIdentityNoRoles, "暂无可选角色")</span>
                    }
                </div>
            </SbField>
        </div>
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _userModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="CreateUser">@L10n.T(Keys.Content.CommonCreate, "创建")</button>
    </Footer>
</SbModal>

<SbModal Visible="@_roleModal" VisibleChanged="v => _roleModal = v" Title="@L10n.T(Keys.Content.AdminIdentityCreateRole, "新建角色")" Size="md">
    <Body>
        <div class="form-stack">
            <SbField Label="@L10n.T(Keys.Content.CommonRoleCode, "角色编码")" Required="true" Error="@_roleErr">
                <input class="form-control" @bind="_newRoleCode" placeholder="@L10n.T(Keys.Content.AdminIdentityRoleCodePh, "如 order.manager")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonName, "名称")">
                <input class="form-control" @bind="_newRoleName" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonDescription, "描述")">
                <input class="form-control" @bind="_newRoleDesc" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonPermissions, "权限点")">
                <div class="chk-grid">
                    @foreach (var perm in _permissions)
                    {
                        var code = TablePresenter.Cell(perm, "code");
                        <label class="chk"><input type="checkbox" checked="@_newRolePerms.Contains(code)" @onchange='(e) => ToggleSet(_newRolePerms, code, (bool)e.Value!)' /> @TablePresenter.Cell(perm, "name")</label>
                    }
                    @if (_permissions.Count == 0)
                    {
                        <span class="muted">@L10n.T(Keys.Content.AdminIdentityNoPerms, "暂无可选权限")</span>
                    }
                </div>
            </SbField>
        </div>
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _roleModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="CreateRole">@L10n.T(Keys.Content.CommonCreate, "创建")</button>
    </Footer>
</SbModal>

<SbModal Visible="@_assignModal" VisibleChanged="v => _assignModal = v" Title="@L10n.T(Keys.Content.AdminIdentityAssignRole, "分配角色")" Size="sm">
    <Body>
        <p class="muted">@string.Format(L10n.T(Keys.Content.AdminIdentityAssignHint, "为用户 {0} 指派角色（角色可为全局或本租户）。"), _assignUserName)</p>
        <SbField Label="@L10n.T(Keys.Content.CommonRole, "角色")" Required="true">
            <select class="form-select" @bind="_assignRoleCode">
                <option value="">@L10n.T(Keys.Content.AdminIdentitySelectRole, "— 选择角色 —")</option>
                @foreach (var role in _roles)
                {
                    <option value="@TablePresenter.Cell(role, "code")">@TablePresenter.Cell(role, "name")</option>
                }
            </select>
        </SbField>
        @if (!string.IsNullOrWhiteSpace(_assignErr))
        {
            <div class="alert alert-warning">@_assignErr</div>
        }
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _assignModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="AskAssign">@L10n.T(Keys.Content.CommonAdd, "添加")</button>
    </Footer>
</SbModal>

<SbModal Visible="@_permModal" VisibleChanged="v => _permModal = v" Title="@L10n.T(Keys.Content.AdminIdentityModalEditPerms, "编辑角色权限")" Size="md">
    <Body>
        <p class="muted">@string.Format(L10n.T(Keys.Content.AdminIdentityPermHint, "角色 {0}（{1}）的权限集（全量替换）。"), _permRoleName, _permRoleCode)</p>
        <div class="chk-grid">
            @foreach (var perm in _permissions)
            {
                var code = TablePresenter.Cell(perm, "code");
                <label class="chk"><input type="checkbox" checked="@_permSelected.Contains(code)" @onchange='(e) => ToggleSet(_permSelected, code, (bool)e.Value!)' /> @TablePresenter.Cell(perm, "name")</label>
            }
            @if (_permissions.Count == 0)
            {
                <span class="muted">@L10n.T(Keys.Content.AdminIdentityNoPerms, "暂无可选权限")</span>
            }
        </div>
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _permModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="AskSavePerms">@L10n.T(Keys.Content.CommonSave, "保存")</button>
    </Footer>
</SbModal>

    <SbConfirm Visible="@_confirmPerms" VisibleChanged="v => _confirmPerms = v"
               Title="@L10n.T(Keys.Content.AdminIdentityConfirmSavePermsTitle, "保存角色权限")" Message="@L10n.T(Keys.Content.AdminIdentityConfirmSavePermsMsg, "确认覆盖该角色的权限集？变更对拥有此角色的用户立即生效，且需重新登录后在前端生效。")"
               ConfirmText="@L10n.T(Keys.Content.CommonSave, "保存")" Tone="danger" OnConfirm="SavePerms" />

    <SbConfirm Visible="@_confirmAssign" VisibleChanged="v => _confirmAssign = v"
               Title="@L10n.T(Keys.Content.AdminIdentityConfirmAssignTitle, "指派角色")" Message='@string.Format(L10n.T(Keys.Content.AdminIdentityConfirmAssignMsg, "确认为用户「{0}」指派角色「{1}」？"), _assignUserName, _assignRoleCode)'
               ConfirmText="@L10n.T(Keys.Content.AdminIdentityAssignRole, "指派")" Tone="danger" OnConfirm="AssignRole" />

@code {
    private List<JsonElement> _users = new();
    private List<JsonElement> _roles = new();
    private List<JsonElement> _permissions = new();
    private List<string> _userCols = new();
    private List<string> _roleCols = new();
    private string _error = "";
    private bool _loading = true;

    // 新建用户
    private bool _userModal;
    private string _newUser = "";
    private string _newName = "";
    private string _newEmail = "";
    private HashSet<string> _newUserRoles = new();
    private string _userErr = "";

    // 新建角色
    private bool _roleModal;
    private string _newRoleCode = "";
    private string _newRoleName = "";
    private string _newRoleDesc = "";
    private HashSet<string> _newRolePerms = new();
    private string _roleErr = "";

    // 分配角色
    private bool _assignModal;
    private long _assignUserId;
    private string _assignUserName = "";
    private string _assignRoleCode = "";
    private string _assignErr = "";

    // 编辑权限
    private bool _permModal;
    private string _permRoleCode = "";
    private string _permRoleName = "";
    private HashSet<string> _permSelected = new();

    private List<SbColumn<JsonElement>> UserColumns =>
        _userCols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c), r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    private List<SbColumn<JsonElement>> RoleColumns =>
        _roleCols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c), r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var tid = State.TenantId;
        var (u, _, uErr, _) = await Api.GetJsonAsync($"api/identity/users?tenantId={tid}");
        _error = uErr ?? "";
        _users = u is { ValueKind: JsonValueKind.Array } ? u.Value.EnumerateArray().ToList() : new();
        _userCols = TablePresenter.InferColumns(u);
        var (r, _, _, _) = await Api.GetJsonAsync($"api/identity/roles?tenantId={tid}");
        _roles = r is { ValueKind: JsonValueKind.Array } ? r.Value.EnumerateArray().ToList() : new();
        _roleCols = TablePresenter.InferColumns(r);
        var (p, _, _, _) = await Api.GetJsonAsync("api/identity/permissions");
        _permissions = p is { ValueKind: JsonValueKind.Array } ? p.Value.EnumerateArray().ToList() : new();
        _loading = false;
        StateHasChanged();
    }

    // ---- helpers ----
    private void ToggleSet(HashSet<string> set, string code, bool on)
    {
        if (on) set.Add(code);
        else set.Remove(code);
    }

    // ---- 新建用户 ----
    private void OpenCreateUser()
    {
        _newUser = ""; _newName = ""; _newEmail = ""; _newUserRoles.Clear(); _userErr = "";
        _userModal = true;
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(_newUser))
        {
            _userErr = L10n.T(Keys.Content.AdminIdentityUsernameRequired, "用户名必填。");
            return;
        }
        var (_, status, err, _) = await Api.PostAsync("api/identity/users", new
        {
            tenantId = State.TenantId,
            username = _newUser,
            displayName = string.IsNullOrWhiteSpace(_newName) ? null : _newName,
            email = string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail,
            roleCodes = _newUserRoles.ToArray()
        });
        if (status is >= 200 and < 300)
        {
            Toast.Success(string.Format(L10n.T(Keys.Content.AdminIdentityUserCreated, "用户 {0} 已创建。"), _newUser));
            _userModal = false;
            await Reload();
        }
        else
        {
            _userErr = err ?? string.Format(L10n.T(Keys.Content.AdminIdentityCreateFailed, "创建失败（HTTP {0}）。"), status);
        }
    }

    // ---- 新建角色 ----
    private void OpenCreateRole()
    {
        _newRoleCode = ""; _newRoleName = ""; _newRoleDesc = ""; _newRolePerms.Clear(); _roleErr = "";
        _roleModal = true;
    }

    private async Task CreateRole()
    {
        if (string.IsNullOrWhiteSpace(_newRoleCode))
        {
            _roleErr = L10n.T(Keys.Content.AdminIdentityRoleCodeRequired, "角色编码必填。");
            return;
        }
        var (_, status, err, _) = await Api.PostAsync("api/identity/roles", new
        {
            tenantId = State.TenantId,
            code = _newRoleCode,
            name = string.IsNullOrWhiteSpace(_newRoleName) ? null : _newRoleName,
            description = string.IsNullOrWhiteSpace(_newRoleDesc) ? null : _newRoleDesc,
            permissions = _newRolePerms.ToArray()
        });
        if (status is >= 200 and < 300)
        {
            Toast.Success(string.Format(L10n.T(Keys.Content.AdminIdentityRoleCreated, "角色 {0} 已创建。"), _newRoleCode));
            _roleModal = false;
            await Reload();
        }
        else
        {
            _roleErr = err ?? string.Format(L10n.T(Keys.Content.AdminIdentityCreateFailed, "创建失败（HTTP {0}）。"), status);
        }
    }

    // ---- 敏感操作二次确认（S4-4）----
    private bool _confirmPerms;
    private bool _confirmAssign;

    private void AskSavePerms() => _confirmPerms = true;
    private void AskAssign() => _confirmAssign = true;

    // ---- 分配角色 ----
    private void OpenAssign(JsonElement row)
    {
        _assignUserId = long.Parse(TablePresenter.Cell(row, "id"));
        _assignUserName = TablePresenter.Cell(row, "username");
        _assignRoleCode = ""; _assignErr = "";
        _assignModal = true;
    }

    private async Task AssignRole()
    {
        if (string.IsNullOrWhiteSpace(_assignRoleCode))
        {
            _assignErr = L10n.T(Keys.Content.AdminIdentitySelectRoleRequired, "请选择角色。");
            return;
        }
        var (_, status, err, _) = await Api.PostAsync($"api/identity/users/{_assignUserId}/roles", new { roleCode = _assignRoleCode });
        if (status is >= 200 and < 300)
        {
            Toast.Success(string.Format(L10n.T(Keys.Content.AdminIdentityAssigned, "已为 {0} 指派角色 {1}。"), _assignUserName, _assignRoleCode));
            _assignModal = false;
        }
        else
        {
            _assignErr = err ?? string.Format(L10n.T(Keys.Content.AdminIdentityAssignFailed, "指派失败（HTTP {0}）。"), status);
        }
    }

    // ---- 编辑角色权限 ----
    private void OpenPerms(JsonElement row)
    {
        _permRoleCode = TablePresenter.Cell(row, "code");
        _permRoleName = TablePresenter.Cell(row, "name");
        _permSelected = new HashSet<string>();
        if (row.TryGetProperty("permissions", out var perms) && perms.ValueKind == JsonValueKind.Array)
        {
            foreach (var p in perms.EnumerateArray())
                if (p.ValueKind == JsonValueKind.String) _permSelected.Add(p.GetString()!);
        }
        _permModal = true;
    }

    private async Task SavePerms()
    {
        var (_, status, err, _) = await Api.PutAsync($"api/identity/roles/{_permRoleCode}/permissions", new { permissions = _permSelected.ToArray() });
        if (status is >= 200 and < 300)
        {
            Toast.Success(string.Format(L10n.T(Keys.Content.AdminIdentityPermsUpdated, "角色 {0} 权限已更新。"), _permRoleCode));
            _permModal = false;
            await Reload();
        }
        else
        {
            Toast.Error(err ?? string.Format(L10n.T(Keys.Content.AdminIdentitySaveFailed, "保存失败（HTTP {0}）。"), status));
        }
    }
}
