@page "/admin/tenants"
@inject IApiClient Api
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PermissionGuard Require="@(new[]{ PermissionCodes.PlatformTenantView })">
    <PageHead Icon="sb-ico-tenant" Key="Tenants" Title="租户管理" Desc="管理多租户：创建租户、配置隔离作用域与默认配额，平台运营入口。" />

    <SbListPage TItem="JsonElement" Icon="sb-ico-tenant" Title="租户列表"
                Items="@_rows" Columns="@Columns" Loading="@_loading" Error="@_error"
                OnReload="Reload" SearchPlaceholder="搜索租户编码 / 名称…"
                EmptyTitle="暂无租户"
                EmptyText="创建租户以隔离数据与配额作用域。"
                LoadingText="正在加载租户…">

        <Actions>
            <button class="btn btn-primary btn-sm" @onclick="() => _creating = true">
                <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> 新建租户
            </button>
        </Actions>

        <Stats>
            <SbStatTile Label="租户总数" Value="@_rows.Count" Sub="平台级" />
            <SbStatTile Label="已启用" Value="@_rows.Count(IsEnabled)" Sub="使用中" Accent="success" />
            <SbStatTile Label="已停用" Value="@_rows.Count(r => !IsEnabled(r))" Sub="未启用" Accent="warning" />
        </Stats>

        <RowActions>
            <button class="btn btn-sm btn-primary" @onclick="() => OpenEdit(context)">编辑</button>
            @if (IsEnabled(context))
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AskEnable(context, false)">停用</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AskEnable(context, true)">启用</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenSettings(context)">设置</button>
        </RowActions>
    </SbListPage>

    <SbModal Visible="@_creating" VisibleChanged="v => _creating = v" Title="新建租户">
        <Body>
            <SbField Label="租户编码" Full="true" Required="true" Error="@_codeErr"><input @bind="_code" placeholder="如：t-acme" /></SbField>
            <SbField Label="租户名称" Full="true"><input @bind="_name" placeholder="如：Acme 零售" /></SbField>
            <SbField Label="首位租户管理员用户名" Full="true" Required="true" Error="@_adminErr"><input @bind="_adminUsername" placeholder="如：acme-admin" /></SbField>
            <SbField Label="管理员显示名" Full="true"><input @bind="_adminDisplayName" placeholder="如：Acme 管理员" /></SbField>
            <SbField Label="管理员邮箱" Full="true"><input @bind="_adminEmail" type="email" /></SbField>
            <SbField Label="管理员初始口令" Full="true" Required="true" Hint="至少 8 位，建议首次登录后立即修改。"><input @bind="_adminPassword" type="password" /></SbField>
            <SbField Label="租户可用语言" Full="true" Hint="用户只能在启用的语言之间切换。">
                <div class="language-choice-grid">
                    @foreach (var language in _languages)
                    {
                        var culture = Cell(language, "culture");
                        <label class="language-choice @(_selectedCultures.Contains(culture) ? "selected" : "")">
                            <input type="checkbox" checked="@_selectedCultures.Contains(culture)" @onchange="e => ToggleCulture(culture, e.Value is true)" />
                            <span class="locale-orb">@culture.Split('-')[0].ToUpperInvariant()</span>
                            <span><b>@Cell(language, "nativeName")</b><small>@culture</small></span>
                        </label>
                    }
                </div>
            </SbField>
            <SbField Label="默认显示语言" Full="true">
                <select @bind="_defaultCulture">
                    @foreach (var culture in _selectedCultures) { <option value="@culture">@LanguageName(culture)</option> }
                </select>
            </SbField>
            @if (!string.IsNullOrWhiteSpace(_createErr)) { <div class="alert alert-danger tiny" style="padding:8px 12px">@_createErr</div> }
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _creating = false">取消</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveCreate" disabled="@_saving">保存</button>
        </Footer>
    </SbModal>

    <SbModal Visible="@_editing" VisibleChanged="v => _editing = v" Title="@($"编辑租户 · {_editCode}")">
        <Body>
            <SbField Label="租户名称" Full="true"><input @bind="_editName" /></SbField>
            <SbField Label="租户支持语言" Full="true" Hint="语言范围来自平台多语言中心。">
                <div class="language-choice-grid">
                    @foreach (var language in _languages)
                    {
                        var culture = Cell(language, "culture");
                        <label class="language-choice @(_editCultures.Contains(culture) ? "selected" : "")">
                            <input type="checkbox" checked="@_editCultures.Contains(culture)" @onchange="e => ToggleEditCulture(culture, e.Value is true)" />
                            <span class="locale-orb">@culture.Split('-')[0].ToUpperInvariant()</span>
                            <span><b>@Cell(language, "nativeName")</b><small>@culture</small></span>
                        </label>
                    }
                </div>
            </SbField>
            <SbField Label="默认语言" Full="true"><select @bind="_editDefaultCulture">@foreach (var culture in _editCultures) { <option value="@culture">@LanguageName(culture)</option> }</select></SbField>
            @if (!string.IsNullOrWhiteSpace(_editError)) { <div class="alert alert-danger tiny">@_editError</div> }
        </Body>
        <Footer><button class="btn btn-outline-secondary btn-sm" @onclick="() => _editing=false">取消</button><button class="btn btn-primary btn-sm" @onclick="SaveEdit" disabled="@_savingEdit">保存修改</button></Footer>
    </SbModal>

    <SbModal Visible="@_setting" VisibleChanged="v => _setting = v" Title="@($"租户设置 · {_settingName}")">
        <Body>
            @if (_settingsLoading)
            {
                <SbSpinner />
            }
            else
            {
                @if (_settings.Count == 0)
                {
                    <SbEmptyState Icon="sb-ico-cog" Title="暂无设置" Text="为该租户新增一条配置项（Key/Value/DataType）。" />
                }
                else
                {
                    <div class="row-list">
                        @foreach (var s in _settings)
                        {
                            <div class="row-item">
                                <div><span class="badge badge-muted">@Cell(s, "key")</span> <span class="muted">@Cell(s, "dataType")</span></div>
                                <div><code>@Cell(s, "value")</code></div>
                            </div>
                        }
                    </div>
                }
                <hr />
                <SbField Label="配置 Key" Full="true" Required="true" Error="@_skErr"><input @bind="_sKey" placeholder="如：DefaultQuota" /></SbField>
                <SbField Label="配置 Value" Full="true"><input @bind="_sValue" placeholder="如：1000" /></SbField>
                <SbField Label="数据类型" Full="true">
                    <select @bind="_sType">
                        <option value="string">string</option>
                        <option value="int">int</option>
                        <option value="bool">bool</option>
                        <option value="json">json</option>
                    </select>
                </SbField>
                @if (!string.IsNullOrWhiteSpace(_settingErr)) { <div class="alert alert-danger tiny" style="padding:8px 12px">@_settingErr</div> }
            }
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _setting = false">关闭</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveSetting" disabled="@_savingSetting">保存配置</button>
        </Footer>
    </SbModal>

    <SbConfirm Visible="@_confirmEnabled" VisibleChanged="v => _confirmEnabled = v"
               Title='@(_pendingEnabled ? "启用租户" : "停用租户")'
               Message='@($"确认{(_pendingEnabled ? "启用" : "停用")}租户「{_pendingName}」？该操作会影响其数据访问与隔离作用域。")'
               ConfirmText='@(_pendingEnabled ? "启用" : "停用")' Tone="danger"
               OnConfirm="() => SetEnabled(_pendingRow, _pendingEnabled)" />
    </PermissionGuard>
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;

    private bool _creating = false;
    private bool _saving = false;
    private string _createErr = "";
    private string _codeErr = "";
    private string _code = "";
    private string _name = "";
    private string _adminUsername = "";
    private string _adminPassword = "";
    private string _adminDisplayName = "";
    private string _adminEmail = "";
    private string _adminErr = "";
    private List<JsonElement> _languages = new();
    private HashSet<string> _selectedCultures = new(StringComparer.OrdinalIgnoreCase);
    private string _defaultCulture = "en-US";
    private bool _editing, _savingEdit; private long _editId; private string _editCode="", _editName="", _editDefaultCulture="", _editError="";
    private HashSet<string> _editCultures = new(StringComparer.OrdinalIgnoreCase);

    private List<SbColumn<JsonElement>> Columns =>
        _cols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (languageData, _, _) = await Api.GetJsonAsync("api/localization/languages");
        _languages = languageData is { ValueKind: JsonValueKind.Array } ? languageData.Value.EnumerateArray().ToList() : new();
        if (_selectedCultures.Count == 0)
        {
            foreach (var language in _languages.Take(2)) _selectedCultures.Add(Cell(language, "culture"));
            if (_selectedCultures.Contains("en-US")) _defaultCulture = "en-US";
            else if (_selectedCultures.Count > 0) _defaultCulture = _selectedCultures.First();
        }
        var (data, _, err) = await Api.GetJsonAsync("api/tenant-management");
        _error = err ?? "";
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(data);
        _loading = false;
        StateHasChanged();
    }

    private async Task SaveCreate()
    {
        _codeErr = ""; _adminErr = ""; _createErr = "";
        if (string.IsNullOrWhiteSpace(_code)) { _codeErr = "租户编码必填。"; return; }
        if (string.IsNullOrWhiteSpace(_adminUsername)) { _adminErr = "首位租户管理员用户名必填。"; return; }
        if (_adminPassword.Length < 8) { _adminErr = "管理员初始口令至少 8 位。"; return; }
        var cultures = _selectedCultures.ToList();
        if (cultures.Count == 0) { _createErr = "至少选择一种租户语言。"; return; }
        if (!cultures.Contains(_defaultCulture)) _defaultCulture = cultures[0];
        _saving = true;
        var (ok, status, err) = await Api.PostAsync("api/tenant-management", new
        {
            tenantCode = _code,
            tenantName = _name,
            adminUsername = _adminUsername,
            adminPassword = _adminPassword,
            adminDisplayName = _adminDisplayName,
            adminEmail = _adminEmail,
            availableCultures = cultures,
            defaultCulture = _defaultCulture,
        });
        _saving = false;
        if (!ok) { _createErr = status == 409 ? "租户编码已存在。" : (err ?? "保存失败。"); return; }
        _creating = false; _codeErr = "";
        _code = ""; _name = ""; _adminUsername = ""; _adminPassword = ""; _adminDisplayName = ""; _adminEmail = "";
        Toast.Success("租户及首位租户管理员已创建。");
        await Reload();
    }

    private void ToggleCulture(string culture, bool enabled)
    {
        if (enabled) _selectedCultures.Add(culture); else _selectedCultures.Remove(culture);
        if (!_selectedCultures.Contains(_defaultCulture) && _selectedCultures.Count > 0) _defaultCulture = _selectedCultures.First();
    }

    private string LanguageName(string culture)
    {
        var row = _languages.FirstOrDefault(x => Cell(x, "culture") == culture);
        var name = row.ValueKind == JsonValueKind.Undefined ? culture : Cell(row, "nativeName");
        return $"{name}（{culture}）";
    }

    private void OpenEdit(JsonElement row)
    {
        if (!long.TryParse(Cell(row, "id"), out _editId)) return;
        _editCode = Cell(row, "tenantCode"); _editName = Cell(row, "tenantName"); _editError = "";
        _editCultures = ParseCultures(Cell(row, "availableCultures"));
        if (_editCultures.Count == 0) foreach (var language in _languages.Take(1)) _editCultures.Add(Cell(language, "culture"));
        _editDefaultCulture = Cell(row, "defaultCulture");
        if (!_editCultures.Contains(_editDefaultCulture)) _editDefaultCulture = _editCultures.FirstOrDefault() ?? "";
        _editing = true;
    }

    private static HashSet<string> ParseCultures(string json)
    {
        try { return new HashSet<string>(JsonSerializer.Deserialize<string[]>(json) ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase); }
        catch { return new HashSet<string>(StringComparer.OrdinalIgnoreCase); }
    }

    private void ToggleEditCulture(string culture, bool enabled)
    {
        if (enabled) _editCultures.Add(culture); else _editCultures.Remove(culture);
        if (!_editCultures.Contains(_editDefaultCulture) && _editCultures.Count > 0) _editDefaultCulture = _editCultures.First();
    }

    private async Task SaveEdit()
    {
        _editError = ""; if (_editCultures.Count == 0) { _editError = "至少选择一种语言。"; return; }
        _savingEdit = true;
        var (ok, _, err) = await Api.PutAsync($"api/tenant-management/{_editId}", new { tenantName=_editName, availableCultures=_editCultures.ToArray(), defaultCulture=_editDefaultCulture });
        _savingEdit = false; if (!ok) { _editError = err ?? "保存失败。"; return; }
        _editing = false; Toast.Success("租户基本信息与语言配置已更新。"); await Reload();
    }

    private async Task SetEnabled(JsonElement row, bool enabled)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id)) { Toast.Warning("该记录缺少 id。"); return; }
        var (ok, _, err) = await Api.PatchAsync($"api/tenant-management/{id}/{(enabled ? "enable" : "disable")}");
        if (!ok) { Toast.Error(err ?? "操作失败。"); return; }
        Toast.Success(enabled ? "租户已启用。" : "租户已停用。");
        await Reload();
    }

    private static bool IsEnabled(JsonElement row)
    {
        var v = TablePresenter.Cell(row, "enabled");
        return v == "True" || v == "true" || v == "1";
    }

    private static string Cell(JsonElement row, string col) => TablePresenter.Cell(row, col);

    // ---- 启用/停用二次确认（S4-4）----
    private bool _confirmEnabled;
    private JsonElement _pendingRow;
    private bool _pendingEnabled;
    private string _pendingName = "";

    private void AskEnable(JsonElement row, bool enabled)
    {
        _pendingRow = row;
        _pendingEnabled = enabled;
        _pendingName = TablePresenter.Cell(row, "name");
        _confirmEnabled = true;
    }

    // ---- 租户设置 Upsert（S2-4）----
    private bool _setting = false;
    private long _settingId;
    private string _settingName = "";
    private List<JsonElement> _settings = new();
    private bool _settingsLoading = false;
    private bool _savingSetting = false;
    private string _sKey = "";
    private string _sValue = "";
    private string _sType = "string";
    private string _skErr = "";
    private string _settingErr = "";

    private void OpenSettings(JsonElement row)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id) || !long.TryParse(id, out _settingId))
        {
            Toast.Warning("该记录缺少 id，无法打开设置。");
            return;
        }
        var nm = TablePresenter.Cell(row, "tenantName");
        if (string.IsNullOrWhiteSpace(nm)) nm = TablePresenter.Cell(row, "name");
        _settingName = string.IsNullOrWhiteSpace(nm) ? _settingId.ToString() : nm;
        _setting = true;
        _ = LoadSettings();
    }

    private async Task LoadSettings()
    {
        _settingsLoading = true;
        StateHasChanged();
        var (data, _, err) = await Api.GetJsonAsync($"api/tenant-management/{_settingId}/settings");
        _settingErr = err ?? "";
        _settings = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _settingsLoading = false;
        StateHasChanged();
    }

    private async Task SaveSetting()
    {
        _skErr = ""; _settingErr = "";
        if (string.IsNullOrWhiteSpace(_sKey)) { _skErr = "配置 Key 必填。"; return; }
        _savingSetting = true;
        var (ok, status, err) = await Api.PostAsync(
            $"api/tenant-management/{_settingId}/settings",
            new { key = _sKey, value = _sValue, dataType = _sType });
        _savingSetting = false;
        if (!ok) { _settingErr = status == 409 ? "配置 Key 已存在。" : (err ?? "保存失败。"); return; }
        _sKey = ""; _sValue = ""; _sType = "string";
        Toast.Success("租户配置已保存。");
        await LoadSettings();
    }
}
