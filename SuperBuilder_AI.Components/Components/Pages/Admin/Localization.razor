@page "/admin/localization"
@inject IApiClient Api
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-lang" Title="多语言" Desc="管理界面与导出的区域（Culture）、回退链与文案覆盖，支撑多语言租户。" />

    @if (_loading)
    {
        <LoadingState Text="正在加载区域配置…" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Message="@_error" OnRetry="Reload" />
    }
    else if (_rows.Count == 0)
    {
        <SbPanel Icon="sb-ico-lang" Title="可用区域">
            <Body>
                <SbEmptyState Icon="sb-ico-lang" Title="暂无区域配置"
                              Text="配置支持的语言区域与回退顺序，问数结果与导出文案将按区域呈现。" />
            </Body>
        </SbPanel>
    }
    else
    {
        <SbPanel Icon="sb-ico-lang" Title="可用区域" Flush="true">
            <Body>
                <div class="row-list">
                    @foreach (var r in _rows)
                    {
                        <div class="row-item">
                            <div class="ri-ico"><svg><use href="#sb-ico-lang" /></svg></div>
                            <div class="ri-main">
                                <div class="ri-title">@TablePresenter.Cell(r, "culture")</div>
                                <div class="ri-sub">@TablePresenter.Cell(r, "displayName") @TablePresenter.Cell(r, "name")</div>
                            </div>
                            @if (TablePresenter.Cell(r, "isDefault") == "True" || TablePresenter.Cell(r, "default") == "True")
                            { <span class="badge badge-primary">默认</span> }
                        </div>
                    }
                </div>
            </Body>
        </SbPanel>
    }
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private string _error = "";
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err) = await Api.GetJsonAsync("api/localization/locales");
        _error = err ?? "";
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _loading = false;
        StateHasChanged();
    }
}
