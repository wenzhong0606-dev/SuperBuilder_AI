@page "/admin/audit"
@inject IApiClient Api
@inject AppState State
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <SbListPage TItem="JsonElement" Icon="sb-ico-audit" Title="审计日志"
                Desc="记录关键操作与访问轨迹，支持按租户、时间检索，满足合规要求。"
                Items="@_rows" Columns="@Columns" Loading="@_loading" Error="@_error"
                OnReload="Reload" SearchPlaceholder="搜索操作 / 用户…"
                EmptyTitle="暂无审计记录"
                EmptyText="关键写操作与登录事件会被记录到这里，便于追溯与合规审查。"
                LoadingText="正在加载审计日志…">

        <Stats>
            <SbStatTile Label="日志总数" Value="@_rows.Count" Sub="当前租户" />
            <SbStatTile Label="今日" Value="@_rows.Count(IsToday)" Sub="当天事件" Accent="info" />
        </Stats>
    </SbListPage>
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;

    private List<SbColumn<JsonElement>> Columns =>
        _cols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err) = await Api.GetJsonAsync($"api/audit/logs?tenantId={State.TenantId}");
        _error = err ?? "";
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(data);
        _loading = false;
        StateHasChanged();
    }

    private bool IsToday(JsonElement row)
    {
        var v = TablePresenter.Cell(row, "time");
        if (string.IsNullOrWhiteSpace(v)) { v = TablePresenter.Cell(row, "timestamp"); }
        return !string.IsNullOrWhiteSpace(v) && v.Contains(DateTime.Now.ToString("yyyy-MM-dd"), StringComparison.Ordinal);
    }
}
