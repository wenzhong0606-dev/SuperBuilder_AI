@page "/apps"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <SbListPage TItem="JsonElement" Icon="sb-ico-app" Title="应用工厂"
                Desc="将问数会话沉淀为可复用的 BI 应用：可视化编辑器、DSL 蓝图与一键发布。"
                Items="@_rows" Columns="@Columns" Loading="@_loading" Error="@_error"
                OnReload="Reload" SearchPlaceholder="搜索应用编码 / 名称…"
                EmptyTitle="还没有应用"
                EmptyText="应用是问数能力的封装：把一次典型分析固化为卡片、图表与筛选器，分享给团队即可复用。"
                LoadingText="正在加载应用…" PanelTitle="应用清单">

        <Actions>
            <button class="btn btn-primary btn-sm" @onclick="OpenGen">
                <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> 新建应用
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>
                <svg class="btn-ico"><use href="#sb-ico-play" /></svg> 从 Ask 发布
            </button>
        </Actions>

        <Stats>
            <SbStatTile Label="应用总数" Value="@_rows.Count" Sub="含全局模板" />
            <SbStatTile Label="全局模板" Value="@_rows.Count(IsGlobal)" Sub="平台内置" Accent="info" />
            <SbStatTile Label="租户应用" Value="@_rows.Count(r => !IsGlobal(r))" Sub="本租户自建" Accent="success" />
        </Stats>

        <EmptyActions>
            <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>从 Ask 发布</button>
        </EmptyActions>

        @* 应用以卡片墙呈现（表格视图由 SbListPage 在未提供 CardTemplate 时自动启用） *@
        <CardTemplate>
            <div class="feature-card" @onclick="() => Open(context)">
                <div class="fc-ico"><svg><use href="#sb-ico-app" /></svg></div>
                <div class="fc-title">@(string.IsNullOrEmpty(Cell(context, "name")) ? Cell(context, "code") : Cell(context, "name"))</div>
                <div class="fc-desc">@(string.IsNullOrEmpty(Cell(context, "description")) ? "（暂无描述）" : Cell(context, "description"))</div>
                <div>
                    <span class="badge @(IsGlobal(context) ? "badge-info" : "badge-success")">@(IsGlobal(context) ? "全局模板" : "租户")</span>
                    @if (!string.IsNullOrEmpty(Cell(context, "code")))
                    {
                        <span class="badge badge-muted">@Cell(context, "code")</span>
                    }
                    <span style="margin-left:auto; display:inline-flex; gap:6px">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="e => OpenDsl(context)" @onclick:stopPropagation="true">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="e => AskDelete(context)" @onclick:stopPropagation="true">删除</button>
                    </span>
                </div>
            </div>
        </CardTemplate>
    </SbListPage>

    <SbConfirm Visible="@_confirm" VisibleChanged="v => _confirm = v" Title="删除应用"
               Message="删除后不可恢复，确认要删除该应用吗？" ConfirmText="删除"
               Tone="danger" OnConfirm="DoDelete" />

    <SbModal Visible="@_genModal" VisibleChanged="v => _genModal = v" Title="新建应用（自然语言生成）" Size="md">
        <Body>
            <div class="form-stack">
                <SbField Label="应用描述" Required="true" Error="@_genErr" Hint="用一句话描述你想要的 BI 应用，AI 将生成 DSL。">
                    <textarea class="form-control" rows="4" @bind="_genDesc" placeholder="例如：销售看板，按地区展示销售额与订单量"></textarea>
                </SbField>
                <SbField Label="应用编码" Hint="留空由系统生成（如 my-app-1733）。">
                    <input class="form-control" @bind="_genCode" placeholder="可选" />
                </SbField>
            </div>
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _genModal = false">取消</button>
            <button class="btn btn-primary btn-sm" @onclick="Generate">生成并创建</button>
        </Footer>
    </SbModal>

    <SbModal Visible="@_dslModal" VisibleChanged="v => _dslModal = v" Title="编辑应用 DSL" Size="lg">
        <Body>
            <p class="muted">应用 <strong>@_dslCode</strong> 的声明式定义（AppDsl JSON）。保存将重新校验并覆盖。</p>
            @if (_dslGlobal)
            {
                <div class="alert alert-warning">该应用为全局模板，不可修改。</div>
            }
            <SbField Label="DslJson" Required="true" Error="@_dslErr">
                <textarea class="form-control sb-pre" rows="14" @bind="_dslJson" readonly="@_dslGlobal"></textarea>
            </SbField>
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _dslModal = false">取消</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveDsl" disabled="@_dslGlobal">保存</button>
        </Footer>
    </SbModal>
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;

    private List<SbColumn<JsonElement>> Columns =>
        _cols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err) = await Api.GetJsonAsync($"api/apps?tenantId={State.TenantId}");
        _error = err ?? "";
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(data);
        _loading = false;
        StateHasChanged();
    }

    /// <summary>打开应用详情；缺少 code 时以提示代替跳转（避免进入空详情页）。</summary>
    private void Open(JsonElement row)
    {
        var code = Cell(row, "code");
        if (string.IsNullOrWhiteSpace(code))
        {
            Toast.Warning("该记录缺少 code，无法打开详情。");
            return;
        }
        Nav.NavigateTo($"apps/{Uri.EscapeDataString(code)}");
    }

    private void Create() => OpenGen();

    // ---- 新建（描述生成） ----
    private bool _genModal;
    private string _genDesc = "";
    private string _genCode = "";
    private string _genErr = "";

    private void OpenGen()
    {
        _genDesc = ""; _genCode = ""; _genErr = "";
        _genModal = true;
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(_genDesc))
        {
            _genErr = "应用描述必填。";
            return;
        }
        var (_, status, err) = await Api.PostAsync("api/apps/generate", new
        {
            tenantId = State.TenantId,
            description = _genDesc,
            code = string.IsNullOrWhiteSpace(_genCode) ? null : _genCode
        });
        if (status is >= 200 and < 300)
        {
            Toast.Success("应用已通过 AI 生成并创建。");
            _genModal = false;
            await Reload();
        }
        else
        {
            _genErr = err ?? $"生成失败（HTTP {status}）。";
        }
    }

    // ---- 编辑 DSL ----
    private bool _dslModal;
    private string _dslCode = "";
    private string _dslJson = "";
    private bool _dslGlobal;
    private string _dslErr = "";

    private async Task OpenDsl(JsonElement row)
    {
        var code = Cell(row, "code");
        if (string.IsNullOrWhiteSpace(code)) { Toast.Warning("该记录缺少 code，无法编辑。"); return; }
        _dslCode = code;
        _dslGlobal = IsGlobal(row);
        _dslErr = "";
        var (data, _, err) = await Api.GetJsonAsync($"api/apps/{Uri.EscapeDataString(code)}?tenantId={State.TenantId}");
        if (data is null) { Toast.Error(err ?? "读取应用失败。"); return; }
        _dslJson = data.Value.TryGetProperty("dslJson", out var dj) && dj.ValueKind == JsonValueKind.String
            ? dj.GetString()!
            : data.Value.GetRawText();
        _dslModal = true;
    }

    private async Task SaveDsl()
    {
        if (string.IsNullOrWhiteSpace(_dslJson)) { _dslErr = "DslJson 不能为空。"; return; }
        var (_, status, err) = await Api.PutAsync($"api/apps/{Uri.EscapeDataString(_dslCode)}", new { dslJson = _dslJson });
        if (status is >= 200 and < 300)
        {
            Toast.Success("应用 DSL 已保存。");
            _dslModal = false;
            await Reload();
        }
        else
        {
            _dslErr = err ?? $"保存失败（HTTP {status}）。";
        }
    }

    private bool _confirm = false;
    private string? _confirmCode;

    private void AskDelete(JsonElement row)
    {
        var code = Cell(row, "code");
        if (string.IsNullOrWhiteSpace(code)) { Toast.Warning("该记录缺少 code，无法删除。"); return; }
        _confirmCode = code;
        _confirm = true;
    }

    private async Task DoDelete()
    {
        _confirm = false;
        if (string.IsNullOrWhiteSpace(_confirmCode)) return;
        var (ok, _, err) = await Api.DeleteAsync($"api/apps/{Uri.EscapeDataString(_confirmCode)}");
        if (!ok) { Toast.Error(err ?? "删除失败。"); return; }
        Toast.Success("应用已删除。");
        await Reload();
    }

    private static string Cell(JsonElement row, string col) => TablePresenter.Cell(row, col);

    private static bool IsGlobal(JsonElement row) => Cell(row, "tenantId") == "0";
}
