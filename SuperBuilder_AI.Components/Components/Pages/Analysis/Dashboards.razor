@page "/dashboards"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using System.Text.Json.Nodes
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <SbListPage TItem="JsonElement" Icon="sb-ico-dash" Title="@L10n.T(Keys.Content.DashboardsTitle, "仪表盘")"
                Desc="@L10n.T(Keys.Content.DashboardsDesc, "将 Ask 分析结果固化为可复用的可视化看板，支持团队共享与定时刷新。")"
                Items="@_rows" Columns="@Columns" Loading="@_loading" Error="@_error"
                OnReload="Reload" SearchPlaceholder="@L10n.T(Keys.Content.DashboardsSearchPlaceholder, "搜索名称 / 编码…")"
                EmptyTitle="@L10n.T(Keys.Content.DashboardsEmptyTitle, "暂无仪表盘")"
                EmptyText="@L10n.T(Keys.Content.DashboardsEmptyText, "将一次问数结果保存为仪表盘，即可在团队内复用这套分析视角与图表。")"
                LoadingText="@L10n.T(Keys.Content.DashboardsLoading, "正在加载仪表盘…")" PageSize="20">

        <Actions>
            <PermissionGuard Require="@(new[] { PermissionCodes.DashboardCreate })" Silent>
                <button class="btn btn-primary btn-sm" @onclick="Create">
                    <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> @L10n.T(Keys.Content.DashboardsNew, "新建仪表盘")
                </button>
            </PermissionGuard>
        </Actions>

        <Stats>
            <SbStatTile Label="@L10n.T(Keys.Content.DashboardsStatTotal, "仪表盘总数")" Value="@_rows.Count" Sub="@L10n.T(Keys.Content.DashboardsStatTotalSub, "含全局模板")" />
            <SbStatTile Label="@L10n.T(Keys.Content.DashboardsStatPublished, "已发布")" Value="@_rows.Count(IsPublished)" Sub="@L10n.T(Keys.Content.DashboardsStatPublishedSub, "可对外共享")" Accent="success" />
            <SbStatTile Label="@L10n.T(Keys.Content.DashboardsStatDraft, "草稿")" Value="@_rows.Count(r => !IsPublished(r))" Sub="@L10n.T(Keys.Content.DashboardsStatDraftSub, "编辑中")" Accent="warning" />
        </Stats>

        <EmptyActions>
            <PermissionGuard Require="@(new[] { PermissionCodes.DashboardCreate })" Silent>
                <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>@L10n.T(Keys.Content.DashboardsPublishFromAsk, "从 Ask 发布")</button>
            </PermissionGuard>
        </EmptyActions>

        <RowActions>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Open(context)">@L10n.T(Keys.Content.DashboardsRowDetail, "详情")</button>
            <PermissionGuard Require="@(new[] { PermissionCodes.DashboardEdit })" Silent>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(context)">@L10n.T(Keys.Content.ThemeReuseEditDashboard, "编辑与主题")</button>
            </PermissionGuard>
            <PermissionGuard Require="@(new[] { PermissionCodes.DashboardDelete })" Silent>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(context)">@L10n.T(Keys.Content.DashboardsRowDelete, "删除")</button>
            </PermissionGuard>
        </RowActions>
    </SbListPage>

    <SbConfirm Visible="@_confirm" VisibleChanged="v => _confirm = v" Title="@L10n.T(Keys.Content.DashboardsTitle, "仪表盘")"
               Message="@L10n.T(Keys.Content.DashboardsDeleteConfirmMsg, "删除后不可恢复，确认要删除该仪表盘吗？")" ConfirmText="@L10n.T(Keys.Content.DashboardsDeleteConfirmText, "删除")"
               Tone="danger" OnConfirm="DoDelete" />

    <SbModal Visible="@_createModal" VisibleChanged="v => _createModal = v" Title="@(_editingId is null ? L10n.T(Keys.Content.DashboardsCreateTitle, "新建仪表盘") : L10n.T(Keys.Content.ThemeReuseEditDashboard, "编辑与主题"))" Size="lg">
        <Body>
            <div class="form-stack">
                <SbField Label="@L10n.T(Keys.Content.DashboardsFieldStatus, "状态")">
                    <select class="form-select" @bind="_newStatus">
                        <option value="draft">@L10n.T(Keys.Content.DashboardsStatusDraft, "草稿")</option>
                        <option value="published">@L10n.T(Keys.Content.DashboardsStatusPublished, "已发布")</option>
                    </select>
                </SbField>
                <SbField Label="@L10n.T(Keys.Content.ThemeReuseLabel, "视觉主题")" Hint="@L10n.T(Keys.Content.ThemeReuseSnapshotHint, "保存后进入草稿；发布时主题会随版本快照固化。")">
                    <select class="form-select" @bind="_newThemeKey"><option value="">@L10n.T(Keys.Content.ThemeReuseTenantDefault, "跟随租户默认主题")</option>@foreach (var theme in _themes) { <option value="@theme.Key">@theme.Name</option> }</select>
                </SbField>
                <SbField Label="@L10n.T(Keys.Content.DashboardsFieldDslJson, "DslJson")" Required="true" Error="@_createErr" Hint="@L10n.T(Keys.Content.DashboardsFieldDslJsonHint, "声明式仪表盘定义（DashboardDsl JSON）。保存将校验后创建。")">
                    <textarea class="form-control sb-pre" rows="16" @bind="_newDsl"></textarea>
                </SbField>
            </div>
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _createModal = false">@L10n.T(Keys.Content.DashboardsModalCancel, "取消")</button>
            <button class="btn btn-primary btn-sm" @onclick="SaveDashboard">@(_editingId is null ? L10n.T(Keys.Content.DashboardsModalCreate, "创建") : L10n.T(Keys.Content.ThemeReuseUpdate, "保存修改"))</button>
        </Footer>
    </SbModal>
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;
    private sealed record ThemeChoice(string Key, string Name);
    private List<ThemeChoice> _themes = new();

    /// <summary>列定义由后端返回结构推断（表头友好化与状态徽章复用 TablePresenter）。</summary>
    private List<SbColumn<JsonElement>> Columns =>
        _cols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadThemes(); await Reload(); }
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err, code) = await Api.GetJsonAsync($"api/dashboards?tenantId={State.TenantId}");
        _error = data is not null ? "" : L10n.Friendly(code, err ?? L10n.T(Keys.Content.DashboardsLoadFailed, "加载失败。"));
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(data);
        _loading = false;
        StateHasChanged();
    }

    private void Open(JsonElement row)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id))
        {
            Toast.Warning(L10n.T(Keys.Content.DashboardsMissingIdOpen, "该记录缺少 id，无法打开详情。"));
            return;
        }
        Nav.NavigateTo($"dashboards/{id}");
    }

    private bool _confirm = false;
    private string? _confirmId;

    private void AskDelete(JsonElement row)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id)) { Toast.Warning(L10n.T(Keys.Content.DashboardsMissingIdDelete, "该记录缺少 id，无法删除。")); return; }
        _confirmId = id;
        _confirm = true;
    }

    private async Task DoDelete()
    {
        _confirm = false;
        if (string.IsNullOrWhiteSpace(_confirmId)) return;
        var (ok, status, err, code) = await Api.DeleteAsync($"api/dashboards/{_confirmId}?tenantId={State.TenantId}");
        if (!ok) { Toast.Error(err is null ? L10n.T(Keys.Content.DashboardsDeleteFailed, "删除失败。") : L10n.Friendly(code, err)); return; }
        Toast.Success(L10n.T(Keys.Content.DashboardsDeleteSuccess, "仪表盘已删除。"));
        await Reload();
    }

    private Task Create() => OpenCreate();

    // ---- 新建仪表盘 ----
    private bool _createModal;
    private string _newDsl = "";
    private string _newStatus = "draft";
    private string _newThemeKey = "";
    private string _createErr = "";
    private long? _editingId;

    private async Task OpenCreate()
    {
        _createErr = "";
        _newStatus = "draft";
        _newThemeKey = "";
        _editingId = null;
        var (data, _, err, _) = await Api.GetJsonAsync("api/dashboards/editor/blueprint");
        if (data is { ValueKind: JsonValueKind.Object } && data.Value.TryGetProperty("skeleton", out var sk) && sk.ValueKind == JsonValueKind.String)
        {
            _newDsl = sk.GetString()!;
        }
        else
        {
            _newDsl = err ?? "{}";
            if (string.IsNullOrWhiteSpace(err)) _createErr = L10n.T(Keys.Content.DashboardsBlueprintUnavailable, "未能获取蓝图骨架，请手动填写 DslJson。");
        }
        _createModal = true;
    }

    private async Task OpenEdit(JsonElement row)
    {
        if (!long.TryParse(TablePresenter.Cell(row, "id"), out var id)) return;
        var (data, _, err, code) = await Api.GetJsonAsync($"api/dashboards/{id}?tenantId={State.TenantId}");
        if (data is not { ValueKind: JsonValueKind.Object }) { Toast.Error(L10n.Friendly(code, err ?? L10n.T(Keys.Content.DashboardsLoadFailed, "加载失败。"))); return; }
        _editingId = id;
        _newDsl = data.Value.TryGetProperty("dslJson", out var dsl) && dsl.ValueKind == JsonValueKind.String ? dsl.GetString() ?? "" : "";
        _newStatus = TablePresenter.Cell(data.Value, "status");
        _newThemeKey = data.Value.TryGetProperty("themeKey", out var theme) && theme.ValueKind == JsonValueKind.String ? theme.GetString() ?? "" : "";
        _createErr = "";
        _createModal = true;
    }

    private async Task SaveDashboard()
    {
        if (string.IsNullOrWhiteSpace(_newDsl)) { _createErr = L10n.T(Keys.Content.DashboardsDslJsonEmpty, "DslJson 不能为空。"); return; }
        try
        {
            var node = JsonNode.Parse(_newDsl)!.AsObject();
            node["themeKey"] = string.IsNullOrWhiteSpace(_newThemeKey) ? null : _newThemeKey;
            _newDsl = node.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex) { _createErr = ex.Message; return; }
        var request = new
        {
            tenantId = State.TenantId,
            dslJson = _newDsl,
            status = _newStatus
        };
        var result = _editingId is null
            ? await Api.PostAsync("api/dashboards", request)
            : await Api.PutAsync($"api/dashboards/{_editingId}?tenantId={State.TenantId}", request);
        var (_, status, err, code) = result;
        if (status is >= 200 and < 300)
        {
            Toast.Success(_editingId is null ? L10n.T(Keys.Content.DashboardsCreateSuccess, "仪表盘已创建。") : L10n.T(Keys.Content.ThemeReuseUpdated, "仪表盘与主题已保存。"));
            _createModal = false;
            await Reload();
        }
        else
        {
            _createErr = err is null
                ? string.Format(L10n.T(Keys.Content.DashboardsCreateFailed, "创建失败（HTTP {0}）。"), status)
                : L10n.Friendly(code, err);
        }
    }

    private static bool IsPublished(JsonElement row)
    {
        var s = TablePresenter.Cell(row, "status");
        return s.Equals("published", StringComparison.OrdinalIgnoreCase) || s.Equals("ready", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadThemes()
    {
        var (data, _, _, _) = await Api.GetJsonAsync($"api/themes?tenantId={State.TenantId}");
        _themes = data is { ValueKind: JsonValueKind.Array }
            ? data.Value.EnumerateArray()
                .Select(x => new ThemeChoice(
                    TablePresenter.Cell(x, "key"),
                    TablePresenter.Cell(x, "key").Equals("default", StringComparison.OrdinalIgnoreCase)
                        ? L10n.T(Keys.Content.ComponentGalleryBadgeDefault, "默认")
                        : TablePresenter.Cell(x, "name")))
                .Where(x => !string.IsNullOrWhiteSpace(x.Key)).ToList()
            : new();
    }
}
