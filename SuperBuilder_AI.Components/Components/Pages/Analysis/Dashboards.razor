@page "/dashboards"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <SbListPage TItem="JsonElement" Icon="sb-ico-dash" Title="仪表盘"
                Desc="将 Ask 分析结果固化为可复用的可视化看板，支持团队共享与定时刷新。"
                Items="@_rows" Columns="@Columns" Loading="@_loading" Error="@_error"
                OnReload="Reload" SearchPlaceholder="搜索名称 / 编码…"
                EmptyTitle="暂无仪表盘"
                EmptyText="将一次问数结果保存为仪表盘，即可在团队内复用这套分析视角与图表。"
                LoadingText="正在加载仪表盘…" PageSize="20">

        <Actions>
            <button class="btn btn-primary btn-sm" @onclick="Create">
                <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> 新建仪表盘
            </button>
        </Actions>

        <Stats>
            <SbStatTile Label="仪表盘总数" Value="@_rows.Count" Sub="含全局模板" />
            <SbStatTile Label="已发布" Value="@_rows.Count(IsPublished)" Sub="可对外共享" Accent="success" />
            <SbStatTile Label="草稿" Value="@_rows.Count(r => !IsPublished(r))" Sub="编辑中" Accent="warning" />
        </Stats>

        <EmptyActions>
            <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>从 Ask 发布</button>
        </EmptyActions>

        <RowActions>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Open(context)">详情</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(context)">删除</button>
        </RowActions>
    </SbListPage>

    <SbConfirm Visible="@_confirm" VisibleChanged="v => _confirm = v" Title="删除仪表盘"
               Message="删除后不可恢复，确认要删除该仪表盘吗？" ConfirmText="删除"
               Tone="danger" OnConfirm="DoDelete" />

    <SbModal Visible="@_createModal" VisibleChanged="v => _createModal = v" Title="新建仪表盘" Size="lg">
        <Body>
            <div class="form-stack">
                <SbField Label="状态">
                    <select class="form-select" @bind="_newStatus">
                        <option value="draft">草稿</option>
                        <option value="published">已发布</option>
                    </select>
                </SbField>
                <SbField Label="DslJson" Required="true" Error="@_createErr" Hint="声明式仪表盘定义（DashboardDsl JSON）。保存将校验后创建。">
                    <textarea class="form-control sb-pre" rows="16" @bind="_newDsl"></textarea>
                </SbField>
            </div>
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _createModal = false">取消</button>
            <button class="btn btn-primary btn-sm" @onclick="CreateDashboard">创建</button>
        </Footer>
    </SbModal>
</AuthGuard>

@code {
    private List<JsonElement> _rows = new();
    private List<string> _cols = new();
    private string _error = "";
    private bool _loading = true;

    /// <summary>列定义由后端返回结构推断（表头友好化与状态徽章复用 TablePresenter）。</summary>
    private List<SbColumn<JsonElement>> Columns =>
        _cols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var (data, _, err) = await Api.GetJsonAsync($"api/dashboards?tenantId={State.TenantId}");
        _error = err ?? "";
        _rows = data is { ValueKind: JsonValueKind.Array } ? data.Value.EnumerateArray().ToList() : new();
        _cols = TablePresenter.InferColumns(data);
        _loading = false;
        StateHasChanged();
    }

    private void Open(JsonElement row)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id))
        {
            Toast.Warning("该记录缺少 id，无法打开详情。");
            return;
        }
        Nav.NavigateTo($"dashboards/{id}");
    }

    private bool _confirm = false;
    private string? _confirmId;

    private void AskDelete(JsonElement row)
    {
        var id = TablePresenter.Cell(row, "id");
        if (string.IsNullOrWhiteSpace(id)) { Toast.Warning("该记录缺少 id，无法删除。"); return; }
        _confirmId = id;
        _confirm = true;
    }

    private async Task DoDelete()
    {
        _confirm = false;
        if (string.IsNullOrWhiteSpace(_confirmId)) return;
        var (ok, status, err) = await Api.DeleteAsync($"api/dashboards/{_confirmId}?tenantId={State.TenantId}");
        if (!ok) { Toast.Error(err ?? "删除失败。"); return; }
        Toast.Success("仪表盘已删除。");
        await Reload();
    }

    private void Create() => OpenCreate();

    // ---- 新建仪表盘 ----
    private bool _createModal;
    private string _newDsl = "";
    private string _newStatus = "draft";
    private string _createErr = "";

    private async Task OpenCreate()
    {
        _createErr = "";
        _newStatus = "draft";
        var (data, _, err) = await Api.GetJsonAsync("api/dashboards/editor/blueprint");
        if (data is { ValueKind: JsonValueKind.Object } && data.Value.TryGetProperty("skeleton", out var sk) && sk.ValueKind == JsonValueKind.String)
        {
            _newDsl = sk.GetString()!;
        }
        else
        {
            _newDsl = err ?? "{}";
            if (string.IsNullOrWhiteSpace(err)) _createErr = "未能获取蓝图骨架，请手动填写 DslJson。";
        }
        _createModal = true;
    }

    private async Task CreateDashboard()
    {
        if (string.IsNullOrWhiteSpace(_newDsl)) { _createErr = "DslJson 不能为空。"; return; }
        var (_, status, err) = await Api.PostAsync("api/dashboards", new
        {
            tenantId = State.TenantId,
            dslJson = _newDsl,
            status = _newStatus
        });
        if (status is >= 200 and < 300)
        {
            Toast.Success("仪表盘已创建。");
            _createModal = false;
            await Reload();
        }
        else
        {
            _createErr = err ?? $"创建失败（HTTP {status}）。";
        }
    }

    private static bool IsPublished(JsonElement row)
    {
        var s = TablePresenter.Cell(row, "status");
        return s.Equals("published", StringComparison.OrdinalIgnoreCase) || s.Equals("ready", StringComparison.OrdinalIgnoreCase);
    }
}
