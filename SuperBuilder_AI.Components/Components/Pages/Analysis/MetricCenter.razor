@page "/metrics"
@inject IApiClient Api
@inject AppState State
@inject ToastService Toast
@inject NavigationManager Nav
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-model" Key="MetricCenter" Title="指标中心"
              Desc="治理指标、维度与计算字段口径，让自然语言问数有据可依。" />

    <div class="stat-grid">
        <SbStatTile Label="@L10n.T(Keys.Content.MetricCenterStatMetrics, "指标总数")" Value="@_metrics.Count"
                    Sub="@L10n.T(Keys.Content.MetricCenterStatMetricsSub, "已定义口径")" />
        <SbStatTile Label="@L10n.T(Keys.Content.MetricCenterStatCalculated, "计算字段")" Value="@Calculated.Count"
                    Sub="@L10n.T(Keys.Content.MetricCenterStatCalculatedSub, "派生指标")" Accent="info" />
        <SbStatTile Label="@L10n.T(Keys.Content.MetricCenterStatBound, "已绑定物理列")" Value="@BoundCount"
                    Sub="@L10n.T(Keys.Content.MetricCenterStatBoundSub, "可直接下推")" Accent="success" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger tiny">@_error</div>
    }

    <SbTabs>
        <SbTab Title="@L10n.T(Keys.Content.MetricCenterTabMetrics, "指标")" Badge="@_metrics.Count.ToString()">
            <SbToolbar>
                <Left>
                    <SbSearch Value="@_query" ValueChanged="OnQueryChanged"
                              Placeholder="@L10n.T(Keys.Content.MetricCenterSearchPlaceholder, "搜索指标或实体…")" />
                </Left>
            </SbToolbar>
            <SbPanel Icon="sb-ico-model" Title="@L10n.T(Keys.Content.MetricCenterTabMetrics, "指标")" Flush="true">
                <Body>
                    @if (_metrics.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-model" Title="@L10n.T(Keys.Content.MetricCenterEmptyMetricsTitle, "暂无指标")"
                                      Text="@L10n.T(Keys.Content.MetricCenterEmptyMetricsText, "指标来自业务实体（如「销售额」「库存量」），实体语义建模完成后自动出现在此处。")" />
                    }
                    else
                    {
                        <SbDataTable Items="@MetricsFiltered" Columns="@MetricColumns" PageSize="20" Loading="_loading"
                                     EmptyTitle="@L10n.T(Keys.Content.MetricCenterNoMatch, "无匹配项")" RowActions="MetricActions" />
                    }
                </Body>
            </SbPanel>
        </SbTab>

        <SbTab Title="@L10n.T(Keys.Content.MetricCenterTabDimensions, "维度")" Badge="@_dimensions.Count.ToString()">
            <SbToolbar>
                <Left>
                    <SbSearch Value="@_query" ValueChanged="OnQueryChanged"
                              Placeholder="@L10n.T(Keys.Content.MetricCenterSearchPlaceholder, "搜索指标或实体…")" />
                </Left>
            </SbToolbar>
            <SbPanel Icon="sb-ico-tag" Title="@L10n.T(Keys.Content.MetricCenterTabDimensions, "维度")" Flush="true">
                <Body>
                    @if (_dimensions.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-tag" Title="@L10n.T(Keys.Content.MetricCenterEmptyDimensionsTitle, "暂无维度")"
                                      Text="@L10n.T(Keys.Content.MetricCenterEmptyDimensionsText, "维度用于分组与切片（如「仓库」「入库日期」），随业务域维度定义出现。")" />
                    }
                    else
                    {
                        <SbDataTable Items="@DimensionsFiltered" Columns="@DimensionColumns" PageSize="20" Loading="_loading"
                                     EmptyTitle="@L10n.T(Keys.Content.MetricCenterNoMatch, "无匹配项")" RowActions="DimensionActions" />
                    }
                </Body>
            </SbPanel>
        </SbTab>

        <SbTab Title="@L10n.T(Keys.Content.MetricCenterTabCalculated, "计算字段")" Badge="@Calculated.Count.ToString()">
            <SbPanel Icon="sb-ico-model" Title="@L10n.T(Keys.Content.MetricCenterTabCalculated, "计算字段")" Flush="true">
                <Body>
                    @if (Calculated.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-model" Title="@L10n.T(Keys.Content.MetricCenterEmptyCalculatedTitle, "暂无计算字段")"
                                      Text="@L10n.T(Keys.Content.MetricCenterEmptyCalculatedText, "计算字段是由其他指标派生的指标；口径编辑将随后续里程碑开放。")" />
                    }
                    else
                    {
                        <SbDataTable Items="@Calculated" Columns="@MetricColumns" PageSize="20" Loading="_loading"
                                     EmptyTitle="@L10n.T(Keys.Content.MetricCenterNoMatch, "无匹配项")" RowActions="MetricActions" />
                    }
                </Body>
            </SbPanel>
        </SbTab>
    </SbTabs>

    <p class="sb-graph-note">@L10n.T(Keys.Content.MetricCenterEditHint, "点击指标或维度行内「编辑」维护口径。")</p>
</AuthGuard>

<SbModal Visible="@_metricModal" VisibleChanged="v => _metricModal = v" Title="@(L10n.T(Keys.Content.CommonEdit, "编辑") + " · " + L10n.T(Keys.Content.MetricCenterTabMetrics, "指标"))" Size="lg">
    <Body>
        <div class="form-stack">
            <SbField Label="@L10n.T(Keys.Content.CommonName, "名称")" Required="true" Error="@_metricErr">
                <input class="form-control" @bind="_editMetricName" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonDescription, "展示名")">
                <input class="form-control" @bind="_editMetricDisplayName" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColSemanticType, "语义类型")">
                <input class="form-control" @bind="_editMetricSemanticType" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColAggregation, "聚合方式")">
                <input class="form-control" @bind="_editMetricAggregation" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <div class="form-check form-switch mb-2">
                <input type="checkbox" class="form-check-input" @bind="_editMetricIsCalculated" id="mc-calc" />
                <label class="form-check-label" for="mc-calc">@L10n.T(Keys.Content.MetricCenterColCalculated, "计算字段")</label>
            </div>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColExpression, "计算口径")">
                <textarea class="form-control" rows="2" @bind="_editMetricExpression" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")"></textarea>
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColDataType, "数据类型")">
                <input class="form-control" @bind="_editMetricDataType" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
        </div>
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _metricModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveMetric">@L10n.T(Keys.Content.CommonSave, "保存")</button>
    </Footer>
</SbModal>

<SbModal Visible="@_dimModal" VisibleChanged="v => _dimModal = v" Title="@(L10n.T(Keys.Content.CommonEdit, "编辑") + " · " + L10n.T(Keys.Content.MetricCenterTabDimensions, "维度"))" Size="lg">
    <Body>
        <div class="form-stack">
            <SbField Label="@L10n.T(Keys.Content.CommonName, "名称")" Required="true" Error="@_dimErr">
                <input class="form-control" @bind="_editDimName" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.CommonDescription, "描述")">
                <input class="form-control" @bind="_editDimDescription" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColExpression, "计算口径")">
                <textarea class="form-control" rows="2" @bind="_editDimExpression" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")"></textarea>
            </SbField>
            <SbField Label="@L10n.T(Keys.Content.MetricCenterColDataType, "数据类型")">
                <input class="form-control" @bind="_editDimDataType" placeholder="@L10n.T(Keys.Content.CommonOptional, "可选")" />
            </SbField>
        </div>
    </Body>
    <Footer>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _dimModal = false">@L10n.T(Keys.Content.CommonCancel, "取消")</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveDimension">@L10n.T(Keys.Content.CommonSave, "保存")</button>
    </Footer>
</SbModal>

@code {
    private List<JsonElement> _metrics = new();
    private List<JsonElement> _dimensions = new();
    private string _error = "";
    private bool _loading = true;
    private string _query = "";

    private List<JsonElement> Calculated =>
        _metrics.Where(m => IsTrue(m, "isCalculated")).ToList();

    private int BoundCount => _metrics.Count(m => IntProp(m, "physicalBindingCount") > 0);

    private List<JsonElement> MetricsFiltered =>
        string.IsNullOrWhiteSpace(_query)
            ? _metrics
            : _metrics.Where(m => CellsContain(m, "entityName", "entityDisplayName", "name", "displayName", "semanticType", "aggregation")).ToList();

    private List<JsonElement> DimensionsFiltered =>
        string.IsNullOrWhiteSpace(_query)
            ? _dimensions
            : _dimensions.Where(d => CellsContain(d, "name", "domainName", "description")).ToList();

    private List<SbColumn<JsonElement>> MetricColumns => new()
    {
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColEntity, "所属实体"),
            r => NonEmpty(TablePresenter.Cell(r, "entityDisplayName"), TablePresenter.Cell(r, "entityName"))),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColMetric, "指标"),
            r => NonEmpty(TablePresenter.Cell(r, "displayName"), TablePresenter.Cell(r, "name"))),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColSemanticType, "语义类型"),
            r => TablePresenter.Cell(r, "semanticType")),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColAggregation, "聚合方式"),
            r => TablePresenter.Cell(r, "aggregation")),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColCalculated, "计算字段"),
            r => IsTrue(r, "isCalculated") ? "✓" : "—", align: "center"),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColBindings, "物理绑定"),
            r => IntProp(r, "physicalBindingCount").ToString(), align: "right"),
    };

    private List<SbColumn<JsonElement>> DimensionColumns => new()
    {
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColDomain, "业务域"),
            r => TablePresenter.Cell(r, "domainName")),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColDimension, "维度"),
            r => TablePresenter.Cell(r, "name")),
        SbCol.Of<JsonElement>(L10n.T(Keys.Content.MetricCenterColDescription, "描述"),
            r => TablePresenter.Cell(r, "description")),
    };

    private RenderFragment<JsonElement> MetricActions =>
        row => __builder =>
        {
            var eid = TablePresenter.Cell(row, "businessEntityId");
            if (!string.IsNullOrWhiteSpace(eid))
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo($"business-model/entities/{eid}")'>@L10n.T(Keys.Content.BusinessModelDetail, "详情")</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenEditMetric(row)'>@L10n.T(Keys.Content.CommonEdit, "编辑")</button>
            }
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var tid = State.TenantId;
        var (met, _, mErr, _) = await Api.GetJsonAsync($"api/business-model/metrics?tenantId={tid}");
        var (dim, _, _, _) = await Api.GetJsonAsync($"api/business-model/dimensions?tenantId={tid}");
        _error = mErr ?? "";
        _metrics = met is { ValueKind: JsonValueKind.Array } ? met.Value.EnumerateArray().ToList() : new();
        _dimensions = dim is { ValueKind: JsonValueKind.Array } ? dim.Value.EnumerateArray().ToList() : new();
        _loading = false;
        StateHasChanged();
    }

    private void OnQueryChanged(string value) => _query = value;

    // ---- M12 增量：指标 / 维度编辑 ----
    private bool _metricModal;
    private long _editMetricEntityId;
    private string _editMetricName = "";
    private string _editMetricDisplayName = "";
    private string _editMetricDescription = "";
    private string _editMetricSemanticType = "";
    private string _editMetricAggregation = "";
    private bool _editMetricIsCalculated;
    private string _editMetricExpression = "";
    private string _editMetricDataType = "";
    private string _metricErr = "";

    private bool _dimModal;
    private long _editDimDomainId;
    private string _editDimName = "";
    private string _editDimDescription = "";
    private string _editDimExpression = "";
    private string _editDimDataType = "";
    private string _dimErr = "";

    private RenderFragment<JsonElement> DimensionActions =>
        row => __builder =>
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenEditDimension(row)'>@L10n.T(Keys.Content.CommonEdit, "编辑")</button>
        };

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private void OpenEditMetric(JsonElement row)
    {
        _editMetricEntityId = long.TryParse(TablePresenter.Cell(row, "businessEntityId"), out var eid) ? eid : 0;
        _editMetricName = TablePresenter.Cell(row, "name");
        _editMetricDisplayName = TablePresenter.Cell(row, "displayName");
        _editMetricDescription = TablePresenter.Cell(row, "description");
        _editMetricSemanticType = TablePresenter.Cell(row, "semanticType");
        _editMetricAggregation = TablePresenter.Cell(row, "aggregation");
        _editMetricIsCalculated = IsTrue(row, "isCalculated");
        _editMetricExpression = TablePresenter.Cell(row, "expression");
        _editMetricDataType = TablePresenter.Cell(row, "dataType");
        _metricErr = "";
        _metricModal = true;
    }

    private async Task SaveMetric()
    {
        if (string.IsNullOrWhiteSpace(_editMetricName))
        {
            _metricErr = L10n.T(Keys.Content.MetricCenterNameRequired, "指标名必填。");
            return;
        }
        if (_editMetricEntityId <= 0) return;

        var group = _metrics.Where(m => long.TryParse(TablePresenter.Cell(m, "businessEntityId"), out var g) && g == _editMetricEntityId).ToList();
        var payload = new List<object>();
        foreach (var m in group)
        {
            var name = TablePresenter.Cell(m, "name");
            if (name == _editMetricName)
            {
                payload.Add(new
                {
                    name = _editMetricName,
                    displayName = NullIfEmpty(_editMetricDisplayName),
                    description = NullIfEmpty(_editMetricDescription),
                    semanticType = NullIfEmpty(_editMetricSemanticType),
                    aggregation = NullIfEmpty(_editMetricAggregation),
                    isCalculated = _editMetricIsCalculated,
                    expression = NullIfEmpty(_editMetricExpression),
                    dataType = NullIfEmpty(_editMetricDataType),
                });
            }
            else
            {
                payload.Add(new
                {
                    name,
                    displayName = NullIfEmpty(TablePresenter.Cell(m, "displayName")),
                    description = NullIfEmpty(TablePresenter.Cell(m, "description")),
                    semanticType = NullIfEmpty(TablePresenter.Cell(m, "semanticType")),
                    aggregation = NullIfEmpty(TablePresenter.Cell(m, "aggregation")),
                    isCalculated = IsTrue(m, "isCalculated"),
                    expression = NullIfEmpty(TablePresenter.Cell(m, "expression")),
                    dataType = NullIfEmpty(TablePresenter.Cell(m, "dataType")),
                });
            }
        }

        var (_, status, err, _) = await Api.PutAsync($"api/business-model/entities/{_editMetricEntityId}/metrics?tenantId={State.TenantId}", payload);
        if (status is >= 200 and < 300)
        {
            Toast.Success(L10n.T(Keys.Content.CommonSaveSuccess, "已保存。"));
            _metricModal = false;
            await Reload();
        }
        else
        {
            _metricErr = err ?? string.Format(L10n.T(Keys.Content.MetricCenterSaveFailed, "保存失败（HTTP {0}）。"), status);
        }
    }

    private void OpenEditDimension(JsonElement row)
    {
        _editDimDomainId = long.TryParse(TablePresenter.Cell(row, "businessDomainId"), out var did) ? did : 0;
        _editDimName = TablePresenter.Cell(row, "name");
        _editDimDescription = TablePresenter.Cell(row, "description");
        _editDimExpression = TablePresenter.Cell(row, "expression");
        _editDimDataType = TablePresenter.Cell(row, "dataType");
        _dimErr = "";
        _dimModal = true;
    }

    private async Task SaveDimension()
    {
        if (string.IsNullOrWhiteSpace(_editDimName))
        {
            _dimErr = L10n.T(Keys.Content.MetricCenterDimNameRequired, "维度名必填。");
            return;
        }
        if (_editDimDomainId <= 0) return;

        var group = _dimensions.Where(d => long.TryParse(TablePresenter.Cell(d, "businessDomainId"), out var g) && g == _editDimDomainId).ToList();
        var payload = new List<object>();
        foreach (var d in group)
        {
            var name = TablePresenter.Cell(d, "name");
            if (name == _editDimName)
            {
                payload.Add(new
                {
                    name = _editDimName,
                    description = NullIfEmpty(_editDimDescription),
                    expression = NullIfEmpty(_editDimExpression),
                    dataType = NullIfEmpty(_editDimDataType),
                });
            }
            else
            {
                payload.Add(new
                {
                    name,
                    description = NullIfEmpty(TablePresenter.Cell(d, "description")),
                    expression = NullIfEmpty(TablePresenter.Cell(d, "expression")),
                    dataType = NullIfEmpty(TablePresenter.Cell(d, "dataType")),
                });
            }
        }

        var (_, status, err, _) = await Api.PutAsync($"api/business-model/domains/{_editDimDomainId}/dimensions?tenantId={State.TenantId}", payload);
        if (status is >= 200 and < 300)
        {
            Toast.Success(L10n.T(Keys.Content.CommonSaveSuccess, "已保存。"));
            _dimModal = false;
            await Reload();
        }
        else
        {
            _dimErr = err ?? string.Format(L10n.T(Keys.Content.MetricCenterSaveFailed, "保存失败（HTTP {0}）。"), status);
        }
    }

    private bool CellsContain(JsonElement row, params string[] keys)
        => keys.Any(k => TablePresenter.Cell(row, k).Contains(_query, StringComparison.OrdinalIgnoreCase));

    private static string NonEmpty(string primary, string fallback)
        => string.IsNullOrWhiteSpace(primary) ? fallback : primary;

    private static JsonElement? Prop(JsonElement row, string key)
    {
        if (row.ValueKind != JsonValueKind.Object) return null;
        foreach (var p in row.EnumerateObject())
        {
            if (string.Equals(p.Name, key, StringComparison.OrdinalIgnoreCase)) return p.Value;
        }
        return null;
    }

    private static bool IsTrue(JsonElement row, string key)
    {
        var v = Prop(row, key);
        return v is { } value && value.ValueKind == JsonValueKind.True;
    }

    private static int IntProp(JsonElement row, string key)
    {
        var v = Prop(row, key);
        if (v is not { } value) return 0;
        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var n)) return n;
        return int.TryParse(value.ToString(), out var parsed) ? parsed : 0;
    }
}
