@inject NavigationManager Nav
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<div class="sb-graph-wrap">
    @if (Entities is null || Entities.Count == 0)
    {
        <SbEmptyState Icon="sb-ico-model" Title="@L10n.T(Keys.Content.BusinessModelGraphEmpty, "暂无实体，请先在「实体」中新建。")" />
    }
    else
    {
        <div class="sb-graph-hint">@L10n.T(Keys.Content.BusinessModelGraphClickHint, "点击任意实体查看详情。")</div>
        <div class="sb-graph-scroll">
            <svg class="sb-graph-svg" viewBox="0 0 @SvgW @SvgH" width="@SvgW" height="@SvgH" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <marker id="sb-graph-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth">
                        <path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8" />
                    </marker>
                </defs>
                @foreach (var e in _edges)
                {
                    <line x1="@e.X1" y1="@e.Y1" x2="@e.X2" y2="@e.Y2" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sb-graph-arrow)" />
                }
                @foreach (var n in _nodes)
                {
                    <g class="sb-graph-node" @onclick="() => Open(n.Id)">
                        <rect x="@n.X" y="@n.Y" width="@NodeW" height="@NodeH" rx="8" ry="8" class="sb-graph-node-rect" />
                        <text x="@(n.X + NodeW / 2)" y="@(n.Y + NodeH / 2)" class="sb-graph-node-label" dominant-baseline="middle" text-anchor="middle">@Truncate(n.Label)</text>
                    </g>
                }
            </svg>
        </div>
        @if (Relationships is null || Relationships.Count == 0)
        {
            <div class="sb-graph-note">@L10n.T(Keys.Content.BusinessModelGraphNoRelationships, "当前实体之间尚未定义关系；关系编辑将随后续里程碑开放。")</div>
        }
    }
</div>

@code {
    [Parameter] public List<JsonElement> Entities { get; set; } = new();
    [Parameter] public List<JsonElement> Relationships { get; set; } = new();

    private const int NodeW = 170;
    private const int NodeH = 46;
    private const int ColGap = 64;
    private const int RowGap = 24;
    private const int Pad = 24;

    private sealed record NodePos(string Id, double X, double Y, string Label);
    private sealed record EdgeLine(double X1, double Y1, double X2, double Y2);

    private readonly List<NodePos> _nodes = new();
    private readonly List<EdgeLine> _edges = new();
    private readonly Dictionary<string, (double X, double Y)> _centers = new();

    private double SvgW => _nodes.Count == 0 ? 420 : _nodes.Max(n => n.X) + NodeW + Pad;
    private double SvgH => _nodes.Count == 0 ? 200 : _nodes.Max(n => n.Y) + NodeH + Pad;

    protected override void OnParametersSet() => Compute();

    private void Compute()
    {
        _nodes.Clear();
        _edges.Clear();
        _centers.Clear();

        var groups = Entities
            .GroupBy(e => TablePresenter.Cell(e, "businessDomain") is { Length: > 0 } s ? s : "(uncategorized)")
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var col = 0;
        foreach (var g in groups)
        {
            var row = 0;
            foreach (var ent in g)
            {
                var id = TablePresenter.Cell(ent, "id");
                var label = TablePresenter.Cell(ent, "displayName");
                if (string.IsNullOrWhiteSpace(label)) label = TablePresenter.Cell(ent, "name");
                if (string.IsNullOrWhiteSpace(label)) label = id;
                var x = Pad + col * (NodeW + ColGap);
                var y = Pad + row * (NodeH + RowGap);
                _nodes.Add(new NodePos(id, x, y, label ?? id));
                _centers[id] = (x + NodeW / 2.0, y + NodeH / 2.0);
                row++;
            }
            col++;
        }

        foreach (var rel in Relationships)
        {
            var sId = TablePresenter.Cell(rel, "sourceEntityId");
            var tId = TablePresenter.Cell(rel, "targetEntityId");
            if (_centers.TryGetValue(sId, out var s) && _centers.TryGetValue(tId, out var t))
            {
                _edges.Add(new EdgeLine(s.X, s.Y, t.X, t.Y));
            }
        }
    }

    private static string Truncate(string? label)
    {
        if (string.IsNullOrEmpty(label)) return string.Empty;
        return label.Length > 12 ? label.Substring(0, 11) + "…" : label;
    }

    private void Open(string id)
    {
        if (!string.IsNullOrWhiteSpace(id)) Nav.NavigateTo($"business-model/entities/{id}");
    }
}
