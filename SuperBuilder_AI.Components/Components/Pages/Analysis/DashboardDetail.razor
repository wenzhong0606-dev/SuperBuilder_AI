@page "/dashboards/{Id:long}"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-dash" Title="@(_title)" Desc="@L10n.T(Keys.Content.DashboardDetailDesc, "仪表盘详情：基本信息、组件构成与渲染结果。")">
        <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("dashboards")'>@L10n.T(Keys.Content.DashboardDetailBack, "返回列表")</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Load()">@L10n.T(Keys.Content.CommonRefresh, "刷新")</button>
    </PageHead>

    @if (_loading)
    {
        <LoadingState Text="@L10n.T(Keys.Content.DashboardDetailLoading, "正在加载仪表盘…")" />
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="() => Load()" />
    }
    else
    {
        <SbTabs>
            <SbTab Title="@L10n.T(Keys.Content.DashboardDetailTabOverview, "概览")">
                <SbPanel Icon="sb-ico-dash" Title="@L10n.T(Keys.Content.DashboardDetailInfoTitle, "基本信息")">
                    <Body>
                        <SbKeyValue Items="@JsonRows.Scalars(_detail)" />
                    </Body>
                </SbPanel>
            </SbTab>

            <SbTab Title="@L10n.T(Keys.Content.DashboardDetailTabComponents, "组件")" Badge="@_components.Count.ToString()">
                <SbPanel Icon="sb-ico-comp" Title="@L10n.T(Keys.Content.DashboardDetailComponentsTitle, "组件构成")" Flush="true">
                    <Body>
                        @if (_components.Count == 0)
                        {
                            <div class="panel-body">
                                <SbEmptyState Icon="sb-ico-comp" Title="@L10n.T(Keys.Content.DashboardDetailCompEmptyTitle, "未解析到组件")" Text="@L10n.T(Keys.Content.DashboardDetailCompEmptyText, "该仪表盘尚未配置组件，或 DSL 结构暂不支持前端解析。")" />
                            </div>
                        }
                        else
                        {
                            <div class="row-list">
                                @foreach (var c in _components)
                                {
                                    <div class="row-item">
                                        <span class="ri-ico"><svg><use href="#sb-ico-comp" /></svg></span>
                                        <div class="ri-main">
                                            <div class="ri-title">@(string.IsNullOrWhiteSpace(c.Title) ? c.Type : c.Title)</div>
                                            <div class="ri-sub">@string.Format(L10n.T(Keys.Content.DashboardDetailTypeAndId, "类型 {0} · 标识 {1}"), c.Type, c.Id)</div>
                                        </div>
                                        <div class="ri-actions"><SbBadge Tone="info">@c.Type</SbBadge></div>
                                    </div>
                                }
                            </div>
                        }
                    </Body>
                </SbPanel>
            </SbTab>

            <SbTab Title="@L10n.T(Keys.Content.DashboardDetailTabData, "数据")">
                @if (_rows.Count > 0)
                {
                    <ResultTable Rows="@_rows" Footer="@string.Format(L10n.T(Keys.Content.DashboardDetailRowCount, "共 {0} 行"), _rows.Count)" />
                }
                else
                {
                    <SbEmptyState Icon="sb-ico-db" Title="@L10n.T(Keys.Content.DashboardDetailDataEmptyTitle, "暂无渲染数据")" Text="@L10n.T(Keys.Content.DashboardDetailDataEmptyText, "点击渲染后端会执行一次取数，若仍无数据请检查仪表盘配置与数据源可用性。")" />
                }
                <div class="mt-3">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Render" disabled="@_rendering">
                        @(_rendering ? L10n.T(Keys.Content.DashboardDetailRendering, "渲染中…") : L10n.T(Keys.Content.DashboardDetailRunRender, "执行渲染"))
                    </button>
                </div>
                <SqlViewer Sql="@_sql" />
            </SbTab>
        </SbTabs>
    }
</AuthGuard>

@code {
    [Parameter] public long Id { get; set; }

    private string _title = "";
    private JsonElement? _detail;
    private List<Dictionary<string, object?>> _rows = new();
    private List<Comp> _components = new();
    private string? _sql;
    private string? _error;
    private bool _loading = true;
    private bool _rendering;

    protected override void OnInitialized()
    {
        _title = L10n.T(Keys.Content.DashboardDetailDefaultTitle, "仪表盘详情");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/dashboards/{Id}");
        if (data is null)
        {
            _error = err ?? $"加载失败（{status}）。";
        }
        else
        {
            _detail = data;
            _title = JsonRows.Scalar(data, "name", "title", "code");
            if (string.IsNullOrWhiteSpace(_title)) _title = L10n.T(Keys.Content.DashboardDetailDefaultTitle, "仪表盘详情");
            _components = ExtractComponents(data);
        }
        _loading = false;
        await Render(silent: true);
        StateHasChanged();
    }

    private async Task Render() => await Render(silent: false);

    /// <summary>执行渲染取数；silent=true 用于首次加载时的静默尝试（失败不报错）。</summary>
    private async Task Render(bool silent)
    {
        if (_rendering) return;
        _rendering = true;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/dashboards/{Id}/render");
        _rendering = false;
        if (data is not null)
        {
            _rows = JsonRows.Extract(data);
            _sql = JsonRows.Scalar(data, "sql", "generatedSql");
        }
        else if (!silent)
        {
            _error = err ?? $"渲染失败（{status}）。";
        }
        StateHasChanged();
    }

    internal sealed record Comp(string Id, string Type, string Title);

    /// <summary>从仪表盘详情 / DSL 中提取组件清单（兼容 pages[].components 与内嵌 dslJson）。</summary>
    internal static List<Comp> ExtractComponents(JsonElement? root)
    {
        var list = new List<Comp>();
        if (root is not { ValueKind: JsonValueKind.Object }) return list;
        var el = root.Value;

        void Add(JsonElement arr)
        {
            foreach (var c in arr.EnumerateArray())
            {
                if (c.ValueKind != JsonValueKind.Object) continue;
                list.Add(new Comp(
                    JsonRows.Scalar(c, "id", "code"),
                    JsonRows.Scalar(c, "type", "componentType"),
                    JsonRows.Scalar(c, "title", "name")));
            }
        }

        if (el.TryGetProperty("components", out var comps) && comps.ValueKind == JsonValueKind.Array) Add(comps);
        if (el.TryGetProperty("pages", out var pages) && pages.ValueKind == JsonValueKind.Array)
        {
            foreach (var p in pages.EnumerateArray())
                if (p.ValueKind == JsonValueKind.Object && p.TryGetProperty("components", out var pc) && pc.ValueKind == JsonValueKind.Array)
                    Add(pc);
        }
        if (list.Count == 0 && el.TryGetProperty("dslJson", out var dsl) && dsl.ValueKind == JsonValueKind.String)
        {
            try
            {
                using var doc = JsonDocument.Parse(dsl.GetString() ?? "");
                list = ExtractComponents(doc.RootElement.Clone());
            }
            catch
            {
                // DSL 非法时保持空清单
            }
        }
        return list;
    }
}
