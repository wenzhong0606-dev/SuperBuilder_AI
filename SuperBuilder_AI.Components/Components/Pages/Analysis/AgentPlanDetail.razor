@page "/agent/plans/{Code}"
@inject IApiClient Api
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-agent" Title="@(_title)" Desc="@L10n.T(Keys.Content.AgentPlanDetailDesc, "智能体计划详情：目标、步骤序列与原始编排数据。")">
        <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("agent")'>@L10n.T(Keys.Content.AgentPlanDetailBack, "返回列表")</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Load()">@L10n.T(Keys.Content.CommonRefresh, "刷新")</button>
        <button class="btn btn-danger btn-sm" @onclick="() => _confirmOpen = true">@L10n.T(Keys.Content.AgentPlanDetailDelete, "删除")</button>
    </PageHead>

    @if (_loading)
    {
        <LoadingState Text="@L10n.T(Keys.Content.AgentPlanDetailLoadingText, "正在加载计划…")" />
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="() => Load()" />
    }
    else
    {
        <SbTabs>
            <SbTab Title="@L10n.T(Keys.Content.AgentPlanDetailTabOverview, "概览")">
                <SbPanel Icon="sb-ico-agent" Title="@L10n.T(Keys.Content.AgentPlanDetailPanelInfo, "计划信息")">
                    <Body><SbKeyValue Items="@JsonRows.Scalars(_detail)" /></Body>
                </SbPanel>
            </SbTab>
            <SbTab Title="@L10n.T(Keys.Content.AgentPlanDetailTabSteps, "步骤")" Badge="@_steps.Count.ToString()">
                <SbPanel Icon="sb-ico-play" Title="@L10n.T(Keys.Content.AgentPlanDetailPanelSteps, "执行步骤")" Flush="true">
                    <Body>
                        @if (_steps.Count == 0)
                        {
                            <div class="panel-body">
                                <SbEmptyState Icon="sb-ico-play" Title="@L10n.T(Keys.Content.AgentPlanDetailEmptyStepsTitle, "暂无步骤")" Text="@L10n.T(Keys.Content.AgentPlanDetailEmptyStepsText, "该计划未包含可解析的步骤序列。")" />
                            </div>
                        }
                        else
                        {
                            <div class="row-list">
                                @foreach (var s in _steps)
                                {
                                    <div class="row-item">
                                        <span class="ri-ico"><svg><use href="#sb-ico-play" /></svg></span>
                                        <div class="ri-main">
                                            <div class="ri-title">@s.Title</div>
                                            <div class="ri-sub">@s.Detail</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </Body>
                </SbPanel>
            </SbTab>
            <SbTab Title="@L10n.T(Keys.Content.AgentPlanDetailTabRaw, "原始数据")">
                <SbPanel Title="@L10n.T(Keys.Content.AgentPlanDetailPanelRaw, "编排数据（只读）")">
                    <Body><pre class="sb-pre">@_raw</pre></Body>
                </SbPanel>
            </SbTab>
        </SbTabs>
    }

    <SbConfirm @bind-Visible="_confirmOpen" Title="@L10n.T(Keys.Content.AgentPlanDetailConfirmTitle, "删除计划")" Tone="danger"
               Message="@string.Format(L10n.T(Keys.Content.AgentPlanDetailConfirmMessage, "确认删除计划「{0}」？该操作不可撤销。"), _title)"
               ConfirmText="@L10n.T(Keys.Content.AgentPlanDetailDelete, "删除")" OnConfirm="DoDelete" />
</AuthGuard>

@code {
    [Parameter] public string Code { get; set; } = "";

    private string _title = "";

    protected override void OnInitialized()
    {
        _title = L10n.T(Keys.Content.AgentPlanDetailDefaultTitle, "计划详情");
    }
    private JsonElement? _detail;
    private List<Step> _steps = new();
    private string _raw = "";
    private string? _error;
    private bool _loading = true;
    private bool _confirmOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        var (data, status, err, _) = await Api.GetJsonAsync($"api/agent/plans/{Uri.EscapeDataString(Code)}");
        _loading = false;
        if (data is null)
        {
            _error = err ?? string.Format(L10n.T(Keys.Content.AgentPlanDetailLoadFailed, "加载失败（{0}）。"), status);
            return;
        }
        _detail = data;
        _title = JsonRows.Scalar(data, "name", "title", "goal", "code");
        if (string.IsNullOrWhiteSpace(_title)) _title = Code;
        _steps = ExtractSteps(data);
        _raw = data.Value.ToString();
        StateHasChanged();
    }

    internal sealed record Step(string Title, string Detail);

    /// <summary>从计划 JSON 中提取步骤（兼容 steps / plan.steps / stages）。</summary>
    private List<Step> ExtractSteps(JsonElement? root)
    {
        var list = new List<Step>();
        if (root is not { ValueKind: JsonValueKind.Object }) return list;
        var el = root.Value;

        void Add(JsonElement arr)
        {
            var index = 1;
            foreach (var s in arr.EnumerateArray())
            {
                if (s.ValueKind == JsonValueKind.Object)
                {
                    var title = JsonRows.Scalar(s, "title", "name", "description");
                    var detail = JsonRows.Scalar(s, "tool", "action", "type", "detail");
                    list.Add(new Step(string.IsNullOrWhiteSpace(title) ? string.Format(L10n.T(Keys.Content.AgentPlanDetailStepN, "步骤 {0}"), index) : title, detail));
                }
                else if (s.ValueKind == JsonValueKind.String)
                {
                    list.Add(new Step(string.Format(L10n.T(Keys.Content.AgentPlanDetailStepN, "步骤 {0}"), index), s.GetString() ?? ""));
                }
                index++;
            }
        }

        foreach (var key in new[] { "steps", "stages", "tasks" })
            if (el.TryGetProperty(key, out var arr) && arr.ValueKind == JsonValueKind.Array) { Add(arr); return list; }

        if (el.TryGetProperty("plan", out var plan) && plan.ValueKind == JsonValueKind.Object)
            foreach (var key in new[] { "steps", "stages" })
                if (plan.TryGetProperty(key, out var arr2) && arr2.ValueKind == JsonValueKind.Array) { Add(arr2); return list; }

        return list;
    }

    private async Task DoDelete()
    {
        var (ok, status, err, _) = await Api.DeleteAsync($"api/agent/plans/{Uri.EscapeDataString(Code)}");
        if (ok)
        {
            Toast.Success(L10n.T(Keys.Content.AgentPlanDetailDeleted, "计划已删除。"));
            Nav.NavigateTo("agent");
        }
        else
        {
            Toast.Error(err ?? string.Format(L10n.T(Keys.Content.AgentPlanDetailDeleteFailed, "删除失败（{0}）。"), status));
        }
    }
}
