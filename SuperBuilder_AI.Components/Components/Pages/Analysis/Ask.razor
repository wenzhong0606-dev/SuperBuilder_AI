@page "/ask"
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using SuperBuilder_AI.Components.Models
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject AskSessionStore Session
@inject FileDownloadService Download
@inject ToastService Toast

<h2>@L10n.T(Keys.Content.AskTitle, "Ask BI 智能问数（旗舰）")</h2>

@if (!State.SessionRestored)
{
    <LoadingState Text="@L10n.T(Keys.Content.AskRestoringSession, "正在恢复登录会话…")" />
}
else if (!State.IsAuthenticated)
{
    <p class="muted">@L10n.T(Keys.Content.AskLoginHint, "请先")<a href="" @onclick="@(() => Nav.NavigateTo("/login"))">@L10n.T(Keys.Content.AskLoginLink, "登录")</a>@L10n.T(Keys.Content.AskLoginHint2, "后再问数。")</p>
}
else
{
    <div class="card ask-bar">
        <div class="ask-bar-row">
            <div class="ask-ds">
                @L10n.T(Keys.Content.AskDataScope, "可访问数据范围")
                @if (_dsBusy)
                {
                    <span class="muted tiny">@L10n.T(Keys.Content.AskDataLoading, "加载中…")</span>
                }
                else if (_dsError is not null)
                {
                    <span class="error tiny">@_dsError</span>
                }
                else
                {
                    <div class="ask-source-scope">@foreach (var source in _dsOptions) { <span class="badge badge-primary">@source.Name</span> }</div>
                }
            </div>
            <label class="ask-q">@L10n.T(Keys.Content.AskQuestionLabel, "自然语言问题")<textarea class="form-control" @bind="Question" placeholder="@L10n.T(Keys.Content.AskQuestionPlaceholder, "例如：上个月各区域销售额对比")"></textarea></label>
        </div>
        <div class="ask-actions">
            <button class="btn btn-primary" @onclick="DoAsk" disabled="@Busy">@L10n.T(Keys.Content.AskButtonAsk, "提问")</button>
            <button class="btn btn-outline-secondary" @onclick="ClearChat" disabled="@Busy">@L10n.T(Keys.Content.AskButtonClear, "清空对话")</button>
            @if (_sessionLoaded && Turns.Count > 0) { <span class="muted tiny">@string.Format(L10n.T(Keys.Content.AskHistoryRestored, "已恢复 {0} 轮历史"), Turns.Count)</span> }
            @if (!string.IsNullOrEmpty(GlobalError)) { <span class="error">@GlobalError</span> }
        </div>
    </div>

    @if (Turns.Count == 0)
    {
        <p class="muted">@L10n.T(Keys.Content.AskNoConversation, "还没有对话。试着问一个业务问题，例如「本月各品类销售额 Top 10」。")</p>
    }

    @foreach (var tp in WithParents())
    {
        <AskTurnCard Turn="tp.Turn" Index="tp.Index" CompareWith="tp.Parent" OnRefine="DoRefine" OnPublish="Publish" OnExport="Export" />
    }
}

@code {
    private string Question = "";
    private long DataSourceId = 0;
    private bool Busy = false;
    private string? GlobalError = "";
    private readonly List<AskTurn> Turns = new();

    private List<DataSourcePicker.Option> _dsOptions = new();
    private bool _dsBusy = false;
    private string? _dsError;

    private bool _sessionLoaded = false;
    private string? _conversationId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.SessionRestored && State.IsAuthenticated)
        {
            if (!_dsBusy && _dsOptions.Count == 0 && _dsError is null)
                await LoadDataSourcesAsync();
            if (!_sessionLoaded)
            {
                _sessionLoaded = true;
                var saved = await Session.LoadAsync(State.TenantId, State.UserId);
                if (saved.Count > 0)
                {
                    Turns.Clear();
                    Turns.AddRange(saved);
                    StateHasChanged();
                }
            }
        }
    }

    private async Task LoadDataSourcesAsync()
    {
        _dsBusy = true;
        try
        {
            var (data, _, err, _) = await Api.GetJsonAsync("api/data-sources");
            if (data is null) { _dsError = err ?? L10n.T(Keys.Content.AskDataSourceListEmpty, "数据源列表为空"); return; }
            var opts = JsonSerializer.Deserialize<List<DsOption>>(data.Value.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (opts is { Count: > 0 })
            {
                _dsOptions = opts.Select(o => new DataSourcePicker.Option { Id = o.Id, Name = o.Name + (string.IsNullOrWhiteSpace(o.DbType) ? "" : $" · {o.DbType}") }).ToList();
            }
            else
            {
                _dsError = L10n.T(Keys.Content.AskNoDataSources, "当前账号暂无可用数据源");
            }
        }
        catch (Exception ex)
        {
            _dsError = string.Format(L10n.T(Keys.Content.AskDataSourceLoadFailed, "数据源加载失败：{0}"), ex.Message);
        }
        finally
        {
            _dsBusy = false;
        }
    }

    private sealed record TurnWithParent(AskTurn Turn, int Index, AskTurn? Parent);

    /// <summary>为每轮计算其父轮（用于 S3-5 语义细化对比）。细化子轮绑定最近的普通轮。</summary>
    private List<TurnWithParent> WithParents()
    {
        var list = new List<TurnWithParent>();
        AskTurn? lastParent = null;
        for (var i = 0; i < Turns.Count; i++)
        {
            if (Turns[i].IsRefine) list.Add(new TurnWithParent(Turns[i], i, lastParent));
            else { list.Add(new TurnWithParent(Turns[i], i, null)); lastParent = Turns[i]; }
        }
        return list;
    }

    private async Task DoAsk()
    {
        if (string.IsNullOrWhiteSpace(Question)) { GlobalError = L10n.T(Keys.Content.AskEnterQuestion, "请输入问题。"); return; }
        if (_dsOptions.Count == 0) { GlobalError = L10n.T(Keys.Content.AskNoAuthorizedDataSource, "当前账号尚未获授权任何数据源，请联系租户管理员。"); return; }
        Busy = true; GlobalError = "";
        var turn = new AskTurn { Question = Question, DataSourceIdHint = 0 };
        Turns.Add(turn);
        var q = Question; Question = "";
        var outcome = await Api.AskAsync(q, DataSourceId, _conversationId);
        ApplyOutcome(turn, outcome);
        _conversationId = outcome.Response?.ConversationStatus == "AwaitingClarification" ? outcome.Response.ConversationId : null;
        await PersistAsync();
        Busy = false;
    }

    /// <summary>多轮语义细化（P11.3）：以「原始问题 + 历史 + 指令」经后端重新查询，结果作为子轮次追加。</summary>
    private async Task DoRefine(AskTurn turn)
    {
        var instr = turn.RefineInstruction?.Trim();
        if (string.IsNullOrWhiteSpace(instr)) { turn.RefineError = L10n.T(Keys.Content.AskEnterRefineInstruction, "请输入细化指令。"); return; }
        turn.RefineBusy = true; turn.RefineError = null; turn.RefineInfo = null;
        try
        {
            var history = Turns
                .TakeWhile(t => t != turn)
                .Where(t => !string.IsNullOrWhiteSpace(t.Question))
                .Select(t => RefineTurn.User(t.Question))
                .ToList();
            var outcome = await Api.RefineAsync(turn.Question, instr, history, DataSourceId);
            var child = new AskTurn { Question = $"{turn.Question} → {instr}", IsRefine = true, DataSourceIdHint = DataSourceId };
            ApplyOutcome(child, outcome);
            Turns.Add(child);
            turn.RefineInfo = L10n.T(Keys.Content.AskRefineBasedOnResult, "已基于本轮结果重新查询（多轮语义调整）。");
            await PersistAsync();
        }
        catch (Exception ex)
        {
            turn.RefineError = string.Format(L10n.T(Keys.Content.AskRefineException, "细化异常：{0}"), ex.Message);
        }
        finally
        {
            turn.RefineBusy = false;
        }
    }

    private void ApplyOutcome(AskTurn turn, AskOutcome outcome)
    {
        if (!outcome.HasResponse)
        {
            turn.Error = outcome.Error ?? L10n.T(Keys.Content.AskFailed, "问数失败。");
            turn.Code = outcome.Code;
            turn.TraceId = outcome.TraceId;
            return;
        }
        turn.Response = outcome.Response;
        if (!outcome.Response.Success && string.IsNullOrEmpty(outcome.Response.ErrorMessage) && outcome.Response.Answer is null)
            turn.Error = L10n.T(Keys.Content.AskNoValidResult, "问数未返回有效结果。");
        else if (!string.IsNullOrEmpty(outcome.Response.ErrorMessage))
            turn.Error = outcome.Response.ErrorMessage;
    }

    private async Task ClearChat()
    {
        Turns.Clear();
        _conversationId = null;
        GlobalError = "";
        await PersistAsync();
    }

    private async Task PersistAsync()
    {
        if (_sessionLoaded) await Session.SaveAsync(State.TenantId, State.UserId, Turns);
    }

    // ===== 导出（S3-3，经 AskTurnCard 回调）=====
    private async Task Export(AskTurnCard.AskTurnExport e)
    {
        if (e.Turn is not { Response.Data.Rows.Count: > 0 })
        {
            Toast.Warning(L10n.T(Keys.Content.ExportNoData, "没有可导出的数据。"));
            return;
        }
        await ExportRows(e.Turn.Response!.Data.Rows, e.Format, e.Turn.Question);
    }

    private static List<string> CollectColumns(List<Dictionary<string, object?>> rows)
    {
        var cols = new List<string>();
        foreach (var r in rows)
            foreach (var k in r.Keys)
                if (!cols.Contains(k)) cols.Add(k);
        return cols;
    }

    private async Task ExportRows(List<Dictionary<string, object?>> rows, string format, string title)
    {
        var cols = CollectColumns(rows);
        bool ok;
        if (format == "excel")
        {
            var html = BuildExcel(rows, cols, title);
            ok = await Download.DownloadTextAsync(SafeName(title) + ".xls", "application/vnd.ms-excel", html);
        }
        else
        {
            var csv = BuildCsv(rows, cols);
            ok = await Download.DownloadTextAsync(SafeName(title) + ".csv", "text/csv", csv);
        }
        if (!ok) Toast.Error(L10n.T(Keys.Content.ExportFailed, "导出失败，请重试。"));
    }

    private static string SafeName(string s)
    {
        var n = new string((s ?? "ask").Where(c => char.IsLetterOrDigit(c) || c == '-' || c == '_').ToArray());
        return string.IsNullOrEmpty(n) ? "ask-export" : n[..Math.Min(n.Length, 40)];
    }

    private static string CsvCell(object? v)
    {
        var s = JsonValue.AsString(v);
        if (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            return "\"" + s.Replace("\"", "\"\"") + "\"";
        return s;
    }

    private static string BuildCsv(List<Dictionary<string, object?>> rows, List<string> cols)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", cols.Select(CsvCell)));
        foreach (var r in rows)
            sb.AppendLine(string.Join(",", cols.Select(c => CsvCell(r.GetValueOrDefault(c)))));
        // 加 BOM 确保 Excel 中文不乱码
        return "\uFEFF" + sb.ToString();
    }

    private static string BuildExcel(List<Dictionary<string, object?>> rows, List<string> cols, string title)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<html xmlns:x=\"urn:schemas-microsoft-com:office:excel\"><head><meta charset=\"utf-8\"></head><body>");
        sb.Append("<table border=\"1\"><thead><tr>");
        foreach (var c in cols) sb.Append("<th>").Append(EscapeHtml(c)).Append("</th>");
        sb.Append("</tr></thead><tbody>");
        foreach (var r in rows)
        {
            sb.Append("<tr>");
            foreach (var c in cols) sb.Append("<td>").Append(EscapeHtml(JsonValue.AsString(r.GetValueOrDefault(c)))).Append("</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table></body></html>");
        return sb.ToString();
    }

    private static string EscapeHtml(string s) => s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");

    // ===== 发布为应用（序列化 → P8 BuildFromDslAsync）=====

    private async Task Publish(AskTurn turn)
    {
        if (turn.Response is null) return;
        turn.PublishBusy = true; turn.PublishError = null; turn.PublishInfo = null;
        try
        {
            var q = turn.Question;
            var code = "ask-" + State.TenantId + "-" + DateTimeOffset.UtcNow.ToUnixTimeSeconds() + "-" + Guid.NewGuid().ToString("N")[..4];
            var name = L10n.T(Keys.Content.AskPublishedAppNamePrefix, "问数应用：") + (q.Length > 40 ? q[..40] + "…" : q);
            var desc = turn.Response.Answer?.Answer;
            if (!string.IsNullOrEmpty(desc) && desc.Length > 200) desc = desc[..200] + "…";

            var viz = turn.Response.Answer?.Visualizations?.FirstOrDefault();
            var chartType = viz?.Type ?? "bar";
            if (chartType == "table") chartType = "bar";

            var components = new List<object>
            {
                new
                {
                    type = "chart", id = "chart1", title = viz?.Title ?? L10n.T(Keys.Content.AskChartTitleDefault, "结果图"), order = 1,
                    properties = new Dictionary<string, string> { { "chartType", chartType }, { "categoryField", viz?.XAxis ?? "" } },
                    style = new { palette = "primary", showBorder = true, padding = "normal" }
                },
                new
                {
                    type = "table", id = "table1", title = L10n.T(Keys.Content.AskTableTitleDefault, "明细数据"), order = 2,
                    properties = new Dictionary<string, string> { { "pageSize", "20" } },
                    style = new { showBorder = true }
                },
                new
                {
                    type = "text", id = "answer1", title = L10n.T(Keys.Content.AskAiSummaryTitle, "AI 解读"), order = 3,
                    properties = new Dictionary<string, string> { { "markdown", desc ?? "" } },
                    style = new { showBorder = true }
                }
            };

            var dsl = new
            {
                version = "1.0",
                code,
                name,
                description = desc,
                pages = new[]
                {
                    new
                    {
                        id = "home", name = "结果", order = 1,
                        layout = new { kind = "grid", columns = 12, rowHeight = 64, gap = 12 },
                        components
                    }
                }
            };
            var json = System.Text.Json.JsonSerializer.Serialize(dsl);
            var (ok, c, err) = await Api.PublishAppAsync(State.TenantId, json, code);
            if (ok) turn.PublishInfo = string.Format(L10n.T(Keys.Content.AskPublishSuccess, "已发布为应用：{0}"), c);
            else turn.PublishError = string.Format(L10n.T(Keys.Content.AskPublishFailed, "发布失败：{0}"), err ?? "未知错误");
        }
        catch (Exception ex)
        {
            turn.PublishError = string.Format(L10n.T(Keys.Content.AskPublishException, "发布异常：{0}"), ex.Message);
        }
        finally
        {
            turn.PublishBusy = false;
        }
    }

    private sealed class DsOption
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string DbType { get; set; } = "";
    }
}
