@page "/apps/{Code}"
@inject IApiClient Api
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-app" Title="@(_title)" Desc="@L10n.T(Keys.Content.AppDetailDesc, "应用详情：DSL 结构、页面与组件清单。")">
        <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("apps")'>@L10n.T(Keys.Content.AppDetailBack, "返回列表")</button>
        <PermissionGuard Require="@(new[] { PermissionCodes.AppView })">
            <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo($"apps/{Uri.EscapeDataString(Code)}/run")'>@L10n.T(Keys.Content.AppDetailRun, "运行")</button>
        </PermissionGuard>
        <PermissionGuard Require="@(new[] { PermissionCodes.AppEdit })">
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo($"apps/{Uri.EscapeDataString(Code)}/preview")'>@L10n.T(Keys.Content.AppDetailPreview, "预览")</button>
        </PermissionGuard>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Load()">@L10n.T(Keys.Content.AppDetailRefresh, "刷新")</button>
        <button class="btn btn-danger btn-sm" @onclick="() => _confirmOpen = true">@L10n.T(Keys.Content.AppDetailDelete, "删除")</button>
    </PageHead>

    @if (_loading)
    {
        <LoadingState Text="@L10n.T(Keys.Content.AppDetailLoading, "正在加载应用…")" />
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="() => Load()" />
    }
    else
    {
        <SbTabs>
            <SbTab Title="@L10n.T(Keys.Content.AppDetailTabOverview, "概览")">
                <SbPanel Icon="sb-ico-app" Title="@L10n.T(Keys.Content.AppDetailPanelBasic, "基本信息")">
                    <Body><SbKeyValue Items="@JsonRows.Scalars(_detail)" /></Body>
                </SbPanel>
            </SbTab>
            <SbTab Title="@L10n.T(Keys.Content.AppDetailTabComponents, "页面与组件")" Badge="@_components.Count.ToString()">
                <SbPanel Icon="sb-ico-comp" Title="@L10n.T(Keys.Content.AppDetailPanelComponents, "组件清单")" Flush="true">
                    <Body>
                        @if (_components.Count == 0)
                        {
                            <div class="panel-body">
                                <SbEmptyState Icon="sb-ico-comp" Title="@L10n.T(Keys.Content.AppDetailEmptyComponentsTitle, "未解析到组件")" Text="@L10n.T(Keys.Content.AppDetailEmptyComponentsText, "该应用的 DSL 中暂无可解析的组件定义。")" />
                            </div>
                        }
                        else
                        {
                            <div class="row-list">
                                @foreach (var c in _components)
                                {
                                    <div class="row-item">
                                        <span class="ri-ico"><svg><use href="#sb-ico-comp" /></svg></span>
                                        <div class="ri-main">
                                            <div class="ri-title">@(string.IsNullOrWhiteSpace(c.Title) ? c.Type : c.Title)</div>
                                            <div class="ri-sub">@c.Type · @c.Id</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </Body>
                </SbPanel>
            </SbTab>
            <SbTab Title="@L10n.T(Keys.Content.AppDetailTabDsl, "DSL")">
                <SbPanel Title="@L10n.T(Keys.Content.AppDetailPanelDsl, "App DSL（只读）")">
                    <Body><pre class="sb-pre">@_dslText</pre></Body>
                </SbPanel>
            </SbTab>
        </SbTabs>
    }

    <SbConfirm @bind-Visible="_confirmOpen" Title="@L10n.T(Keys.Content.AppDetailDeleteConfirmTitle, "删除应用")" Tone="danger"
               Message="@string.Format(L10n.T(Keys.Content.AppDetailDeleteConfirmMsg, "确认删除应用「{0}」？该操作不可撤销。"), _title)"
               ConfirmText="@L10n.T(Keys.Content.AppDetailDeleteConfirmText, "删除")" OnConfirm="DoDelete" />
</AuthGuard>

@code {
    [Parameter] public string Code { get; set; } = "";

    private string _title = "应用详情";
    private JsonElement? _detail;
    private List<DashboardDetail.Comp> _components = new();
    private string _dslText = "";
    private string? _error;
    private bool _loading = true;
    private bool _confirmOpen;

    protected override void OnInitialized() => _title = L10n.T(Keys.Content.AppDetailTitleDefault, "应用详情");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        var (data, status, err, code) = await Api.GetJsonAsync($"api/apps/{Uri.EscapeDataString(Code)}");
        _loading = false;
        if (data is null)
        {
            _error = err is null
                ? string.Format(L10n.T(Keys.Content.AppDetailLoadFailed, "加载失败（{0}）。"), status)
                : L10n.Friendly(code, err);
            return;
        }
        _detail = data;
        _title = JsonRows.Scalar(data, "name", "title", "code");
        if (string.IsNullOrWhiteSpace(_title)) _title = Code;
        _components = DashboardDetail.ExtractComponents(data);
        if (data.Value.TryGetProperty("dslJson", out var dsl) && dsl.ValueKind == JsonValueKind.String)
            _dslText = dsl.GetString() ?? "";
        StateHasChanged();
    }

    private async Task DoDelete()
    {
        var (ok, status, err, code) = await Api.DeleteAsync($"api/apps/{Uri.EscapeDataString(Code)}");
        if (ok)
        {
            Toast.Success(L10n.T(Keys.Content.AppDetailDeleteSuccess, "应用已删除。"));
            Nav.NavigateTo("apps");
        }
        else
        {
            Toast.Error(err is null ? string.Format(L10n.T(Keys.Content.AppDetailDeleteFailed, "删除失败（{0}）。"), status) : L10n.Friendly(code, err));
        }
    }
}
