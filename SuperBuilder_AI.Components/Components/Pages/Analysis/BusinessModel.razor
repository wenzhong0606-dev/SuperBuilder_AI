@page "/business-model"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-model" Key="BusinessModel" Title="语义模型" Desc="把物理表结构映射为业务语言：实体、业务域与字段同义词，让自然语言问数更精准。">
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
            <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> @L10n.T(Keys.Action.New, "新建") @L10n.T(Keys.Content.BusinessModelEntities, "实体")
        </button>
    </PageHead>

    <div class="stat-grid">
        <SbStatTile Label="@L10n.T(Keys.Content.BusinessModelDomains, "业务域")" Value="@_domains.Count" Sub="@L10n.T(Keys.Content.BusinessModelDomainsSub, "用于分类")" />
        <SbStatTile Label="@L10n.T(Keys.Content.BusinessModelEntities, "实体")" Value="@_entities.Count" Sub="@L10n.T(Keys.Content.BusinessModelEntitiesSub, "对应业务表")" Accent="info" />
        <SbStatTile Label="@L10n.T(Keys.Content.BusinessModelResolved, "已解析语义")" Value="@_entities.Count(IsResolved)" Sub="@L10n.T(Keys.Content.BusinessModelResolvedSub, "可在 Ask 提问")" Accent="success" />
    </div>

    <SbTabs>
        <SbTab Title="@L10n.T(Keys.Content.BusinessModelDomains, "业务域")" Badge="@_domains.Count.ToString()">
            <SbPanel Icon="sb-ico-model" Title="@L10n.T(Keys.Content.BusinessModelDomains, "业务域")" Flush="true">
                <Body>
                    @if (_domains.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-model" Title="@L10n.T(Keys.Content.BusinessModelEmptyDomainsTitle, "暂无业务域")"
                                      Text="@L10n.T(Keys.Content.BusinessModelEmptyDomainsText, "业务域用于组织对实体的分类，例如「销售」「库存」「财务」。")" />
                    }
                    else
                    {
                        <div class="row-list">
                            @foreach (var d in _domains)
                            {
                                <div class="row-item">
                                    <div class="ri-ico"><svg><use href="#sb-ico-model" /></svg></div>
                                    <div class="ri-main">
                                        <div class="ri-title">@TablePresenter.Cell(d, "name")</div>
                                        <div class="ri-sub">@TablePresenter.Cell(d, "description")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </Body>
            </SbPanel>
        </SbTab>

        <SbTab Title="@L10n.T(Keys.Content.BusinessModelEntities, "实体")" Badge="@_entities.Count.ToString()">
            <SbToolbar>
                <Left>
                    <SbSearch Value="@_query" ValueChanged="OnQueryChanged" Placeholder="@L10n.T(Keys.Content.BusinessModelSearchPlaceholder, "搜索实体…")" />
                </Left>
            </SbToolbar>
            <SbPanel Icon="sb-ico-db" Title="@L10n.T(Keys.Content.BusinessModelEntities, "实体")" Flush="true">
                <Body>
                    @if (_entities.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-db" Title="@L10n.T(Keys.Content.BusinessModelEmptyEntitiesTitle, "暂无实体")"
                                      Text="@L10n.T(Keys.Content.BusinessModelEmptyEntitiesText, "实体对应一张业务表（如「客户」「订单」），解析后可在 Ask 中直接以业务名提问。")" />
                    }
                    else
                    {
                        <SbDataTable Items="@_entityFiltered" Columns="@EntityColumns" PageSize="20"
                                     EmptyTitle="@L10n.T(Keys.Content.BusinessModelNoMatch, "无匹配实体")" RowActions="EntityActions" />
                    }
                </Body>
            </SbPanel>
        </SbTab>
    </SbTabs>

    <SbModal Visible="@CreateVisible" VisibleChanged="v => CreateVisible = v" Title="新建实体" Size="lg">
        <Body>
            <div class="field-grid ds-create-fields">
                <SbField Label="业务键（BusinessKey）" Required="true" Hint="租户内唯一、稳定的业务标识，如 customer、order"><input @bind="NewBusinessKey" placeholder="customer" /></SbField>
                <SbField Label="实体名称（Name）" Required="true" Hint="对应业务表的名称"><input @bind="NewName" placeholder="e.g. customer" /></SbField>
                <SbField Label="展示名（DisplayName）"><input @bind="NewDisplayName" placeholder="e.g. Customer table" /></SbField>
                <SbField Label="所属业务域（BusinessDomain）"><input @bind="NewBusinessDomain" placeholder="e.g. Sales" /></SbField>
            </div>
            <SbField Label="描述（Description）" Full="true"><input @bind="NewDescription" placeholder="Entity meaning and usage" /></SbField>
            <SbField Label="语义口径（SemanticText）" Full="true"><textarea @bind="NewSemanticText" placeholder="Field synonyms, business definitions"></textarea></SbField>
            <SbField Label="状态（Status）">
                <select @bind="NewStatus">
                    <option value="Active">@L10n.T(Keys.Content.BusinessModelStatusActive, "已激活")</option>
                    <option value="Draft">@L10n.T(Keys.Content.BusinessModelStatusDraft, "草稿")</option>
                    <option value="Unresolved">@L10n.T(Keys.Content.BusinessModelStatusUnresolved, "未解析")</option>
                    <option value="Deprecated">@L10n.T(Keys.Content.BusinessModelStatusDeprecated, "已弃用")</option>
                </select>
            </SbField>
            @if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger tiny" style="margin-top:12px">@Error</div> }
        </Body>
        <Footer>
            <button class="btn btn-outline-secondary" @onclick='() => CreateVisible = false'>@L10n.T(Keys.Action.Cancel, "取消")</button>
            <button class="btn btn-primary" @onclick="Save" disabled="@Saving">@(Saving ? "正在保存…" : "保存")</button>
        </Footer>
    </SbModal>
</AuthGuard>

@code {
    private List<JsonElement> _entities = new();
    private List<JsonElement> _domains = new();
    private List<string> _entityCols = new();
    private JsonElement? _entityData;
    private string _error = "";
    private bool _loading = true;
    private string _query = "";

    private List<SbColumn<JsonElement>> EntityColumns =>
        _entityCols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    private List<JsonElement> _entityFiltered =>
        string.IsNullOrWhiteSpace(_query)
            ? _entities
            : _entities.Where(e => _entityCols.Any(c => TablePresenter.Cell(e, c).Contains(_query, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var tid = State.TenantId;
        var (ent, _, eErr, _) = await Api.GetJsonAsync($"api/business-model/entities?tenantId={tid}");
        var (dom, _, _, _) = await Api.GetJsonAsync($"api/business-model/domains?tenantId={tid}");
        _error = eErr ?? "";
        _entityData = ent;
        _entities = ent is { ValueKind: JsonValueKind.Array } ? ent.Value.EnumerateArray().ToList() : new();
        _entityCols = TablePresenter.InferColumns(_entityData);
        _domains = dom is { ValueKind: JsonValueKind.Array } ? dom.Value.EnumerateArray().ToList() : new();
        _loading = false;
        StateHasChanged();
    }

    private void OnQueryChanged(string value) => _query = value;

    private RenderFragment<JsonElement> EntityActions =>
        row => __builder =>
        {
            var id = TablePresenter.Cell(row, "id");
            if (!string.IsNullOrWhiteSpace(id))
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo($"business-model/entities/{id}")'>@L10n.T(Keys.Content.BusinessModelDetail, "详情")</button>
            }
        };

    private bool CreateVisible;
    private string NewBusinessKey = "", NewName = "", NewDisplayName = "", NewDescription = "", NewBusinessDomain = "", NewSemanticText = "", NewStatus = "Active";
    private bool Saving;
    private string Error = "";

    private void OpenCreate()
    {
        NewBusinessKey = ""; NewName = ""; NewDisplayName = ""; NewDescription = ""; NewBusinessDomain = ""; NewSemanticText = ""; NewStatus = "Active";
        Error = ""; CreateVisible = true;
    }

    private async Task Save()
    {
        Error = "";
        if (string.IsNullOrWhiteSpace(NewBusinessKey) || string.IsNullOrWhiteSpace(NewName))
        {
            Error = "业务键（BusinessKey）与实体名称（Name）为必填。";
            return;
        }
        Saving = true;
        var tid = State.TenantId;
        var (ok, _, err, _) = await Api.PostAsync($"api/business-model/entities?tenantId={tid}", new
        {
            businessKey = NewBusinessKey.Trim(),
            name = NewName.Trim(),
            displayName = NewDisplayName.Trim(),
            description = NewDescription.Trim(),
            businessDomain = NewBusinessDomain.Trim(),
            semanticText = NewSemanticText.Trim(),
            status = NewStatus,
        });
        Saving = false;
        if (!ok) { Error = err ?? "保存失败。"; return; }
        CreateVisible = false;
        Toast.Success("实体已创建。");
        await Reload();
    }

    private static bool IsResolved(JsonElement row)
    {
        var s = TablePresenter.Cell(row, "status");
        return !string.IsNullOrEmpty(s) && s != "0" && !s.Equals("unresolved", StringComparison.OrdinalIgnoreCase);
    }
}
