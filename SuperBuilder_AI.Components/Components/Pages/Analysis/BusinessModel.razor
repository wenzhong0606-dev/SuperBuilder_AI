@page "/business-model"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using SuperBuilder_AI.Components.Shared

<AuthGuard>
    <PageHead Icon="sb-ico-model" Key="BusinessModel" Title="语义模型" Desc="把物理表结构映射为业务语言：实体、业务域与字段同义词，让自然语言问数更精准。">
        <button class="btn btn-primary btn-sm" @onclick="Create">
            <svg class="btn-ico"><use href="#sb-ico-plus" /></svg> @L10n.T(Keys.Action.New, "新建") 实体
        </button>
    </PageHead>

    <div class="stat-grid">
        <SbStatTile Label="业务域" Value="@_domains.Count" Sub="用于分类" />
        <SbStatTile Label="实体" Value="@_entities.Count" Sub="对应业务表" Accent="info" />
        <SbStatTile Label="已解析语义" Value="@_entities.Count(IsResolved)" Sub="可在 Ask 提问" Accent="success" />
    </div>

    <SbTabs>
        <SbTab Title="业务域" Badge="@_domains.Count.ToString()">
            <SbPanel Icon="sb-ico-model" Title="业务域" Flush="true">
                <Body>
                    @if (_domains.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-model" Title="暂无业务域"
                                      Text="业务域用于组织对实体的分类，例如「销售」「库存」「财务」。" />
                    }
                    else
                    {
                        <div class="row-list">
                            @foreach (var d in _domains)
                            {
                                <div class="row-item">
                                    <div class="ri-ico"><svg><use href="#sb-ico-model" /></svg></div>
                                    <div class="ri-main">
                                        <div class="ri-title">@TablePresenter.Cell(d, "name")</div>
                                        <div class="ri-sub">@TablePresenter.Cell(d, "description")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </Body>
            </SbPanel>
        </SbTab>

        <SbTab Title="实体" Badge="@_entities.Count.ToString()">
            <SbToolbar>
                <Left>
                    <SbSearch Value="@_query" ValueChanged="OnQueryChanged" Placeholder="搜索实体…" />
                </Left>
            </SbToolbar>
            <SbPanel Icon="sb-ico-db" Title="实体" Flush="true">
                <Body>
                    @if (_entities.Count == 0)
                    {
                        <SbEmptyState Icon="sb-ico-db" Title="暂无实体"
                                      Text="实体对应一张业务表（如「客户」「订单」），解析后可在 Ask 中直接以业务名提问。" />
                    }
                    else
                    {
                        <SbDataTable Items="@_entityFiltered" Columns="@EntityColumns" PageSize="20"
                                     EmptyTitle="无匹配实体" RowActions="EntityActions" />
                    }
                </Body>
            </SbPanel>
        </SbTab>
    </SbTabs>
</AuthGuard>

@code {
    private List<JsonElement> _entities = new();
    private List<JsonElement> _domains = new();
    private List<string> _entityCols = new();
    private JsonElement? _entityData;
    private string _error = "";
    private bool _loading = true;
    private string _query = "";

    private List<SbColumn<JsonElement>> EntityColumns =>
        _entityCols.Select(c => SbCol.Of<JsonElement>(
            TablePresenter.Friendly(c),
            r => TablePresenter.Cell(r, c),
            isStatus: TablePresenter.IsStatusColumn(c))).ToList();

    private List<JsonElement> _entityFiltered =>
        string.IsNullOrWhiteSpace(_query)
            ? _entities
            : _entities.Where(e => _entityCols.Any(c => TablePresenter.Cell(e, c).Contains(_query, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var tid = State.TenantId;
        var (ent, _, eErr) = await Api.GetJsonAsync($"api/business-model/entities?tenantId={tid}");
        var (dom, _, _) = await Api.GetJsonAsync($"api/business-model/domains?tenantId={tid}");
        _error = eErr ?? "";
        _entityData = ent;
        _entities = ent is { ValueKind: JsonValueKind.Array } ? ent.Value.EnumerateArray().ToList() : new();
        _entityCols = TablePresenter.InferColumns(_entityData);
        _domains = dom is { ValueKind: JsonValueKind.Array } ? dom.Value.EnumerateArray().ToList() : new();
        _loading = false;
        StateHasChanged();
    }

    private void OnQueryChanged(string value) => _query = value;

    private RenderFragment<JsonElement> EntityActions =>
        row => __builder =>
        {
            var id = TablePresenter.Cell(row, "id");
            if (!string.IsNullOrWhiteSpace(id))
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo($"business-model/entities/{id}")'>详情</button>
            }
        };

    private void Create() => Toast.Info("实体编辑器将在 S2 阶段接入。");

    private static bool IsResolved(JsonElement row)
    {
        var s = TablePresenter.Cell(row, "status");
        return !string.IsNullOrEmpty(s) && s != "0" && !s.Equals("unresolved", StringComparison.OrdinalIgnoreCase);
    }
}
