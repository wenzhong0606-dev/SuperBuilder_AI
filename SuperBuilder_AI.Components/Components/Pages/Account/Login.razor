@page "/login"
@layout BlankLayout
@inject IApiClient Api
@inject AppState State
@inject AuthStore Session
@inject NavigationManager Nav
@inject LocalizationService L10n
@inject IJSRuntime JS

<div class="login-wrap">
    <section class="login-hero">
        <h1>SuperBuilder AI</h1>
        <p class="sub">@L10n.T("Login.Tagline")</p>
            <div class="tags">
            <span>@L10n.T(Keys.Login.HeroAINativeBI, "AI Native BI")</span>
            <span>@L10n.T(Keys.Login.HeroMultiTenant, "多租户")</span>
            <span>@L10n.T(Keys.Login.HeroMultilingual, "多语言")</span>
            <span>@L10n.T(Keys.Login.HeroLowCode, "低代码")</span>
            <span>@L10n.T(Keys.Login.HeroEnterpriseSaaS, "企业级 SaaS")</span>
        </div>
    </section>

    <section class="login-form">
        <div class="login-language"><LanguageSwitcher OnCultureChanged="ChangeLoginCulture" /></div>
        @if (BootstrapChecking)
        {
            <div class="card"><LoadingState Text="@L10n.T(Keys.Login.CheckingInit, "正在检查平台初始化状态…")" /></div>
        }
        else if (BootstrapRequired)
        {
            if (!BootstrapAnonymousAllowed)
            {
                <div class="card">
                    <h2 style="margin:0 0 4px;">@L10n.T(Keys.Login.InitEntryClosed, "初始化入口已关闭")</h2>
                    <p class="muted tiny">@L10n.T(Keys.Login.InitEntryClosedHint, "当前环境已禁用匿名初始化。请由部署配置（PlatformBootstrap:Username/Password）完成首位平台管理员创建。")</p>
                </div>
            }
            else
            {
                <div class="card">
                    <h2 style="margin:0 0 4px;">@L10n.T(Keys.Login.InitPlatformAdmin, "初始化平台系统管理员")</h2>
                    <p class="muted tiny">@L10n.T(Keys.Login.InitNotice, "这是一次性初始化入口。创建完成后将永久关闭，请妥善保管管理员口令。")</p>
                    <label>@L10n.T(Keys.Login.AdminUsername, "管理员用户名")<input class="form-control" @bind="BootstrapUsername" placeholder="@L10n.T(Keys.Login.AdminUsername, "管理员用户名")" /></label>
                    <label>@L10n.T(Keys.Login.DisplayName, "显示名")<input class="form-control" @bind="BootstrapDisplayName" /></label>
                    <label>@L10n.T(Keys.Login.AdminEmail, "管理员邮箱")<input class="form-control" @bind="BootstrapEmail" placeholder="admin@example.com" /></label>
                    <label>@L10n.T(Keys.Login.AdminPassword, "管理员口令")<input class="form-control" @bind="BootstrapPassword" type="password" placeholder="@L10n.T(Keys.Login.AdminPassword, "管理员口令")" /></label>
                    <label>@L10n.T(Keys.Login.ConfirmPassword, "确认口令")<input class="form-control" @bind="BootstrapPasswordConfirm" type="password" /></label>
                    <button class="btn btn-primary" @onclick="InitializePlatform" disabled="@Busy">@L10n.T(Keys.Login.CreateAdmin, "创建平台管理员")</button>
                    @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
                </div>
            }
        }
        else if (State.IsAuthenticated)
        {
                <div class="card">
                <p class="ok">@L10n.T(Keys.Common.CurrentUser, "当前用户")：@State.Username（@L10n.T(Keys.Common.Tenant, "租户") @State.TenantId，@L10n.T(Keys.Common.User, "用户") @State.UserId）</p>
                <button class="btn btn-outline-secondary" @onclick="Logout">@L10n.T(Keys.Common.Logout, "退出登录")</button>
            </div>
        }
        else
        {
            <div class="card">
                <h2 style="margin:0 0 4px;">@L10n.T("Login.Title")</h2>
                <label for="login-username">@L10n.T("Login.Username")<input id="login-username" data-testid="login-username" class="form-control" @bind="Username" placeholder="@L10n.T(Keys.Login.Username, "用户名")" autocomplete="username" aria-invalid="@(string.IsNullOrEmpty(Error) ? "false" : "true")" /></label>
                <label for="login-password">@L10n.T("Login.Password")<input id="login-password" data-testid="login-password" class="form-control" @bind="Password" type="password" placeholder="@L10n.T(Keys.Login.Password, "口令")" autocomplete="current-password" aria-invalid="@(string.IsNullOrEmpty(Error) ? "false" : "true")" /></label>
                <label for="login-tenant">@L10n.T("Login.TenantId")
                @if (_tenantOptions.Count > 0)
                {
                    <select id="login-tenant" data-testid="login-tenant" class="form-control" value="@TenantId" @onchange="ChangeTenant">
                        <option value="0">@L10n.T(Keys.Login.TenantPlaceholder, "-- 请选择租户 --")</option>
                        @foreach (var tenant in _tenantOptions) { <option value="@TenantValue(tenant)">@TenantLabel(tenant)</option> }
                    </select>
                }
                else
                {
                    <input id="login-tenant-code" data-testid="login-tenant-code" class="form-control" @bind="_manualTenantCode" placeholder="@L10n.T("Login.TenantCodePlaceholder", "如 demo / tenant-001")" autocomplete="off" />
                    <span class="muted tiny">@L10n.T("Login.TenantCodeHint", "租户目录未公开，请输入您已知的确切租户编码登录。")</span>
                }
                </label>
                @if (!string.IsNullOrWhiteSpace(_tenantDirectoryError))
                {
                    <div class="alert alert-warning">@_tenantDirectoryError</div>
                }
                <button id="login-submit" data-testid="login-submit" class="btn btn-primary" @onclick="DoLogin" disabled="@Busy">@L10n.T("Common.Login")</button>
                @if (!string.IsNullOrEmpty(Error)) { <div id="login-error" data-testid="login-error" class="alert alert-danger" role="alert">@Error</div> }
                <p class="muted tiny">@L10n.T(Keys.Content.LoginPasswordNotice, "P0-04A 起登录校验口令：未设置口令的账户需先由管理员初始化。令牌携带安全戳，口令/角色变更后旧令牌立即失效。")</p>
                <p class="muted tiny"><a href="/register">@L10n.T(Keys.Login.NoTenantRegister, "还没有租户？申请开通")</a></p>
                <p class="muted tiny"><a href="/admin/login">@L10n.T(Keys.PlatformLogin.Title, "平台运营登录")</a></p>
            </div>
        }
    </section>
</div>

@code {
    private string Username = "";
    private string Password = "";
    private long TenantId;
    private bool Busy = false;
    private string Error = "";
    private bool BootstrapChecking = true;
    private bool BootstrapRequired;
    private bool BootstrapAnonymousAllowed = true;
    private string BootstrapUsername = "platform-admin";
    private string BootstrapDisplayName = "";

    protected override void OnInitialized()
    {
        BootstrapDisplayName = L10n.T(Keys.Content.LoginBootstrapDisplayName, "平台系统管理员");
    }
    private string BootstrapEmail = "";
    private string BootstrapPassword = "";
    private string BootstrapPasswordConfirm = "";
    private List<string> _loginCultures = new();
    private List<System.Text.Json.JsonElement> _tenantOptions = new();
    /// <summary>目录未公开时的手动租户编码兜底（M0-08 + M6 登录修复）。</summary>
    private string _manualTenantCode = "";
    private string _tenantDirectoryError = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var (languages, _, _, _) = await Api.GetJsonAsync("api/localization/public/languages");
        if (languages is { ValueKind: System.Text.Json.JsonValueKind.Array }) _loginCultures = languages.Value.EnumerateArray().Select(x => x.GetProperty("culture").GetString() ?? "").Where(x => x.Length > 0).ToList();
        await L10n.InitializeAsync(0, 0, _loginCultures, L10n.CurrentCulture);
        var (tenants, _, tenantError, _) = await Api.GetJsonAsync("api/auth/login-options");
        if (tenants is { ValueKind: System.Text.Json.JsonValueKind.Array }) _tenantOptions = tenants.Value.EnumerateArray().ToList();
        else if (!string.IsNullOrWhiteSpace(tenantError))
            _tenantDirectoryError = $"{L10n.T(Keys.Login.TenantDirectoryLoadFailed, "租户列表加载失败，请检查 API 服务与地址配置。")} {tenantError}";
        if (_tenantOptions.Count > 0)
        {
            long savedTenant = 0;
            try { long.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem", "sb_last_login_tenant"), out savedTenant); } catch { }
            TenantId = _tenantOptions.Any(x => TenantValue(x) == savedTenant) ? savedTenant : TenantValue(_tenantOptions[0]);
            await ApplyTenantLanguage();
        }
        await RefreshBootstrapStatus();
        BootstrapChecking = false;
        StateHasChanged();
    }

    private async Task ChangeTenant(ChangeEventArgs e)
    {
        long.TryParse(e.Value?.ToString(), out TenantId);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "sb_last_login_tenant", TenantId.ToString()); } catch { }
        await ApplyTenantLanguage();
    }

    private async Task ApplyTenantLanguage()
    {
        var tenant = _tenantOptions.FirstOrDefault(x => TenantValue(x) == TenantId);
        if (tenant.ValueKind == System.Text.Json.JsonValueKind.Undefined) return;
        var cultures = tenant.TryGetProperty("availableCultures", out var values) && values.ValueKind == System.Text.Json.JsonValueKind.Array ? values.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x.Length > 0).ToList() : new List<string> { "zh-CN" };
        var defaultCulture = tenant.TryGetProperty("defaultCulture", out var value) ? value.GetString() : cultures[0];
        _loginCultures = cultures;
        await L10n.InitializeAsync(TenantId, 0, cultures, defaultCulture);
        StateHasChanged();
    }

    private static long TenantValue(System.Text.Json.JsonElement tenant) => tenant.TryGetProperty("id", out var id) ? id.GetInt64() : 0;
    private static string TenantLabel(System.Text.Json.JsonElement tenant) { var name=tenant.TryGetProperty("name",out var n)?n.GetString():""; var code=tenant.TryGetProperty("tenantCode",out var c)?c.GetString():""; return $"{name}（{code}）"; }

    private async Task ChangeLoginCulture(string culture)
    {
        await L10n.SetCultureAsync(0, 0, culture);
        StateHasChanged();
    }

    private async Task RefreshBootstrapStatus()
    {
        var (data, _, err, _) = await Api.GetJsonAsync("api/platform-bootstrap/status");
        if (data is not { ValueKind: System.Text.Json.JsonValueKind.Object })
        {
            Error = err ?? L10n.T(Keys.Login.InitStatusError, "无法读取平台初始化状态。");
            return;
        }
        BootstrapRequired = data.Value.TryGetProperty("required", out var required) && required.GetBoolean();
        BootstrapAnonymousAllowed = !data.Value.TryGetProperty("anonymousAllowed", out var anon) || anon.GetBoolean();
        if (BootstrapRequired && data.Value.TryGetProperty("platformTenantId", out var tenant) && tenant.TryGetInt64(out var id))
            TenantId = id;
    }

    private async Task InitializePlatform()
    {
        Error = "";
        if (string.IsNullOrWhiteSpace(BootstrapUsername)) { Error = L10n.T(Keys.Login.AdminUsernameRequired, "管理员用户名必填。"); return; }
        if (string.IsNullOrWhiteSpace(BootstrapEmail) || !BootstrapEmail.Contains('@')) { Error = L10n.T(Keys.Login.AdminEmailInvalid, "请输入有效的管理员邮箱。"); return; }
        if (BootstrapPassword.Length < 8) { Error = L10n.T(Keys.Login.AdminPasswordTooShort, "管理员口令至少 8 位。"); return; }
        if (BootstrapPassword != BootstrapPasswordConfirm) { Error = L10n.T(Keys.Login.AdminPasswordMismatch, "两次输入的口令不一致。"); return; }
        Busy = true;
        var (ok, _, err, _) = await Api.PostAsync("api/platform-bootstrap", new
        {
            username = BootstrapUsername,
            password = BootstrapPassword,
            displayName = BootstrapDisplayName,
            email = BootstrapEmail,
            confirmPassword = BootstrapPasswordConfirm,
        });
        Busy = false;
        // 失败时保留已输入内容，仅提示错误，便于用户修正。
        if (!ok) { Error = err ?? L10n.T(Keys.Login.InitFailed, "平台管理员初始化失败。"); return; }
        Username = BootstrapUsername;
        Password = BootstrapPassword;
        await RefreshBootstrapStatus();
        Error = "";
    }

    private async Task DoLogin()
    {
        if (TenantId <= 0)
        {
            // M0-08 + M6：目录未公开时，允许以手动编码兜底解析租户后再登录（不枚举目录）。
            if (_tenantOptions.Count == 0 && !string.IsNullOrWhiteSpace(_manualTenantCode))
            {
                Busy = true;
                var (id, _, _, resolveErr) = await Api.ResolveTenantByCodeAsync(_manualTenantCode);
                if (id <= 0)
                {
                    Busy = false;
                    Error = resolveErr ?? L10n.T("Login.TenantCodeInvalid", "租户编码不存在或已停用。");
                    return;
                }
                TenantId = id;
                try { await JS.InvokeVoidAsync("localStorage.setItem", "sb_last_login_tenant", TenantId.ToString()); } catch { }
            }
            else
            {
                Error = L10n.T(Keys.Login.SelectTenantFirst, "请先选择租户。");
                return;
            }
        }
        Busy = true; Error = "";
        var (r, loginErr, _) = await Api.LoginAsync(Username, TenantId, Password);
        Busy = false;
        if (r is null || string.IsNullOrEmpty(r.Token))
        {
            Error = loginErr ?? L10n.T(Keys.Login.LoginFailed, "登录失败：用户不存在或已禁用。");
            return;
        }
        // 写入 AppState 并持久化到 localStorage（刷新不掉登录）
        await Session.SetFromLoginAsync(r);
        await L10n.InitializeAsync(r.TenantId, r.UserId, r.AvailableCultures, r.DefaultCulture);
        Nav.NavigateTo("/ask");
    }

    private async Task Logout()
    {
        await Session.ClearAsync();
        StateHasChanged();
    }
}
