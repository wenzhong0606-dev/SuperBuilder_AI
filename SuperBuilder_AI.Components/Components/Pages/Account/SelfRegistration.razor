@page "/register"
@layout BlankLayout
@inject IApiClient Api
@inject AppState State
@inject AuthStore Session
@inject NavigationManager Nav
@inject LocalizationService L10n
@inject IJSRuntime JS
@inject ILoginCompletion LoginCompletion

<div class="login-wrap">
    <section class="login-hero">
        <h1>SuperBuilder AI</h1>
        <p class="sub">@L10n.T("Login.Tagline")</p>
        <div class="tags">
            <span>AI Native BI</span>
            <span>@L10n.T(Keys.Content.SelfRegistrationTagMultiTenant, "多租户")</span>
            <span>@L10n.T(Keys.Content.SelfRegistrationTagLowCode, "低代码")</span>
            <span>@L10n.T(Keys.Content.SelfRegistrationTagSaas, "企业级 SaaS")</span>
        </div>
    </section>

    <section class="login-form">
        @if (Checking)
        {
            <div class="card"><LoadingState Text="@L10n.T(Keys.Content.SelfRegistrationChecking, "正在检查注册通道状态…")" /></div>
        }
        else if (!Enabled)
        {
            <div class="card">
                <h2 style="margin:0 0 4px;">@L10n.T(Keys.Content.SelfRegistrationClosedTitle, "注册通道未开放")</h2>
                <p class="muted tiny">@L10n.T(Keys.Content.SelfRegistrationClosedDesc, "当前平台未开放自助注册。如需开通租户，请联系平台管理员。")</p>
                <a class="btn btn-outline-secondary" href="/login">@L10n.T(Keys.Content.SelfRegistrationBackToLogin, "返回登录")</a>
            </div>
        }
        else if (State.IsAuthenticated)
        {
            <div class="card">
                <p class="ok">@string.Format(L10n.T(Keys.Content.SelfRegistrationAlreadyLoggedIn, "当前已登录：{0}（租户 {1}）"), State.Username, State.TenantId)</p>
                <a class="btn btn-outline-secondary" href="/ask">@L10n.T(Keys.Content.SelfRegistrationEnterWorkspace, "进入工作台")</a>
            </div>
        }
        else
        {
            <div class="card">
                <h2 style="margin:0 0 4px;">@L10n.T(Keys.Content.SelfRegistrationApplyTitle, "申请开通新租户")</h2>
                <p class="muted tiny">@L10n.T(Keys.Content.SelfRegistrationApplyDesc, "填写以下信息创建您的专属租户与首位管理员账户。")</p>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelTenantCode, "租户编码（小写字母/数字，创建后不可变更）")
                    <input class="form-control" @bind="TenantCode" placeholder="@L10n.T(Keys.Content.SelfRegistrationLabelTenantCode, "租户编码")" />
                </label>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelTenantName, "租户名称")
                    <input class="form-control" @bind="TenantName" placeholder="@L10n.T(Keys.Content.SelfRegistrationPhTenantName, "例如 Acme 科技")" />
                </label>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelAdminUsername, "管理员用户名")
                    <input class="form-control" @bind="AdminUsername" placeholder="@L10n.T(Keys.Content.SelfRegistrationLabelAdminUsername, "管理员用户名")" />
                </label>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelAdminEmail, "管理员邮箱")
                    <input class="form-control" @bind="AdminEmail" placeholder="admin@example.com" />
                </label>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelAdminPassword, "管理员口令")
                    <input class="form-control" @bind="AdminPassword" type="password" placeholder="@L10n.T(Keys.Content.SelfRegistrationPhPassword, "至少 8 位")" />
                </label>
                <label>@L10n.T(Keys.Content.SelfRegistrationLabelConfirmPassword, "确认口令")
                    <input class="form-control" @bind="AdminPasswordConfirm" type="password" placeholder="@L10n.T(Keys.Content.SelfRegistrationPhConfirmPassword, "再次输入口令")" />
                </label>
                <button class="btn btn-primary" @onclick="DoRegister" disabled="@Busy">@L10n.T(Keys.Content.SelfRegistrationSubmit, "创建租户并登录")</button>
                @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }
                <p class="muted tiny"><a href="/login">@L10n.T(Keys.Content.SelfRegistrationHasAccount, "已有账户？返回登录")</a></p>
            </div>
        }
    </section>
</div>

@code {
    private bool Checking = true;
    private bool Enabled;
    private bool Busy;
    private string Error = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AdminUsername = "";
    private string AdminEmail = "";
    private string AdminPassword = "";
    private string AdminPasswordConfirm = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (State.IsAuthenticated)
        {
            Checking = false;
            StateHasChanged();
            return;
        }
        var (data, _, _, _) = await Api.GetJsonAsync("api/self-registration/status");
        Enabled = data is { ValueKind: System.Text.Json.JsonValueKind.Object }
                  && data.Value.TryGetProperty("enabled", out var e) && e.GetBoolean();
        Checking = false;
        StateHasChanged();
    }

    private async Task DoRegister()
    {
        Error = "";
        if (string.IsNullOrWhiteSpace(TenantCode) || string.IsNullOrWhiteSpace(TenantName))
        { Error = L10n.T(Keys.Content.SelfRegistrationErrCodeNameRequired, "租户编码与名称均必填。"); return; }
        if (string.IsNullOrWhiteSpace(AdminUsername) || string.IsNullOrWhiteSpace(AdminEmail) || !AdminEmail.Contains('@'))
        { Error = L10n.T(Keys.Content.SelfRegistrationErrAdminRequired, "管理员用户名与合法邮箱均必填。"); return; }
        if (AdminPassword.Length < 8)
        { Error = L10n.T(Keys.Content.SelfRegistrationErrPasswordLen, "管理员口令至少 8 位。"); return; }
        if (AdminPassword != AdminPasswordConfirm)
        { Error = L10n.T(Keys.Content.SelfRegistrationErrPasswordMismatch, "两次输入的口令不一致。"); return; }

        Busy = true;
        var (r, err, _) = await Api.RegisterSelfAsync(TenantCode.Trim(), TenantName.Trim(), AdminUsername.Trim(), AdminEmail.Trim(), AdminPassword, AdminUsername.Trim());
        Busy = false;

        if (r is null || !r.Success || string.IsNullOrEmpty(r.Token))
        {
            // 开关被关闭或待裁决特性开启会返回明确错误；其余视为注册失败。
            Error = err ?? r?.Error ?? L10n.T(Keys.Content.SelfRegistrationErrFailed, "注册失败，请稍后重试。");
            if (r?.Status == "disabled") Enabled = false;
            StateHasChanged();
            return;
        }

        // 注册即登录：构造 AuthResult 写入会话态（新租户即为主租户）。
        var login = new AuthResult
        {
            Token = r.Token,
            ExpiresInSeconds = r.ExpiresInSeconds,
            TenantId = r.TenantId,
            HomeTenantId = r.TenantId,
            UserId = r.UserId,
            Username = r.Username ?? AdminUsername,
            Permissions = r.Permissions ?? new System.Collections.Generic.List<string>(),
            AvailableCultures = r.AvailableCultures ?? new System.Collections.Generic.List<string> { "zh-CN" },
            DefaultCulture = r.DefaultCulture ?? "zh-CN",
        };
        await Session.SetFromLoginAsync(login);
        await L10n.InitializeAsync(r.TenantId, r.UserId, login.AvailableCultures, login.DefaultCulture);
        await LoginCompletion.CompleteLoginAsync(login, "/ask");
    }
}
