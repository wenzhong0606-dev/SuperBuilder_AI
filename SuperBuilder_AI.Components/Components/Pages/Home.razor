@page "/"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@using System.Text.Json

@* 工作台首页：会话自举完成前不判定登录态 *@
<AuthGuard AutoRedirect="true">
    <PageHead Icon="sb-ico-home" Key="Home" Title="工作台" Desc="从一次提问开始，把分析沉淀为仪表盘与应用，并在团队内复用。">
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>
            <svg class="btn-ico"><use href="#sb-ico-ask" /></svg> 开始提问
        </button>
    </PageHead>

    <div class="stat-grid">
        <SbStatTile Label="仪表盘" Value="@_dashboards" Sub="可复用看板" Accent="info" />
        <SbStatTile Label="应用" Value="@_apps" Sub="已发布的分析应用" Accent="success" />
        <SbStatTile Label="语义标签" Value="@_labels" Sub="业务口径映射" Accent="warning" />
        <SbStatTile Label="智能体计划" Value="@_plans" Sub="Copilot 编排" />
    </div>

    <div class="card-grid">
        <a class="feature-card" href="ask">
            <div class="fc-ico"><svg><use href="#sb-ico-ask" /></svg></div>
            <div class="fc-title">Ask BI 智能问数</div>
            <div class="fc-desc">用自然语言提问，自动完成语义解析、查询计划、SQL 生成与结果解读。</div>
        </a>
        <a class="feature-card" href="dashboards">
            <div class="fc-ico"><svg><use href="#sb-ico-dash" /></svg></div>
            <div class="fc-title">仪表盘</div>
            <div class="fc-desc">把一次分析固化为看板，支持图表组合、共享与定时刷新。</div>
        </a>
        <a class="feature-card" href="apps">
            <div class="fc-ico"><svg><use href="#sb-ico-app" /></svg></div>
            <div class="fc-title">应用工厂</div>
            <div class="fc-desc">以 App DSL 描述页面与组件，一键生成可分发的轻量分析应用。</div>
        </a>
        <a class="feature-card" href="data-sources">
            <div class="fc-ico"><svg><use href="#sb-ico-db" /></svg></div>
            <div class="fc-title">数据源与授权</div>
            <div class="fc-desc">登记业务库、配置访问授权与行级安全策略，控制可取数范围。</div>
        </a>
    </div>

    <SbPanel Icon="sb-ico-activity" Title="快速开始">
        <Body>
            <ol class="sb-steps">
                <li>在「数据源管理」登记业务库并完成连接测试。</li>
                <li>在「语义模型 / 语义标签」补齐业务口径，让 AI 听得懂行话。</li>
                <li>进入「Ask BI 智能问数」提问，检查结果与生成的 SQL。</li>
                <li>把满意的结果一键发布为仪表盘或应用。</li>
            </ol>
        </Body>
    </SbPanel>
</AuthGuard>

@code {
    private int _dashboards = 0;
    private int _apps = 0;
    private int _labels = 0;
    private int _plans = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!State.IsAuthenticated) return;

        _dashboards = await CountOf($"api/dashboards?tenantId={State.TenantId}");
        _apps = await CountOf($"api/apps?tenantId={State.TenantId}");
        _labels = await CountOf($"api/semantic-labels?tenantId={State.TenantId}");
        _plans = await CountOf($"api/agent/plans?tenantId={State.TenantId}");
        StateHasChanged();
    }

    /// <summary>安全计数：端点不可用或返回非数组时返回 0（首页不因统计失败而报错）。</summary>
    private async Task<int> CountOf(string url)
    {
        try
        {
            var (data, _, _) = await Api.GetJsonAsync(url);
            if (data is { ValueKind: JsonValueKind.Array }) return data.Value.GetArrayLength();
            if (data is { ValueKind: JsonValueKind.Object } && data.Value.TryGetProperty("items", out var items)
                && items.ValueKind == JsonValueKind.Array)
                return items.GetArrayLength();
            return 0;
        }
        catch
        {
            return 0;
        }
    }
}
