@page "/"
@inject IApiClient Api
@inject AppState State
@inject NavigationManager Nav
@using System.Text.Json

@* 工作台首页：会话自举完成前不判定登录态 *@
<AuthGuard AutoRedirect="true">
    <PageHead Icon="sb-ico-home" Key="Home" Title="工作台" Desc="从一次提问开始，把分析沉淀为仪表盘与应用，并在团队内复用。">
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("ask")'>
            <svg class="btn-ico"><use href="#sb-ico-ask" /></svg> @L10n.T(Keys.Content.HomeStartAsk, "开始提问")
        </button>
    </PageHead>

    <div class="stat-grid">
        <SbStatTile Label="@L10n.T(Keys.Content.HomeStatDashboards, "仪表盘")" Value="@_dashboards" Sub="@L10n.T(Keys.Content.HomeStatDashboardsSub, "可复用看板")" Accent="info" />
        <SbStatTile Label="@L10n.T(Keys.Content.HomeStatApps, "应用")" Value="@_apps" Sub="@L10n.T(Keys.Content.HomeStatAppsSub, "已发布的分析应用")" Accent="success" />
        <SbStatTile Label="@L10n.T(Keys.Content.HomeStatLabels, "语义标签")" Value="@_labels" Sub="@L10n.T(Keys.Content.HomeStatLabelsSub, "业务口径映射")" Accent="warning" />
        <SbStatTile Label="@L10n.T(Keys.Content.HomeStatPlans, "智能体计划")" Value="@_plans" Sub="@L10n.T(Keys.Content.HomeStatPlansSub, "Copilot 编排")" />
    </div>

    <div class="card-grid">
        <a class="feature-card" href="ask">
            <div class="fc-ico"><svg><use href="#sb-ico-ask" /></svg></div>
            <div class="<div class="fc-title">@L10n.T(Keys.Content.HomeCardAskTitle, "Ask BI 智能问数")</div>
            <div class="<div class="fc-desc">@L10n.T(Keys.Content.HomeCardAskDesc, "用自然语言提问，自动完成语义解析、查询计划、SQL 生成与结果解读。")</div>
        </a>
        <a class="feature-card" href="dashboards">
            <div class="fc-ico"><svg><use href="#sb-ico-dash" /></svg></div>
            <div class="<div class="fc-title">@L10n.T(Keys.Content.HomeCardDashboardsTitle, "仪表盘")</div>
            <div class="<div class="fc-desc">@L10n.T(Keys.Content.HomeCardDashboardsDesc, "把一次分析固化为看板，支持图表组合、共享与定时刷新。")</div>
        </a>
        <a class="feature-card" href="apps">
            <div class="fc-ico"><svg><use href="#sb-ico-app" /></svg></div>
            <div class="<div class="fc-title">@L10n.T(Keys.Content.HomeCardAppsTitle, "应用工厂")</div>
            <div class="<div class="fc-desc">@L10n.T(Keys.Content.HomeCardAppsDesc, "以 App DSL 描述页面与组件，一键生成可分发的轻量分析应用。")</div>
        </a>
        <a class="feature-card" href="data-sources">
            <div class="fc-ico"><svg><use href="#sb-ico-db" /></svg></div>
            <div class="<div class="fc-title">@L10n.T(Keys.Content.HomeCardDataSourcesTitle, "数据源与授权")</div>
            <div class="<div class="fc-desc">@L10n.T(Keys.Content.HomeCardDataSourcesDesc, "登记业务库、配置访问授权与行级安全策略，控制可取数范围。")</div>
        </a>
    </div>

    <OnboardingChecklist />
</AuthGuard>

@code {
    private int _dashboards = 0;
    private int _apps = 0;
    private int _labels = 0;
    private int _plans = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!State.IsAuthenticated) return;

        _dashboards = await CountOf($"api/dashboards?tenantId={State.TenantId}");
        _apps = await CountOf($"api/apps?tenantId={State.TenantId}");
        _labels = await CountOf($"api/semantic-labels?tenantId={State.TenantId}");
        _plans = await CountOf($"api/agent/plans?tenantId={State.TenantId}");
        StateHasChanged();
    }

    /// <summary>安全计数：端点不可用或返回非数组时返回 0（首页不因统计失败而报错）。</summary>
    private async Task<int> CountOf(string url)
    {
        try
        {
            var (data, _, _, _) = await Api.GetJsonAsync(url);
            if (data is { ValueKind: JsonValueKind.Array }) return data.Value.GetArrayLength();
            if (data is { ValueKind: JsonValueKind.Object } && data.Value.TryGetProperty("items", out var items)
                && items.ValueKind == JsonValueKind.Array)
                return items.GetArrayLength();
            return 0;
        }
        catch
        {
            return 0;
        }
    }
}
