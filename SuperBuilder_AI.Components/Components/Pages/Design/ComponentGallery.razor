@page "/components"
@inject IApiClient Api
@inject AppState State
@inject ToastService Toast
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions

<PageHead Icon="sb-ico-comp" Key="ComponentGallery" Title="组件库" Desc="以安全的结构化 DSL 创建、发布和复用租户组件。" />

<AuthGuard>
    <PermissionGuard Require="@(new[] { PermissionCodes.AppView })">
        <div class="toolbar">
            <div>
                <div class="panel-title"><svg class="pt-ico"><use href="#sb-ico-comp" /></svg> @L10n.T(Keys.Content.ComponentLibraryAssets, "组件资产")</div>
                <div class="tiny muted">@L10n.T(Keys.Content.ComponentLibraryLifecycleHint, "草稿与发布态隔离；回滚会创建新版本，不覆盖历史。")</div>
            </div>
            <div class="spacer"></div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync" disabled="@_loading">@L10n.T(Keys.Action.Refresh, "刷新")</button>
            <PermissionGuard Require="@(new[] { PermissionCodes.AppCreate })">
                <button class="btn btn-primary btn-sm" @onclick="OpenCreate" disabled="@(_loading || string.IsNullOrWhiteSpace(_blueprint))">@L10n.T(Keys.Content.ComponentLibraryNew, "新增组件")</button>
            </PermissionGuard>
        </div>

        @if (_loading)
        {
            <LoadingState Text="@L10n.T(Keys.Common.Loading, "加载中…")" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_items.Count == 0)
        {
            <SbEmptyState Icon="sb-ico-comp" Title="@L10n.T(Keys.Content.ComponentLibraryEmptyTitle, "暂无自定义组件")" Text="@L10n.T(Keys.Content.ComponentLibraryEmptyText, "创建第一个组件，发布后即可被应用和仪表盘安全复用。")" />
        }
        else
        {
            <div class="panel component-library-panel">
                <div class="panel-body flush">
                    <div class="table-wrap">
                        <table class="data-table component-library-table">
                            <thead><tr><th>@L10n.T(Keys.Content.ComponentGalleryColName, "名称")</th><th>@L10n.T(Keys.Content.ComponentGalleryColCode, "编码")</th><th>@L10n.T(Keys.Content.ComponentLibraryType, "类型")</th><th>@L10n.T(Keys.Content.ComponentGalleryColStatus, "状态")</th><th>@L10n.T(Keys.Content.ComponentLibraryVersion, "发布版本")</th><th>@L10n.T(Keys.Content.ComponentLibraryPublishedAt, "发布时间")</th><th class="text-end">@L10n.T(Keys.Content.ComponentLibraryActions, "操作")</th></tr></thead>
                            <tbody>
                                @foreach (var row in _items)
                                {
                                    <tr>
                                        <td><div class="cell-title">@row.Name</div><div class="tiny muted">@row.Description</div></td>
                                        <td><code>@row.Key</code></td>
                                        <td><span class="badge badge-info">@row.ComponentType</span></td>
                                        <td>@if (row.PublishedVersion > 0) { <span class="badge badge-success">@L10n.T(Keys.Content.ComponentGalleryBadgePublished, "已发布")</span> } else { <span class="badge badge-warning">@L10n.T(Keys.Content.ComponentGalleryBadgeDraft, "草稿")</span> }</td>
                                        <td>@(row.PublishedVersion > 0 ? $"v{row.PublishedVersion}" : "—")</td>
                                        <td>@FormatDate(row.PublishedAt)</td>
                                        <td><div class="row-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenPreviewAsync(row)">@L10n.T(Keys.Content.ComponentLibraryPreview, "预览")</button>
                                            <button class="btn btn-ghost btn-sm" @onclick="() => OpenVersionsAsync(row)">@L10n.T(Keys.Content.ComponentLibraryVersions, "版本")</button>
                                            <PermissionGuard Require="@(new[] { PermissionCodes.AppEdit })"><button class="btn btn-ghost btn-sm" @onclick="() => OpenEditAsync(row)">@L10n.T(Keys.Action.Edit, "编辑")</button></PermissionGuard>
                                            <PermissionGuard Require="@(new[] { PermissionCodes.AppPublish })"><button class="btn btn-outline-primary btn-sm" @onclick="() => PublishAsync(row)" disabled="@_working">@L10n.T(Keys.Content.ComponentLibraryPublish, "发布")</button></PermissionGuard>
                                            <PermissionGuard Require="@(new[] { PermissionCodes.AppDelete })"><button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDelete(row)">@L10n.T(Keys.Action.Delete, "删除")</button></PermissionGuard>
                                        </div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <SbModal Visible="@_editorVisible" VisibleChanged="v => _editorVisible = v" Title="@(_editingKey is null ? L10n.T(Keys.Content.ComponentLibraryNew, "新增组件") : L10n.T(Keys.Content.ComponentLibraryEditTitle, "编辑组件"))" Size="lg">
            <Body>
                <div class="field-grid">
                    <SbField Label="@L10n.T(Keys.Content.ComponentLibraryKey, "组件键")" Required="true" Hint="@L10n.T(Keys.Content.ComponentLibraryKeyHint, "小写字母开头，仅允许小写字母、数字和连字符；创建后不可修改。")"><input @bind="_formKey" disabled="@(_editingKey is not null)" placeholder="inventory-card" /></SbField>
                    <SbField Label="@L10n.T(Keys.Content.ComponentGalleryColName, "名称")" Required="true"><input @bind="_formName" /></SbField>
                    <SbField Label="@L10n.T(Keys.Content.ComponentLibraryType, "类型")" Required="true"><select @bind="_formType">@foreach (var type in _types) { <option value="@type">@type</option> }</select></SbField>
                    <SbField Label="@L10n.T(Keys.Content.ComponentLibraryDescription, "描述")"><input @bind="_formDescription" /></SbField>
                    <SbField Label="@L10n.T(Keys.Content.ComponentLibraryDsl, "结构化 DSL")" Full="true" Hint="@L10n.T(Keys.Content.ComponentLibraryDslHint, "仅支持白名单结构，不接受 HTML、CSS 或 JavaScript。")"><textarea @bind="_dslJson" rows="14" class="dsl-editor" spellcheck="false"></textarea></SbField>
                </div>
                @if (!string.IsNullOrWhiteSpace(_editorError)) { <div class="alert alert-danger tiny">@_editorError</div> }
            </Body>
            <Footer><button class="btn btn-outline-secondary" @onclick="() => _editorVisible = false">@L10n.T(Keys.Action.Cancel, "取消")</button><button class="btn btn-primary" @onclick="SaveAsync" disabled="@_working">@(_working ? L10n.T(Keys.Content.ComponentLibrarySaving, "保存中…") : L10n.T(Keys.Action.Save, "保存"))</button></Footer>
        </SbModal>

        <SbModal Visible="@_previewVisible" VisibleChanged="v => _previewVisible = v" Title="@L10n.T(Keys.Content.ComponentLibraryPreviewTitle, "已发布组件预览")" Size="lg">
            <Body>@if (_previewLoading) { <LoadingState Text="@L10n.T(Keys.Common.Loading, "加载中…")" /> } else if (!string.IsNullOrWhiteSpace(_previewError)) { <div class="alert alert-warning">@_previewError</div> } else { <pre class="safe-preview">@_previewJson</pre> }</Body>
        </SbModal>

        <SbModal Visible="@_versionsVisible" VisibleChanged="v => _versionsVisible = v" Title="@L10n.T(Keys.Content.ComponentLibraryVersionHistory, "发布版本历史")" Size="md">
            <Body>
                @if (_versionsLoading) { <LoadingState Text="@L10n.T(Keys.Common.Loading, "加载中…")" /> }
                else if (_versions.Count == 0) { <div class="muted">@L10n.T(Keys.Content.ComponentLibraryNoVersions, "该组件尚未发布。")</div> }
                else { <div class="version-list">@foreach (var version in _versions) { <div class="version-row"><div><strong>v@version.Version</strong> @if (version.IsCurrent) { <span class="badge badge-success">@L10n.T(Keys.Content.ComponentLibraryCurrent, "当前")</span> } @if (version.RolledBackFromVersion is not null) { <span class="tiny muted">← v@version.RolledBackFromVersion</span> }<div class="tiny muted">@FormatDate(version.PublishedAt) · @version.PublishedBy</div></div>@if (!version.IsCurrent) { <PermissionGuard Require="@(new[] { PermissionCodes.AppPublish })"><button class="btn btn-outline-secondary btn-sm" @onclick="() => RollbackAsync(version.Version)" disabled="@_working">@L10n.T(Keys.Content.ComponentLibraryRollback, "回滚至此版本")</button></PermissionGuard> }</div> }</div> }
            </Body>
        </SbModal>

        <SbConfirm Visible="@_deleteVisible" VisibleChanged="v => _deleteVisible = v" Title="@L10n.T(Keys.Content.ComponentGalleryConfirmTitle, "删除确认")" Message="@L10n.T(Keys.Content.ComponentLibraryDeleteConfirm, "删除组件将同时删除其全部版本，确定继续吗？")" ConfirmText="@L10n.T(Keys.Action.Delete, "删除")" Tone="danger" OnConfirm="DeleteAsync" />
    </PermissionGuard>
</AuthGuard>

<style>
    .component-library-panel { margin-top: 12px; overflow: hidden; }
    .component-library-table { width: 100%; min-width: 1040px; }
    .component-library-table td:last-child { width: 1%; white-space: nowrap; }
    .cell-title { font-weight: 700; color: var(--sb-text); }
    .row-actions { display: flex; justify-content: flex-end; gap: 6px; align-items: center; }
    .dsl-editor, .safe-preview { width: 100%; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12px; line-height: 1.55; }
    .safe-preview { max-height: 520px; overflow: auto; padding: 16px; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); background: color-mix(in srgb, var(--sb-bg) 88%, var(--sb-primary) 12%); white-space: pre-wrap; word-break: break-word; }
    .version-list { display: grid; gap: 8px; }
    .version-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-md); }
</style>

@code {
    private sealed record ComponentItem(long Id, string Key, string Name, string? Description, string ComponentType, int PublishedVersion, DateTime? PublishedAt);
    private sealed record VersionItem(int Version, DateTime PublishedAt, string? PublishedBy, int? RolledBackFromVersion, bool IsCurrent);
    private readonly List<ComponentItem> _items = new();
    private readonly List<string> _types = new();
    private readonly List<VersionItem> _versions = new();
    private bool _loading = true, _working, _editorVisible, _previewVisible, _previewLoading, _versionsVisible, _versionsLoading, _deleteVisible;
    private string? _error, _blueprint, _editingKey, _selectedKey, _editorError, _previewError, _previewJson;
    private string _formKey = "", _formName = "", _formDescription = "", _formType = "chart", _dslJson = "";

    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; await LoadBlueprintAsync(); await LoadAsync(); StateHasChanged(); }
    private async Task LoadBlueprintAsync() { var (data, _, _, _) = await Api.GetJsonAsync("api/components/editor/blueprint"); if (data is not { ValueKind: JsonValueKind.Object }) return; _blueprint = data.Value.GetProperty("skeleton").GetString(); _types.Clear(); if (data.Value.TryGetProperty("componentTypes", out var types)) _types.AddRange(types.EnumerateArray().Select(x => x.GetString()).Where(x => !string.IsNullOrWhiteSpace(x))!); }
    private async Task LoadAsync() { _loading = true; _error = null; var (data, _, err, code) = await Api.GetJsonAsync($"api/components?tenantId={State.TenantId}"); _items.Clear(); if (data is { ValueKind: JsonValueKind.Array }) { foreach (var e in data.Value.EnumerateArray()) _items.Add(new(e.GetProperty("id").GetInt64(), Text(e, "key"), Text(e, "name"), Optional(e, "description"), Text(e, "componentType"), e.GetProperty("publishedVersion").GetInt32(), Date(e, "publishedAt"))); } else if (!string.IsNullOrWhiteSpace(err)) _error = L10n.T(code is null ? "" : "Error." + code, err); _loading = false; }
    private void OpenCreate() { _editingKey = null; _editorError = null; _formKey = ""; _formName = ""; _formDescription = ""; _dslJson = _blueprint ?? ""; _formType = _types.FirstOrDefault() ?? "chart"; _editorVisible = true; }
    private async Task OpenEditAsync(ComponentItem row) { var (data, _, err, _) = await Api.GetJsonAsync($"api/components/{Uri.EscapeDataString(row.Key)}?tenantId={State.TenantId}"); if (data is not { ValueKind: JsonValueKind.Object }) { Toast.Error(err ?? L10n.T(Keys.Content.ComponentLibraryLoadFailed, "组件加载失败。")); return; } _editingKey = row.Key; _formKey = row.Key; _formName = Text(data.Value, "name"); _formDescription = Optional(data.Value, "description") ?? ""; _formType = Text(data.Value, "componentType"); _dslJson = Text(data.Value, "dslJson"); _editorError = null; _editorVisible = true; }
    private async Task SaveAsync() { _editorError = null; if (!Regex.IsMatch(_formKey, "^[a-z][a-z0-9-]{1,63}$") || string.IsNullOrWhiteSpace(_formName)) { _editorError = L10n.T(Keys.Content.ComponentLibraryInvalidForm, "请填写名称，并使用合法的组件键。"); return; } try { SyncDsl(); JsonNode.Parse(_dslJson); } catch (Exception ex) { _editorError = string.Format(L10n.T(Keys.Content.ComponentLibraryInvalidDsl, "DSL 无效：{0}"), ex.Message); return; } _working = true; var result = _editingKey is null ? await Api.PostAsync("api/components", new { tenantId = State.TenantId, dslJson = _dslJson }) : await Api.PutAsync($"api/components/{Uri.EscapeDataString(_editingKey)}?tenantId={State.TenantId}", new { tenantId = State.TenantId, dslJson = _dslJson }); _working = false; if (!result.Ok) { _editorError = result.Error ?? L10n.T(Keys.Content.ComponentLibrarySaveFailed, "组件保存失败。"); return; } _editorVisible = false; Toast.Success(L10n.T(Keys.Content.ComponentLibrarySaved, "组件已保存。")); await LoadAsync(); }
    private void SyncDsl() { var node = JsonNode.Parse(_dslJson)!.AsObject(); node["key"] = _formKey.Trim(); node["name"] = _formName.Trim(); node["description"] = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription.Trim(); var root = node["root"]!.AsObject(); root["type"] = _formType; root["title"] = _formName.Trim(); _dslJson = node.ToJsonString(new JsonSerializerOptions { WriteIndented = true }); }
    private async Task PublishAsync(ComponentItem row) { _working = true; var (ok, _, err, _) = await Api.PostAsync($"api/components/{Uri.EscapeDataString(row.Key)}/publish?tenantId={State.TenantId}"); _working = false; if (!ok) Toast.Error(err ?? L10n.T(Keys.Content.ComponentLibraryPublishFailed, "组件发布失败。")); else { Toast.Success(L10n.T(Keys.Content.ComponentLibraryPublished, "组件已发布。")); await LoadAsync(); } }
    private async Task OpenPreviewAsync(ComponentItem row) { _previewVisible = true; _previewLoading = true; _previewError = null; _previewJson = null; var (data, _, err, _) = await Api.GetJsonAsync($"api/components/{Uri.EscapeDataString(row.Key)}/render?tenantId={State.TenantId}"); if (data is null) _previewError = err ?? L10n.T(Keys.Content.ComponentLibraryUnpublished, "组件尚未发布，暂无运行时预览。"); else _previewJson = JsonSerializer.Serialize(data.Value, new JsonSerializerOptions { WriteIndented = true }); _previewLoading = false; }
    private async Task OpenVersionsAsync(ComponentItem row) { _selectedKey = row.Key; _versionsVisible = true; _versionsLoading = true; _versions.Clear(); var (data, _, err, _) = await Api.GetJsonAsync($"api/components/{Uri.EscapeDataString(row.Key)}/versions?tenantId={State.TenantId}"); if (data is { ValueKind: JsonValueKind.Array }) foreach (var e in data.Value.EnumerateArray()) _versions.Add(new(e.GetProperty("version").GetInt32(), Date(e, "publishedAt") ?? DateTime.MinValue, Optional(e, "publishedBy"), e.TryGetProperty("rolledBackFromVersion", out var rb) && rb.ValueKind == JsonValueKind.Number ? rb.GetInt32() : null, e.GetProperty("isCurrent").GetBoolean())); else if (!string.IsNullOrWhiteSpace(err)) Toast.Error(err); _versionsLoading = false; }
    private async Task RollbackAsync(int version) { if (string.IsNullOrWhiteSpace(_selectedKey)) return; _working = true; var (ok, _, err, _) = await Api.PostAsync($"api/components/{Uri.EscapeDataString(_selectedKey)}/rollback/{version}?tenantId={State.TenantId}"); _working = false; if (!ok) Toast.Error(err ?? L10n.T(Keys.Content.ComponentLibraryRollbackFailed, "组件回滚失败。")); else { Toast.Success(L10n.T(Keys.Content.ComponentLibraryRollbackDone, "已回滚并生成新的发布版本。")); var row = _items.First(x => x.Key == _selectedKey); await OpenVersionsAsync(row); await LoadAsync(); } }
    private void OpenDelete(ComponentItem row) { _selectedKey = row.Key; _deleteVisible = true; }
    private async Task DeleteAsync() { if (string.IsNullOrWhiteSpace(_selectedKey)) return; var (ok, _, err, _) = await Api.DeleteAsync($"api/components/{Uri.EscapeDataString(_selectedKey)}?tenantId={State.TenantId}"); _deleteVisible = false; if (!ok) Toast.Error(err ?? L10n.T(Keys.Content.ComponentLibraryDeleteFailed, "组件删除失败。")); else { Toast.Success(L10n.T(Keys.Content.ComponentLibraryDeleted, "组件已删除。")); await LoadAsync(); } }
    private static string Text(JsonElement e, string name) => e.TryGetProperty(name, out var p) ? p.GetString() ?? "" : "";
    private static string? Optional(JsonElement e, string name) => e.TryGetProperty(name, out var p) && p.ValueKind != JsonValueKind.Null ? p.GetString() : null;
    private static DateTime? Date(JsonElement e, string name) => e.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String && p.TryGetDateTime(out var dt) ? dt : null;
    private static string FormatDate(DateTime? date) => date is null ? "—" : date.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
