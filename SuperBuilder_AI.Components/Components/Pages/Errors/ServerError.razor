@page "/500"
@layout BlankLayout
@inject NavigationManager Nav

<div class="sb-error-page">
    <div class="sb-error-code">500</div>
    <h2>服务出现异常</h2>
    <p class="muted">请求处理过程中发生未预期的错误，请稍后重试；若持续出现，请联系管理员并提供追踪 ID。</p>
    <div class="sb-error-actions">
        <button class="btn btn-primary" @onclick="Reload">重新加载</button>
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("")'>返回工作台</button>
    </div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task Reload()
    {
        try { await JS.InvokeVoidAsync("location.reload"); }
        catch { Nav.NavigateTo("", forceLoad: true); }
    }
}
