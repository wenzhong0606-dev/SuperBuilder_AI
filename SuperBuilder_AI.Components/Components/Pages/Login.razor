@page "/"
@page "/login"
@inject IApiClient Api
@inject AppState State
@inject AuthStore Session
@inject NavigationManager Nav

<div class="login-wrap">
    <section class="login-hero">
        <h1>SuperBuilder AI</h1>
        <p class="sub">自然语言驱动的智能问数平台 —— 对话即分析，所见即洞察。</p>
        <div class="tags">
            <span>AI Native BI</span>
            <span>多租户</span>
            <span>多语言</span>
            <span>低代码</span>
            <span>企业级 SaaS</span>
        </div>
    </section>

    <section class="login-form">
        @if (State.IsAuthenticated)
        {
            <div class="card">
                <p class="ok">当前用户：@State.Username（租户 @State.TenantId，用户 @State.UserId）</p>
                <button class="btn btn-outline-secondary" @onclick="Logout">退出登录</button>
            </div>
        }
        else
        {
            <div class="card">
                <h2 style="margin:0 0 4px;">登录 / 租户选择</h2>
                <label>用户名<input class="form-control" @bind="Username" placeholder="例如 admin" /></label>
                <label>口令<input class="form-control" @bind="Password" type="password" placeholder="账户口令" /></label>
                <label>租户 ID<input class="form-control" @bind="TenantId" type="number" min="1" /></label>
                <button class="btn btn-primary" @onclick="DoLogin" disabled="@Busy">登录</button>
                @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }
                <p class="muted tiny">P0-04A 起登录校验口令：未设置口令的账户需先由管理员初始化。令牌携带安全戳，口令/角色变更后旧令牌立即失效。</p>
            </div>
        }
    </section>
</div>

@code {
    private string Username = "";
    private string Password = "";
    private long TenantId = 1;
    private bool Busy = false;
    private string Error = "";

    private async Task DoLogin()
    {
        Busy = true; Error = "";
        var (r, loginErr) = await Api.LoginAsync(Username, TenantId, Password);
        Busy = false;
        if (r is null || string.IsNullOrEmpty(r.Token))
        {
            Error = loginErr ?? "登录失败：用户不存在或已禁用。";
            return;
        }
        // 写入 AppState 并持久化到 localStorage（刷新不掉登录）
        await Session.SetFromLoginAsync(r);
        Nav.NavigateTo("/ask");
    }

    private async Task Logout()
    {
        await Session.ClearAsync();
        StateHasChanged();
    }
}
