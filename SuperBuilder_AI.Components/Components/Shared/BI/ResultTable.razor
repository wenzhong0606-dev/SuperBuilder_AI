@* 结果表格：任意「字段名→值」字典列表 → 友好表头 + 单元格（复用 TablePresenter） *@
@using SuperBuilder_AI.Components.Shared

@if (Rows is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>@foreach (var c in Columns) { <th>@TablePresenter.Friendly(c)</th> }</tr>
            </thead>
            <tbody>
                @foreach (var row in View)
                {
                    <tr>
                        @foreach (var c in Columns)
                        {
                            @if (TablePresenter.IsStatusColumn(c))
                            {
                                <td><span class="badge @TablePresenter.StatusBadge(JsonValue.AsString(row.GetValueOrDefault(c)))">@JsonValue.AsString(row.GetValueOrDefault(c))</span></td>
                            }
                            else
                            {
                                <td>@JsonValue.AsString(row.GetValueOrDefault(c))</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Rows.Count > PageSize)
    {
        <div class="sb-pager-wrap">
            <SbPagination Page="_page" PageSize="PageSize" TotalCount="Rows.Count"
                          PageChanged="EventCallback.Factory.Create<int>(this, p => _page = p)" />
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Footer))
    {
        <div class="muted tiny mt-2">@Footer</div>
    }
}
else
{
    <SbEmptyState Icon="sb-ico-db" Title="@L10n.T(Keys.Content.SharedNoDataTitle, "没有返回数据")" Text="@(string.IsNullOrWhiteSpace(EmptyText) ? L10n.T(Keys.Content.SharedNoDataText, "本次查询未返回任何行。") : EmptyText)" />
}

@code {
    [Parameter] public List<Dictionary<string, object?>>? Rows { get; set; }
    [Parameter] public string? Footer { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    /// <summary>单页行数上限（M8-04：10k 行不一次渲染全部 DOM，默认 100）。</summary>
    [Parameter] public int PageSize { get; set; } = 100;

    private int _page = 1;

    /// <summary>当前页切片；页码越界时自动夹紧，避免刷新后空页（M8-04）。</summary>
    private List<Dictionary<string, object?>> View
    {
        get
        {
            if (Rows is null) return new();
            var totalPages = PageSize <= 0 ? 1 : (int)Math.Ceiling(Rows.Count / (double)PageSize);
            var page = Math.Max(1, Math.Min(totalPages, _page));
            return Rows.Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    /// <summary>列顺序按首次出现顺序取并集。</summary>
    private List<string> Columns
    {
        get
        {
            var cols = new List<string>();
            foreach (var r in Rows ?? new())
                foreach (var k in r.Keys)
                    if (!cols.Contains(k)) cols.Add(k);
            return cols;
        }
    }
}
