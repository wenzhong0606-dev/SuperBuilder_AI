@inject LocalizationService L10n
@* 统一错误态：错误码 + 追踪 ID + 可选重试（对齐后端 ApiError） *@
<div class="alert alert-warning" role="alert">
    <div class="ask-error-msg">@L10n.Friendly(Code, Message ?? L10n.T(Keys.Error.OperationFailed, "操作失败。"))</div>
    @if (!string.IsNullOrWhiteSpace(Code) || !string.IsNullOrWhiteSpace(TraceId))
    {
        <div class="ask-error-meta">
            @if (!string.IsNullOrWhiteSpace(Code))
            {
                <text>@L10n.T(Keys.Error.CodeLabel, "错误码：")<code>@Code</code></text>
            }
            @if (!string.IsNullOrWhiteSpace(TraceId))
            {
                <text> · @L10n.T(Keys.Error.TraceIdLabel, "追踪 ID：")<code>@TraceId</code></text>
            }
        </div>
    }
    @if (OnRetry.HasDelegate)
    {
        <div class="mt-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="OnRetry">@L10n.T(Keys.Common.Retry, "重试")</button>
        </div>
    }
</div>

@code {
    /// <summary>错误文案；为 null 时回退到资源键 Error.OperationFailed 的译文。</summary>
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? TraceId { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
