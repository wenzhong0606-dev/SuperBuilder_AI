@inject LocalizationService L10n
@* 统一加载态：面板/区块级占位 *@
<div class="sb-loading @(Block ? "block" : "")">
    <SbSpinner Size="@Size" />
    <span class="muted tiny">@(Text ?? L10n.T(Keys.Common.Loading, "加载中…"))</span>
</div>

@code {
    /// <summary>加载文案；为 null 时回退到资源键 Common.Loading 的译文。</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    /// <summary>块级（占据较大区域并有背景）还是行内。</summary>
    [Parameter] public bool Block { get; set; } = true;
}
