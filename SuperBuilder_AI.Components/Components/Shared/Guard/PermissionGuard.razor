@inject AppState State
@implements IDisposable
@* 权限守卫：RequireAny 为所需权限码集合；Mode = Any（任一命中）| All（全部命中） *@
@if (Allowed)
{
    @ChildContent
}
else if (Fallback is not null)
{
    @Fallback
}
else if (Silent)
{
    @* 按钮级守卫：未授权时静默隐藏，不渲染空状态框 *@
}
else
{
    <SbEmptyState Icon="sb-ico-shield" Title="@L10n.T(Keys.Content.SharedPermDeniedTitle, "无访问权限")" Text="@(DenyText ?? L10n.T(Keys.Content.SharedPermDeniedText, "当前账号缺少访问该页面所需的权限，请联系管理员。"))">
        <Actions>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("")'>@L10n.T(Keys.Content.SharedBackHome, "返回首页")</button>
        </Actions>
    </SbEmptyState>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter] public IReadOnlyList<string> Require { get; set; } = Array.Empty<string>();
    [Parameter] public string Mode { get; set; } = "Any";
    [Parameter] public string? DenyText { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Fallback { get; set; }
    /// <summary>按钮级守卫：未授权时静默隐藏（不渲染空状态框）。页面级守卫保持 false 以显示空状态。</summary>
    [Parameter] public bool Silent { get; set; } = false;
    /// <summary>页面级守卫：已登录但无权限时自动导航到 /forbidden（替代内联空状态）。默认 false（维持原内联提示行为）。</summary>
    [Parameter] public bool RedirectToForbidden { get; set; } = false;

    private bool Allowed
    {
        get
        {
            if (Require.Count == 0) return true;
            if (!State.IsAuthenticated) return false;
            var owned = State.Permissions ?? Array.Empty<string>();
            if (owned.Count == 0) return false;
            return Mode.Equals("All", StringComparison.OrdinalIgnoreCase)
                ? Require.All(p => owned.Contains(p))
                : Require.Any(p => owned.Contains(p));
        }
    }
    protected override void OnInitialized()
    {
        State.PermissionsChanged += Refresh;
        TryRedirectToForbidden();
    }
    private void Refresh()
    {
        TryRedirectToForbidden();
        _ = InvokeAsync(StateHasChanged);
    }
    /// <summary>已登录但无权限时，若开启 RedirectToForbidden 且无自定义 Fallback/非按钮级静默，则导航到 /forbidden。
    /// 权限尚未加载（Permissions 为空）时暂不动，待 PermissionsChanged 触发后再判定，避免误跳。</summary>
    private void TryRedirectToForbidden()
    {
        if (!RedirectToForbidden || Silent || Fallback is not null) return;
        if (Allowed || !State.IsAuthenticated) return;
        if ((State.Permissions?.Count ?? 0) == 0) return;
        Nav.NavigateTo("/forbidden");
    }
    public void Dispose() => State.PermissionsChanged -= Refresh;
}
