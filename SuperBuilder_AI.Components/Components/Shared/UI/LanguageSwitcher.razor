@inject LocalizationService L10n
@if (L10n.AvailableCultures.Count > 1)
{
    <select class="culture-switcher" data-testid="language-switcher" value="@L10n.CurrentCulture" @onchange="OnChange" aria-label="@L10n.T("Common.Settings", "设置")">
        @foreach (var culture in L10n.AvailableCultures)
        {
            <option value="@culture" selected="@(string.Equals(culture, L10n.CurrentCulture, StringComparison.OrdinalIgnoreCase))">@L10n.NativeName(culture)</option>
        }
    </select>
}

@code {
    /// <summary>语言变更回调：返回选中的文化代码（如 zh-CN）。</summary>
    [Parameter] public EventCallback<string> OnCultureChanged { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString();
        if (!string.IsNullOrEmpty(culture))
            await OnCultureChanged.InvokeAsync(culture);
    }
}
