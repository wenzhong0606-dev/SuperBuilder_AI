@* 面板容器：标题栏（图标+标题+右侧操作） + 内容 + 可选页脚 *@
<div class="panel">
    @if (!string.IsNullOrWhiteSpace(Title) || Actions is not null)
    {
        <div class="panel-head">
            <div class="panel-title">
                @if (!string.IsNullOrWhiteSpace(Icon))
                {
                    <span class="pt-ico"><svg><use href="@Icon" /></svg></span>
                }
                @Title
            </div>
            @if (Actions is not null)
            {
                <div class="panel-actions">@Actions</div>
            }
        </div>
    }
    <div class="panel-body @(Flush ? "flush" : "")">@Body</div>
    @if (Footer is not null)
    {
        <div class="panel-footer">@Footer</div>
    }
</div>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>内容区是否去除内边距（表格/列表常用）。</summary>
    [Parameter] public bool Flush { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
}
