@* 确认对话框：危险操作二次确认；Tone = primary|danger *@
<SbModal @bind-Visible="Visible" Title="@(Title ?? L10n.T(Keys.Content.SharedConfirmTitle, "确认操作"))" Size="sm" CloseOnScrim="true">
    <Body>
        <div class="sb-confirm-text">@Message</div>
    </Body>
    <Footer>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">@(CancelText ?? L10n.T(Keys.Content.CommonCancel, "取消"))</button>
        <button type="button" class="btn btn-sm @(Tone == "danger" ? "btn-danger" : "btn-primary")" @onclick="Confirm">@(ConfirmText ?? L10n.T(Keys.Content.SharedConfirm, "确认"))</button>
    </Footer>
</SbModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string? ConfirmText { get; set; }
    [Parameter] public string? CancelText { get; set; }
    [Parameter] public string Tone { get; set; } = "primary";
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task Cancel()
    {
        Visible = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
    }

    private async Task Confirm()
    {
        Visible = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnConfirm.HasDelegate) await OnConfirm.InvokeAsync();
    }
}
