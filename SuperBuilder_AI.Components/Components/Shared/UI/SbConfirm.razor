@* 确认对话框：危险操作二次确认；Tone = primary|danger *@
<SbModal @bind-Visible="Visible" Title="@Title" Size="sm" CloseOnScrim="true">
    <Body>
        <div class="sb-confirm-text">@Message</div>
    </Body>
    <Footer>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">@CancelText</button>
        <button type="button" class="btn btn-sm @(Tone == "danger" ? "btn-danger" : "btn-primary")" @onclick="Confirm">@ConfirmText</button>
    </Footer>
</SbModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "确认操作";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "确认";
    [Parameter] public string CancelText { get; set; } = "取消";
    [Parameter] public string Tone { get; set; } = "primary";
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task Cancel()
    {
        Visible = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
    }

    private async Task Confirm()
    {
        Visible = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnConfirm.HasDelegate) await OnConfirm.InvokeAsync();
    }
}
