@inject AppState State
@inject LocalizationService L10n
@* 侧栏导航：由 NavMenuItems 元数据驱动，按权限过滤（无权限项隐藏） *@
<nav class="nav">
    @foreach (var group in VisibleGroups)
    {
        <div class="nav-group">@L10n.T($"Nav.Group.{group.Title}", group.Title)</div>
        @foreach (var item in group.Items.Where(Allowed))
        {
            <NavLink href="@item.Href" Match="@(string.IsNullOrEmpty(item.Href) ? NavLinkMatch.All : NavLinkMatch.Prefix)" aria-label="@L10n.T($"Nav.{item.Href}", item.Title)">
                <svg class="nav-ico" aria-hidden="true"><use href="#@item.Icon" /></svg>@L10n.T($"Nav.{item.Href}", item.Title)
            </NavLink>
        }
    }
</nav>

@code {
    private IEnumerable<NavGroup> VisibleGroups =>
        NavMenuItems.Groups
            .Select(g => new NavGroup { Title = g.Title, Items = g.Items.Where(Allowed).ToArray() })
            .Where(g => g.Items.Count > 0);

    /// <summary>
    /// 权限判定：未声明权限 → 显示；未启用权限过滤或权限数据为空 → 显示（避免过度隐藏）；
    /// 启用且有权限数据时按权限码过滤。
    /// </summary>
    private bool Allowed(NavItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Permission)) return true;
        if (!NavMenuItems.EnforcePermissions) return true;
        var owned = State.Permissions ?? Array.Empty<string>();
        return owned.Count == 0 || owned.Contains(item.Permission!);
    }
}
