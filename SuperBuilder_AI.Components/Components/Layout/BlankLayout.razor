@inherits LayoutComponentBase
@inject ThemeService Theme
@inject AppState State
@inject AuthStore Session
@inject IJSRuntime JS
@* 无壳布局：登录、错误页等独立页面使用（无顶栏/侧栏）。
   与 MainLayout 一样执行主题应用与会话自举，保证直接访问这些页面时登录态正确。 *@
<IconSprite />

<div class="blank-shell">
    <main class="blank-content">
        @Body
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<string>("SuperBuilder.getTheme");
            await Theme.ApplyAsync(theme);
        }
        catch
        {
            // 主题获取失败时退避默认主题，不阻断会话自举。
        }

        // 本地还原后立即重渲染；网络校验失败保留本地会话，不向外抛出以免撕裂电路。
        await Session.RestoreAsync();
        StateHasChanged();
        if (State.IsAuthenticated)
        {
            try { await Session.ValidateAsync(); } catch { /* 网络异常不登出 */ }
            StateHasChanged();
        }
    }
}
