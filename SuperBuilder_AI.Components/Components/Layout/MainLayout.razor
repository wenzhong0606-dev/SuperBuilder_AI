@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AppState State
@inject AuthStore Session
@inject IJSRuntime JS
@inject LocalizationService L10n

<IconSprite />

<a class="skip-link" href="#main-content" @onclick:preventDefault="false">@L10n.T(Keys.Accessibility.SkipToContent, "跳到主内容")</a>

<div class="app-shell @(NavOpen ? "nav-open" : "")">
    <header class="app-header">
        <button class="icon-btn menu-btn" @onclick="ToggleNav" aria-label="@L10n.T(Keys.Common.Menu, "菜单")" title="@L10n.T(Keys.Common.Menu, "菜单")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
        <div class="app-header-brand">SuperBuilder <span>AI</span><small>@L10n.T(Keys.App.Subtitle, "智能问数平台")</small></div>
        <div class="app-header-spacer"></div>

        @if (State.IsAuthenticated && L10n.AvailableCultures.Count > 1)
        {
            <LanguageSwitcher OnCultureChanged="ChangeCulture" />
        }

        <button class="icon-btn theme-btn" @onclick="ToggleTheme" aria-label="@L10n.T(Keys.Theme.Switch, "切换主题")" title="@(IsDark ? L10n.T(Keys.Theme.Light, "浅色") : L10n.T(Keys.Theme.Dark, "深色"))">
            @if (IsDark)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            }
        </button>

        <TenantSwitcher />

        @if (State.IsAuthenticated)
        {
            <div class="user-menu">
                <button class="user-chip" data-testid="user-chip" @onclick="ToggleUserMenu" aria-haspopup="true" aria-expanded="@UserMenuOpen" title="@L10n.T(Keys.Common.AccountMenu, "账号菜单")">
                    <span class="avatar">@(string.IsNullOrEmpty(State.Username) ? "?" : State.Username.Substring(0, 1).ToUpper())</span>
                    <span class="uname">@State.Username</span>
                </button>
                @if (UserMenuOpen)
                {
                    <div class="sb-menu" role="menu">
                        <a class="sb-menu-item" href="settings" @onclick="CloseUserMenu">
                            <svg class="btn-ico"><use href="#sb-ico-settings" /></svg> @L10n.T(Keys.Common.Settings, "个人设置")
                        </a>
                        <button class="sb-menu-item" data-testid="logout" @onclick="Logout">
                            <svg class="btn-ico"><use href="#sb-ico-shield" /></svg> @L10n.T(Keys.Common.Logout, "退出登录")
                        </button>
                    </div>
                }
            </div>
        }
    </header>

    <div class="app-body">
        <NavMenu />
        <div class="nav-scrim" @onclick="CloseNav"></div>
        <main class="content" id="main-content" tabindex="-1">
            <AppBreadcrumb />
            <ErrorBoundary @ref="_errBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-boundary-card" role="alert">
                        <div class="eb-code">!</div>
                        <h3>@L10n.T(Keys.Error.PageRender, "页面渲染出错")</h3>
                        <p class="muted">@L10n.T(Keys.Error.PageRenderDesc, "该页面在渲染时发生异常，已被安全隔离，未影响其它功能。可重试当前页面或返回工作台。")</p>
                        <details class="eb-detail">
                            <summary>@L10n.T(Keys.Error.TechDetails, "技术详情")</summary>
                            <pre>@ex.Message</pre>
                        </details>
                        <div class="eb-actions">
                            <button class="btn btn-primary btn-sm" @onclick="Recover">@L10n.T(Keys.Common.Retry, "重试")</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo("")'>@L10n.T(Keys.Common.BackToWorkspace, "返回工作台")</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<SbToastHost />

@code {
    private ErrorBoundary? _errBoundary;
    private bool NavOpen = false;
    private bool IsDark = false;
    private bool UserMenuOpen = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        State.SessionExpired += OnSessionExpired;
        L10n.Changed += OnCultureChanged;
    }

    // 主题读取/应用需在浏览器中执行（预渲染阶段无 JS 运行时）。
    // 初始主题已由 _Host/index 内联脚本写入 data-theme，避免首屏闪烁。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var theme = await JS.InvokeAsync<string>("SuperBuilder.getTheme");
        IsDark = theme == "dark";
        await Theme.ApplyAsync(theme);

        // 会话自举：从 localStorage 还原令牌，并校验是否仍有效（过期则清除）。
        await Session.RestoreAsync();
        if (State.IsAuthenticated)
        {
            await Session.ValidateAsync();
            await L10n.InitializeAsync(State.TenantId, State.UserId, State.AvailableCultures, State.DefaultCulture);
        }
        StateHasChanged();
    }

    /// <summary>会话失效（token 过期/被拒）时回收并跳登录。</summary>
    /// <remarks>
    /// 事件处理器签名要求返回 void，故以 <c>async void</c> 实现；异常不可被 await，
    /// 必须包在 try/catch 内，否则会逃逸并中断 SignalR 电路（M8-05「消除不受控 async void」）。
    /// 已处于登录页则直接返回，避免并发 401 触发的「登录—Ask」回跳循环。
    /// </remarks>
    private async void OnSessionExpired()
    {
        try
        {
            if (Nav.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase)) return;
            await Session.ClearAsync();
            Nav.NavigateTo("/login");
        }
        catch
        {
            // 清理/跳转异常不向上抛（async void 无法被调用方 await）
        }
    }

    /// <summary>电路销毁/重建时退订全部事件订阅（M8-05「解除事件订阅」），避免重连后事件重复订阅导致内存泄漏与重复处理。</summary>
    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.SessionExpired -= OnSessionExpired;
        L10n.Changed -= OnCultureChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UserMenuOpen = false;
        if (NavOpen)
        {
            NavOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>错误边界恢复：清除异常状态并重新渲染子树。</summary>
    private void Recover() => _errBoundary?.Recover();

    private void ToggleNav() => NavOpen = !NavOpen;
    private void CloseNav() => NavOpen = false;
    private void ToggleUserMenu() => UserMenuOpen = !UserMenuOpen;
    private void CloseUserMenu() => UserMenuOpen = false;
    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task ChangeCulture(string culture) => await L10n.SetCultureAsync(State.TenantId, State.UserId, culture);

    private async Task Logout()
    {
        UserMenuOpen = false;
        await Session.ClearAsync();
        State.ClearSession();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await Theme.ApplyAsync(IsDark ? "dark" : "light");
    }
}
