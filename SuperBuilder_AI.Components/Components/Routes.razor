@inject LocalizationService L10n

<AuthGate>
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            <ErrorBoundary>
                <ChildContent>
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="alert alert-danger m-3">
                        <strong>@L10n.T(Keys.Content.PageRenderError, "页面渲染出错")</strong>
                        <pre class="mb-0" style="white-space:pre-wrap;">@exception.Message</pre>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            @* 404 页面自带 BlankLayout，此处以内联空态呈现，避免布局嵌套 *@
            <LayoutView Layout="@typeof(MainLayout)">
                <SbEmptyState Icon="sb-ico-search"
                              Title="@L10n.T(Keys.Content.ErrNotFoundTitle, "页面不存在")"
                              Text="@L10n.T(Keys.Content.ErrNotFoundText, "该地址没有对应的页面，可能是链接已失效或输入有误。")">
                    <Actions>
                        <a class="btn btn-primary btn-sm" href="">@L10n.T(Keys.Common.BackToWorkspace, "返回工作台")</a>
                    </Actions>
                </SbEmptyState>
            </LayoutView>
        </NotFound>
    </Router>
</AuthGate>
