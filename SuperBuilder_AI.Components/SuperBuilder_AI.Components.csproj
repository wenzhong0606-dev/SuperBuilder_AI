<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 多目标：net10.0 供 Blazor Web Head / MAUI Windows；android/ios 供 MAUI 移动端原生构建 -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SuperBuilder_AI.Components</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- 所有 TFM（含 android/ios）：Razor 组件基础 + HttpClient 工厂。
         移动端 TFM 的 Blazor 运行时由 Components.Web 经 net10.0 资产回退提供，
         无需引用 Microsoft.AspNetCore.Components.WebView.Maui —— 该包会带入 WebView 宿主自带的
         _framework 静态资源（blazor.modules.json 等），与引用本 RCL 的 MAUI 应用冲突。 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
