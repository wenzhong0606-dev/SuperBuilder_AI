{
  "Auth": {
    "SigningKey": "development-only-signing-key-do-not-use-in-production",
    "ShowTenantDirectory": true,
    "AccessTokenLifetimeMinutes": 60
  },
  "Cors": {
    "AllowAnyOrigin": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
