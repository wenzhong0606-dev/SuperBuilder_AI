<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Domain is the core layer of the Clean Architecture and must reference NO other
    project. It relies only on BCL / Microsoft.Extensions.* (provided transitively).

    NOTE (architecture violation, see A3 report): the current source under src/Domain
    uses types defined in the Application layer (e.g. namespaces SuperBuilder_AI.Interfaces
    and SuperBuilder_AI.Models.AI). Until that is refactored (move those contracts into
    Domain / a SharedKernel), Domain cannot compile against a strictly acyclic graph.
  -->

</Project>
