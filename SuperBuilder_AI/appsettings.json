{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PlatformBootstrap": {
    "AllowAnonymous": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SuperBuilder_Platform;User Id=__REQUIRED__;Password=__SET_VIA_ENV_OR_appsettings.Local.json__;TrustServerCertificate=True;",
    "SuperBI": "Server=localhost;Database=SuperBuilder_Platform;User Id=__REQUIRED__;Password=__SET_VIA_ENV_OR_appsettings.Local.json__;TrustServerCertificate=True;",
    "WmsMySql": "Server=192.168.16.120;Port=3306;Database=steccn_wms;Uid=__REQUIRED__;Pwd=__SET_VIA_ENV_OR_appsettings.Local.json__;CharSet=utf8mb4;SslMode=Required;"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "superbi_metadata",
    "VectorSize": 1024
  },
  "Qwen": {
    "ApiKey": "__SET_VIA_ENV_Qwen__ApiKey_OR_appsettings.Local.json__",
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    "Model": "qwen-plus"
  },
  "Embedding": {
    "ApiKey": "__SET_VIA_ENV_Embedding__ApiKey_OR_appsettings.Local.json__",
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings",
    "Model": "qwen3.7-text-embedding",
    "Dimensions": 1024,
    "TimeoutSeconds": 120
  },
  "SelfRegistration": {
    "Enabled": false,
    "ApprovalRequired": false,
    "RequireCaptcha": false,
    "AllowedEmailDomains": [],
    "DefaultCulture": "zh-CN",
    "DefaultAvailableCultures": [ "zh-CN" ],
    "DefaultQuotaPolicyCode": null
  },
  "Features": {
    "MetadataVersionFilterEnabled": false,
    "MetadataRemapDropMode": "Block"
  },
  "MetadataScan": {
    "RetryPolicy": {
      "MaxAttempts": 3,
      "RetryOnConnectionError": false,
      "RetryOnPermissionError": false,
      "RetryOnTransientError": true
    },
    "HeartbeatTimeout": {
      "TimeoutMinutes": 30,
      "IntervalSeconds": 30
    }
  }
}
