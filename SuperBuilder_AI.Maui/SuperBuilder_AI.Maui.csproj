<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 多目标：Android/iOS/Windows 原生构建；RCL 已相应多目标 -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SuperBuilder_AI.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperBuilder_AI.Components\SuperBuilder_AI.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 品牌化图标/启动屏（朱砂#9E3D34 / 墨#2B2620 / 藤黄#C9A227），供 Android/iOS 原生构建 -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplash Include="Resources\Splash\splash.svg" Color="#2B2620" />
  </ItemGroup>

</Project>
